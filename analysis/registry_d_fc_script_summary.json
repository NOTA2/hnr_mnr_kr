[
  {
    "index": 0,
    "file_offset": 8335360,
    "end_offset_exclusive": 8336772,
    "length": 1412,
    "text_count": 20,
    "first_text": "さぁ相手になってやるぜ！"
  },
  {
    "index": 1,
    "file_offset": 8336772,
    "end_offset_exclusive": 8337534,
    "length": 762,
    "text_count": 7,
    "first_text": "兄さん\n質問！"
  },
  {
    "index": 2,
    "file_offset": 8337536,
    "end_offset_exclusive": 8337698,
    "length": 162,
    "text_count": 2,
    "first_text": "さっさとケリつけちゃおうぜ"
  },
  {
    "index": 3,
    "file_offset": 8337700,
    "end_offset_exclusive": 8337927,
    "length": 227,
    "text_count": 3,
    "first_text": "コニィはあまりムチャするなよ"
  },
  {
    "index": 4,
    "file_offset": 8337928,
    "end_offset_exclusive": 8338069,
    "length": 141,
    "text_count": 1,
    "first_text": "ったく、なんだって\n街にキメラがいるんだよッ"
  },
  {
    "index": 5,
    "file_offset": 8338072,
    "end_offset_exclusive": 8338196,
    "length": 124,
    "text_count": 1,
    "first_text": "こんなとこにいやがったのか"
  },
  {
    "index": 6,
    "file_offset": 8338196,
    "end_offset_exclusive": 8338304,
    "length": 108,
    "text_count": 1,
    "first_text": "またかよ！"
  },
  {
    "index": 7,
    "file_offset": 8338304,
    "end_offset_exclusive": 8338421,
    "length": 117,
    "text_count": 1,
    "first_text": "いいかげんウンザリだぜ"
  },
  {
    "index": 8,
    "file_offset": 8338424,
    "end_offset_exclusive": 8338590,
    "length": 166,
    "text_count": 1,
    "first_text": "こいつで最後か！\n気合入れて\nとっとと片付けるッ"
  },
  {
    "index": 9,
    "file_offset": 8338592,
    "end_offset_exclusive": 8339218,
    "length": 626,
    "text_count": 2,
    "first_text": "よろしくお願いします"
  },
  {
    "index": 10,
    "file_offset": 8339220,
    "end_offset_exclusive": 8339502,
    "length": 282,
    "text_count": 2,
    "first_text": "コニィ、今度はオレたちもいる\n絶対に勝てる！"
  },
  {
    "index": 11,
    "file_offset": 8339504,
    "end_offset_exclusive": 8339730,
    "length": 226,
    "text_count": 2,
    "first_text": "それじゃ\nちゃちゃっと片付けますか"
  },
  {
    "index": 12,
    "file_offset": 8339732,
    "end_offset_exclusive": 8339854,
    "length": 122,
    "text_count": 1,
    "first_text": "いいかげん最後にしようぜ"
  },
  {
    "index": 13,
    "file_offset": 8339856,
    "end_offset_exclusive": 8340132,
    "length": 276,
    "text_count": 4,
    "first_text": "私が負けたら\n協力してやろう"
  },
  {
    "index": 14,
    "file_offset": 8340132,
    "end_offset_exclusive": 8340484,
    "length": 352,
    "text_count": 4,
    "first_text": "私が負けたら\n協力してやろう"
  },
  {
    "index": 15,
    "file_offset": 8340484,
    "end_offset_exclusive": 8340714,
    "length": 230,
    "text_count": 2,
    "first_text": "マジでこのオレ様と\nやるってのか？"
  },
  {
    "index": 16,
    "file_offset": 8340716,
    "end_offset_exclusive": 8340895,
    "length": 179,
    "text_count": 1,
    "first_text": "けっ、キメラにも親玉が\nいるとは笑わせるぜ\n覚悟しやがれ！"
  },
  {
    "index": 17,
    "file_offset": 8340896,
    "end_offset_exclusive": 8341045,
    "length": 149,
    "text_count": 2,
    "first_text": "逃がすなよ、鋼の"
  },
  {
    "index": 18,
    "file_offset": 8341048,
    "end_offset_exclusive": 8341491,
    "length": 443,
    "text_count": 6,
    "first_text": "オレたちのニセモノは\nちゃんとオレたちで倒すぜ！"
  },
  {
    "index": 19,
    "file_offset": 8341492,
    "end_offset_exclusive": 8341758,
    "length": 266,
    "text_count": 3,
    "first_text": "ヨロイ君に攻撃するのは\nやだなぁ。でも、やるぞぉ！"
  },
  {
    "index": 20,
    "file_offset": 8341760,
    "end_offset_exclusive": 8341881,
    "length": 121,
    "text_count": 2,
    "first_text": "おまえごときに時間を\nかけてるわけには\nいかないんだよ"
  },
  {
    "index": 21,
    "file_offset": 8341884,
    "end_offset_exclusive": 8342083,
    "length": 199,
    "text_count": 2,
    "first_text": "おまえごときに時間を\nかけてるわけには\nいかないんだよ！"
  },
  {
    "index": 22,
    "file_offset": 8342084,
    "end_offset_exclusive": 8342300,
    "length": 216,
    "text_count": 3,
    "first_text": "国家錬金術師、\nそして我が使命を邪魔する者！\nこの場の全員、滅ぼす！"
  },
  {
    "index": 23,
    "file_offset": 8342300,
    "end_offset_exclusive": 8342662,
    "length": 362,
    "text_count": 3,
    "first_text": "むう、やりおるわい！"
  },
  {
    "index": 24,
    "file_offset": 8342664,
    "end_offset_exclusive": 8343412,
    "length": 748,
    "text_count": 7,
    "first_text": "お兄ちゃんの\nジャマをするヤツは\n許さないからねっ！"
  },
  {
    "index": 25,
    "file_offset": 8343412,
    "end_offset_exclusive": 8343576,
    "length": 164,
    "text_count": 1,
    "first_text": "ちったぁ活躍しておかねえとな\nムショから出てきた意味がねぇ"
  },
  {
    "index": 26,
    "file_offset": 8343576,
    "end_offset_exclusive": 8343798,
    "length": 222,
    "text_count": 2,
    "first_text": "よほどオレ様に\n斬られたいらしいな！"
  },
  {
    "index": 27,
    "file_offset": 8343800,
    "end_offset_exclusive": 8344067,
    "length": 267,
    "text_count": 3,
    "first_text": "じゃ、ランディくん\nガンバってねーん"
  },
  {
    "index": 28,
    "file_offset": 8344068,
    "end_offset_exclusive": 8344378,
    "length": 310,
    "text_count": 3,
    "first_text": "国家錬金術師、\nそして我が使命を邪魔する者！\nこの場の全員、滅ぼす！！"
  },
  {
    "index": 29,
    "file_offset": 8344380,
    "end_offset_exclusive": 8344533,
    "length": 153,
    "text_count": 1,
    "first_text": "しょうがない。\n相手してやるぜ！"
  },
  {
    "index": 30,
    "file_offset": 8344536,
    "end_offset_exclusive": 8344857,
    "length": 321,
    "text_count": 4,
    "first_text": "鋼の錬金術師！\nここでぶっ潰してやるぜ！"
  },
  {
    "index": 31,
    "file_offset": 8344860,
    "end_offset_exclusive": 8345128,
    "length": 268,
    "text_count": 3,
    "first_text": "今度こそ、\n完全にぶっ飛ばしてやるっ！"
  },
  {
    "index": 32,
    "file_offset": 8345128,
    "end_offset_exclusive": 8345630,
    "length": 502,
    "text_count": 7,
    "first_text": "さて、あんなバケモノ、\nどうやって倒すよ、大佐"
  },
  {
    "index": 33,
    "file_offset": 8345632,
    "end_offset_exclusive": 8346833,
    "length": 1201,
    "text_count": 15,
    "first_text": "どうあがいても\n貴様らはしょせん、\n軍の狗にすぎんのだ！"
  },
  {
    "index": 34,
    "file_offset": 8346836,
    "end_offset_exclusive": 8347435,
    "length": 599,
    "text_count": 4,
    "first_text": "コニィ、大丈夫？"
  },
  {
    "index": 35,
    "file_offset": 8347436,
    "end_offset_exclusive": 8347955,
    "length": 519,
    "text_count": 6,
    "first_text": "ほわー。眠くなってきたから、\nさっさとそんなの\nやっつけちゃっていいよん！"
  },
  {
    "index": 36,
    "file_offset": 8347956,
    "end_offset_exclusive": 8348206,
    "length": 250,
    "text_count": 3,
    "first_text": "最期だ\n神に祈る間をやろう"
  },
  {
    "index": 37,
    "file_offset": 8348208,
    "end_offset_exclusive": 8348358,
    "length": 150,
    "text_count": 1,
    "first_text": "小僧がッッッ！\n今度は貴様を\nバラバラにしてやる！"
  },
  {
    "index": 38,
    "file_offset": 8348360,
    "end_offset_exclusive": 8348537,
    "length": 177,
    "text_count": 2,
    "first_text": "理不尽なヤツらだ！\n犬なんて知るかっ！"
  },
  {
    "index": 39,
    "file_offset": 8348540,
    "end_offset_exclusive": 8348760,
    "length": 220,
    "text_count": 3,
    "first_text": "さっさとやって\nさっさと下水道から\n出たいよな"
  },
  {
    "index": 40,
    "file_offset": 8348760,
    "end_offset_exclusive": 8348890,
    "length": 130,
    "text_count": 1,
    "first_text": "さっさと片付けて\n先に進むぞ！"
  },
  {
    "index": 41,
    "file_offset": 8348892,
    "end_offset_exclusive": 8349009,
    "length": 117,
    "text_count": 1,
    "first_text": "さあ、次に進むぞ"
  },
  {
    "index": 42,
    "file_offset": 8349012,
    "end_offset_exclusive": 8349153,
    "length": 141,
    "text_count": 1,
    "first_text": "ゆくぞ！\n貴様一匹など、\n私ひとりで十分だ！"
  },
  {
    "index": 43,
    "file_offset": 8349156,
    "end_offset_exclusive": 8349436,
    "length": 280,
    "text_count": 3,
    "first_text": "オレはオレひとりで\n十分だ！\n偽者はぶっ潰す！"
  },
  {
    "index": 47,
    "file_offset": 8349448,
    "end_offset_exclusive": 8350614,
    "length": 1166,
    "text_count": 10,
    "first_text": "マップで錬成したいときは\nここで必要なカードを選ぶんだ\n今欲しいカードは\n金属の３－２だ"
  },
  {
    "index": 50,
    "file_offset": 8350644,
    "end_offset_exclusive": 8350834,
    "length": 190,
    "text_count": 1,
    "first_text": "機械鎧を攻撃されても\n痛くもかゆくもないぜ"
  },
  {
    "index": 51,
    "file_offset": 8350836,
    "end_offset_exclusive": 8351111,
    "length": 275,
    "text_count": 2,
    "first_text": "格がちがうんだよ\n格がっ！"
  },
  {
    "index": 52,
    "file_offset": 8351112,
    "end_offset_exclusive": 8351384,
    "length": 272,
    "text_count": 2,
    "first_text": "兄さん、いくらなんでも\nやりすぎだよ…"
  },
  {
    "index": 53,
    "file_offset": 8351384,
    "end_offset_exclusive": 8351686,
    "length": 302,
    "text_count": 4,
    "first_text": "オレの勝ちだな"
  },
  {
    "index": 54,
    "file_offset": 8351688,
    "end_offset_exclusive": 8352402,
    "length": 714,
    "text_count": 7,
    "first_text": "お前ら強いなぁ\nそこの小さいの！\n名前を教えろっ"
  },
  {
    "index": 55,
    "file_offset": 8352404,
    "end_offset_exclusive": 8352759,
    "length": 355,
    "text_count": 3,
    "first_text": "やっばー！\nたんま、たんま"
  },
  {
    "index": 56,
    "file_offset": 8352760,
    "end_offset_exclusive": 8353022,
    "length": 262,
    "text_count": 2,
    "first_text": "見て、あそこ。\n鍵が落ちてるよ"
  },
  {
    "index": 57,
    "file_offset": 8353024,
    "end_offset_exclusive": 8353369,
    "length": 345,
    "text_count": 1,
    "first_text": "行っちゃった…"
  },
  {
    "index": 58,
    "file_offset": 8353372,
    "end_offset_exclusive": 8353441,
    "length": 69,
    "text_count": 1,
    "first_text": "すぐに行き止まりだよ、兄さん\nここじゃないみたい"
  },
  {
    "index": 59,
    "file_offset": 8353444,
    "end_offset_exclusive": 8353513,
    "length": 69,
    "text_count": 1,
    "first_text": "すぐに行き止まりだよ、兄さん\nここじゃないみたい"
  },
  {
    "index": 60,
    "file_offset": 8353516,
    "end_offset_exclusive": 8353719,
    "length": 203,
    "text_count": 1,
    "first_text": "オレ様にかかれば\nおちゃのこサイサイってね！"
  },
  {
    "index": 61,
    "file_offset": 8353720,
    "end_offset_exclusive": 8354105,
    "length": 385,
    "text_count": 4,
    "first_text": "どうやら片付いたみたいだな"
  },
  {
    "index": 62,
    "file_offset": 8354108,
    "end_offset_exclusive": 8354435,
    "length": 327,
    "text_count": 1,
    "first_text": "この数を相手にしては\nやはり分が悪いか…"
  },
  {
    "index": 63,
    "file_offset": 8354436,
    "end_offset_exclusive": 8354686,
    "length": 250,
    "text_count": 2,
    "first_text": "終わったよ、ヒューズ中佐"
  },
  {
    "index": 64,
    "file_offset": 8354688,
    "end_offset_exclusive": 8354998,
    "length": 310,
    "text_count": 3,
    "first_text": "ヒューズ中佐…\n大丈夫ですか？"
  },
  {
    "index": 65,
    "file_offset": 8355000,
    "end_offset_exclusive": 8355343,
    "length": 343,
    "text_count": 1,
    "first_text": "残念だけど、\nいつまでも遊んでられないの\nまたね、鋼の坊や"
  },
  {
    "index": 66,
    "file_offset": 8355344,
    "end_offset_exclusive": 8355532,
    "length": 188,
    "text_count": 1,
    "first_text": "…バ、バカなっ！"
  },
  {
    "index": 67,
    "file_offset": 8355532,
    "end_offset_exclusive": 8355852,
    "length": 320,
    "text_count": 3,
    "first_text": "お、俺の筋肉が…"
  },
  {
    "index": 68,
    "file_offset": 8355852,
    "end_offset_exclusive": 8356254,
    "length": 402,
    "text_count": 3,
    "first_text": "あっちゃー！　ヤバイよう\n…えーい\nこのまま逃げちゃおうっ"
  },
  {
    "index": 69,
    "file_offset": 8356256,
    "end_offset_exclusive": 8356453,
    "length": 197,
    "text_count": 1,
    "first_text": "こ、こんなはずでは\nこうなったら"
  },
  {
    "index": 71,
    "file_offset": 8356740,
    "end_offset_exclusive": 8356922,
    "length": 182,
    "text_count": 1,
    "first_text": "よっしゃー！\nまずは１回戦突破だ！"
  },
  {
    "index": 72,
    "file_offset": 8356924,
    "end_offset_exclusive": 8357106,
    "length": 182,
    "text_count": 1,
    "first_text": "悪いけど\n負けるつもりはないからさ"
  },
  {
    "index": 73,
    "file_offset": 8357108,
    "end_offset_exclusive": 8357284,
    "length": 176,
    "text_count": 1,
    "first_text": "相変わらず\n安物の機械鎧だな"
  },
  {
    "index": 74,
    "file_offset": 8357284,
    "end_offset_exclusive": 8357538,
    "length": 254,
    "text_count": 2,
    "first_text": "よっしゃ、勝った！"
  },
  {
    "index": 75,
    "file_offset": 8357540,
    "end_offset_exclusive": 8357795,
    "length": 255,
    "text_count": 2,
    "first_text": "おっしゃー！\nどうだ思い知ったか！"
  },
  {
    "index": 76,
    "file_offset": 8357796,
    "end_offset_exclusive": 8358079,
    "length": 283,
    "text_count": 2,
    "first_text": "ゼェゼェゼェ…\nアームストロング少佐と\n戦うと…疲れる"
  },
  {
    "index": 77,
    "file_offset": 8358080,
    "end_offset_exclusive": 8358335,
    "length": 255,
    "text_count": 2,
    "first_text": "そういや思い出したよ\nリンカーのとこで！"
  },
  {
    "index": 78,
    "file_offset": 8358336,
    "end_offset_exclusive": 8358605,
    "length": 269,
    "text_count": 2,
    "first_text": "ゼェゼェ…\nまだやる気か！？"
  },
  {
    "index": 79,
    "file_offset": 8358608,
    "end_offset_exclusive": 8358878,
    "length": 270,
    "text_count": 2,
    "first_text": "取ったっ！\nこれで発火布は\n使いもんにならないだろ"
  },
  {
    "index": 80,
    "file_offset": 8358880,
    "end_offset_exclusive": 8359181,
    "length": 301,
    "text_count": 1,
    "first_text": "強くなったな、鋼の錬金術師\nその命、預けておく！"
  },
  {
    "index": 81,
    "file_offset": 8359184,
    "end_offset_exclusive": 8359406,
    "length": 222,
    "text_count": 1,
    "first_text": "安物の機械鎧じゃ\nオレに勝てないって\n何度言えばわかるわけ？"
  },
  {
    "index": 82,
    "file_offset": 8359408,
    "end_offset_exclusive": 8359673,
    "length": 265,
    "text_count": 2,
    "first_text": "なんで何も関係ない俺様が\nこんな目に…"
  },
  {
    "index": 83,
    "file_offset": 8359676,
    "end_offset_exclusive": 8359913,
    "length": 237,
    "text_count": 2,
    "first_text": "オ、俺がなにを\nしたっていうんだっ！？"
  },
  {
    "index": 84,
    "file_offset": 8359916,
    "end_offset_exclusive": 8360181,
    "length": 265,
    "text_count": 2,
    "first_text": "無駄な抵抗は\nおやめなさい！"
  },
  {
    "index": 85,
    "file_offset": 8360184,
    "end_offset_exclusive": 8360484,
    "length": 300,
    "text_count": 1,
    "first_text": "これが最後の一撃だっ！"
  },
  {
    "index": 86,
    "file_offset": 8360484,
    "end_offset_exclusive": 8360711,
    "length": 227,
    "text_count": 2,
    "first_text": "なかなかの手前であった"
  },
  {
    "index": 92,
    "file_offset": 8360732,
    "end_offset_exclusive": 8361677,
    "length": 945,
    "text_count": 17,
    "first_text": "さぁ相手になってやるぜ！"
  }
]