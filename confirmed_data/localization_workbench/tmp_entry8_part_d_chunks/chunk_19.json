{
  "items": [
    {
      "item_id": "cluster_70_military:0076FF3E",
      "offset": 7798590,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの歳の子供たちに"
    },
    {
      "item_id": "cluster_70_military:0076FF56",
      "offset": 7798614,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "背負わせるには、"
    },
    {
      "item_id": "cluster_70_military:0076FF6C",
      "offset": 7798636,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "重すぎる十字架ですね"
    },
    {
      "item_id": "cluster_70_military:0076FF98",
      "offset": 7798680,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それもまた"
    },
    {
      "item_id": "cluster_70_military:0076FFA8",
      "offset": 7798696,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "彼ら自身が選んだことだ…"
    },
    {
      "item_id": "cluster_70_military:0076FFCA",
      "offset": 7798730,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰も肩代わりはできまい"
    },
    {
      "item_id": "cluster_70_military:0076FFF2",
      "offset": 7798770,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、我々が心配するほど、"
    },
    {
      "item_id": "cluster_70_military:00770012",
      "offset": 7798802,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの兄弟はヤワではないと、"
    },
    {
      "item_id": "cluster_70_military:00770032",
      "offset": 7798834,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私は思っているがな"
    },
    {
      "item_id": "cluster_70_military:00770054",
      "offset": 7798868,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "時に迷い、悩むことが"
    },
    {
      "item_id": "cluster_70_military:0077006E",
      "offset": 7798894,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あったとしても、あの二人は"
    },
    {
      "item_id": "cluster_70_military:0077008E",
      "offset": 7798926,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "立ち止まりはしないさ"
    },
    {
      "item_id": "cluster_70_military:007700BA",
      "offset": 7798970,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やけに買っているのですね、"
    },
    {
      "item_id": "cluster_70_military:007700DA",
      "offset": 7799002,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの兄弟のことを"
    },
    {
      "item_id": "cluster_70_military:00770106",
      "offset": 7799046,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…いささか、"
    },
    {
      "item_id": "cluster_70_military:00770118",
      "offset": 7799064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かいかぶりすぎかな？"
    },
    {
      "item_id": "cluster_70_military:00770186",
      "offset": 7799174,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん…コニィは、"
    },
    {
      "item_id": "cluster_70_military:0077019E",
      "offset": 7799198,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大丈夫かな？"
    },
    {
      "item_id": "cluster_70_military:007701BC",
      "offset": 7799228,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今はそっとしとけ。"
    },
    {
      "item_id": "cluster_70_military:007701D8",
      "offset": 7799256,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いつかまた自分の道を"
    },
    {
      "item_id": "cluster_70_military:007701F2",
      "offset": 7799282,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "歩き始める"
    },
    {
      "item_id": "cluster_70_military:0077020E",
      "offset": 7799310,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィは強いさ。"
    },
    {
      "item_id": "cluster_70_military:00770228",
      "offset": 7799336,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それは仲間であるオレたちが、"
    },
    {
      "item_id": "cluster_70_military:0077024A",
      "offset": 7799370,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一番よくわかってるだろ？"
    },
    {
      "item_id": "cluster_70_military:00770284",
      "offset": 7799428,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…だよね"
    },
    {
      "item_id": "cluster_70_military:007702A2",
      "offset": 7799458,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そしてオレ達もな。"
    },
    {
      "item_id": "cluster_70_military:007702BE",
      "offset": 7799486,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "止まってなんかいられないぜ！"
    },
    {
      "item_id": "cluster_71_save_menu:007707EA",
      "offset": 7800810,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんか変な街だね。"
    },
    {
      "item_id": "cluster_71_save_menu:00770802",
      "offset": 7800834,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "フードショップのおじさんに"
    },
    {
      "item_id": "cluster_71_save_menu:00770822",
      "offset": 7800866,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もっと話を聞いてみようか？"
    },
    {
      "item_id": "cluster_71_save_menu:0077085C",
      "offset": 7800924,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "広場でなにかあるみたいだね"
    },
    {
      "item_id": "cluster_71_save_menu:00770896",
      "offset": 7800982,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あのコーネロって怪しいよね。"
    },
    {
      "item_id": "cluster_71_save_menu:007708B8",
      "offset": 7801016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "会って話を聞いてみる？"
    },
    {
      "item_id": "cluster_71_save_menu:007708D4",
      "offset": 7801044,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "教会にいるかな？"
    },
    {
      "item_id": "cluster_71_save_menu:00770904",
      "offset": 7801092,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、"
    },
    {
      "item_id": "cluster_71_save_menu:00770912",
      "offset": 7801106,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コーネロに会ってみよう"
    },
    {
      "item_id": "cluster_71_save_menu:00770948",
      "offset": 7801160,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コーネロを追いかけないと！"
    },
    {
      "item_id": "cluster_71_save_menu:00770968",
      "offset": 7801192,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっと教会の奥にいるよ！"
    },
    {
      "item_id": "cluster_71_save_menu:007709A0",
      "offset": 7801248,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "はやく列車強盗のボスを倒して"
    },
    {
      "item_id": "cluster_71_save_menu:007709C2",
      "offset": 7801282,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人質の人を助けてあげなきゃ！"
    },
    {
      "item_id": "cluster_71_save_menu:007709FE",
      "offset": 7801342,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キメラをぜんぶ倒して"
    },
    {
      "item_id": "cluster_71_save_menu:00770A18",
      "offset": 7801368,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "街を取り戻すんだ！"
    },
    {
      "item_id": "cluster_71_save_menu:00770A4A",
      "offset": 7801418,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もうキメラはいないみたいだね"
    },
    {
      "item_id": "cluster_71_save_menu:00770A6C",
      "offset": 7801452,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セントラルシティへ行こうか、"
    },
    {
      "item_id": "cluster_71_save_menu:00770B12",
      "offset": 7801618,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィを軍司令部まで"
    },
    {
      "item_id": "cluster_71_save_menu:00770B2C",
      "offset": 7801644,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "案内するんだよね"
    },
    {
      "item_id": "cluster_71_save_menu:00770B44",
      "offset": 7801668,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中央軍司令部は"
    },
    {
      "item_id": "cluster_71_save_menu:00770B58",
      "offset": 7801688,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セントラルシティの"
    },
    {
      "item_id": "cluster_71_save_menu:00770B70",
      "offset": 7801712,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "北側区画だったっけ？"
    },
    {
      "item_id": "cluster_71_save_menu:00770BA4",
      "offset": 7801764,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィの試験の相手は"
    },
    {
      "item_id": "cluster_71_save_menu:00770BBE",
      "offset": 7801790,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アームストロング少佐か…"
    },
    {
      "item_id": "cluster_71_save_menu:00770BDC",
      "offset": 7801820,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "会場は中庭だったよね"
    },
    {
      "item_id": "cluster_71_save_menu:00770C10",
      "offset": 7801872,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、大総統に会いに"
    },
    {
      "item_id": "cluster_71_save_menu:00770C2C",
      "offset": 7801900,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行かないとまずいんじゃない？"
    },
    {
      "item_id": "cluster_71_save_menu:00770C4E",
      "offset": 7801934,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大総統府は中央軍司令部だよね"
    },
    {
      "item_id": "cluster_71_save_menu:00770C8A",
      "offset": 7801994,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヒューズ中佐、どこかな？"
    },
    {
      "item_id": "cluster_71_save_menu:00770CA8",
      "offset": 7802024,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍司令部の受付のおねーさんに"
    },
    {
      "item_id": "cluster_71_save_menu:00770CCA",
      "offset": 7802058,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "聞けばわかるかな？"
    },
    {
      "item_id": "cluster_71_save_menu:00770CFC",
      "offset": 7802108,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヒューズ中佐は自宅に"
    },
    {
      "item_id": "cluster_71_save_menu:00770D16",
      "offset": 7802134,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "帰ったんだって。"
    },
    {
      "item_id": "cluster_71_save_menu:00770D2E",
      "offset": 7802158,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヒューズ中佐の自宅は"
    },
    {
      "item_id": "cluster_71_save_menu:00770D48",
      "offset": 7802184,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セントラルの中央区画だよ"
    },
    {
      "item_id": "cluster_71_save_menu:00770D80",
      "offset": 7802240,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "グレイシアさん、"
    },
    {
      "item_id": "cluster_71_save_menu:00770D96",
      "offset": 7802262,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヒューズ中佐は図書館の"
    },
    {
      "item_id": "cluster_71_save_menu:00770DB2",
      "offset": 7802290,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "分館にいるって言ってたよね"
    },
    {
      "item_id": "cluster_71_save_menu:00770DEC",
      "offset": 7802348,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中央軍司令部にいる"
    },
    {
      "item_id": "cluster_71_save_menu:00770E04",
      "offset": 7802372,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アームストロング少佐に"
    },
    {
      "item_id": "cluster_71_save_menu:00770E20",
      "offset": 7802400,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "会いに行こう"
    },
    {
      "item_id": "cluster_71_save_menu:00770E4C",
      "offset": 7802444,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "列車でイーストシティへ出発だ"
    },
    {
      "item_id": "cluster_71_save_menu:00770E6E",
      "offset": 7802478,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "駅は南側区画だよ"
    },
    {
      "item_id": "cluster_71_save_menu:00770E9E",
      "offset": 7802526,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "バルドを探そう。"
    },
    {
      "item_id": "cluster_71_save_menu:00770EB4",
      "offset": 7802548,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっと、列車の上にいるよ"
    },
    {
      "item_id": "cluster_71_save_menu:00770EEC",
      "offset": 7802604,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐に会いに行こうよ。"
    },
    {
      "item_id": "cluster_71_save_menu:00770F08",
      "offset": 7802632,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イーストシティの北側にある"
    },
    {
      "item_id": "cluster_71_save_menu:00770F28",
      "offset": 7802664,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "東方軍司令部にいるよ"
    },
    {
      "item_id": "cluster_71_save_menu:00770F5C",
      "offset": 7802716,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐を追いかけよう。"
    },
    {
      "item_id": "cluster_71_save_menu:00770F76",
      "offset": 7802742,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "広場は東側だったっけ？"
    },
    {
      "item_id": "cluster_71_save_menu:00770FAC",
      "offset": 7802796,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンスって人を"
    },
    {
      "item_id": "cluster_71_save_menu:00770FC6",
      "offset": 7802822,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "探さないとね"
    },
    {
      "item_id": "cluster_71_save_menu:00770FF2",
      "offset": 7802866,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キメラを倒さないと！"
    },
    {
      "item_id": "cluster_71_save_menu:0077100C",
      "offset": 7802892,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "急ごう！！"
    },
    {
      "item_id": "cluster_71_save_menu:00771036",
      "offset": 7802934,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "目的地はレドンドだよ。"
    },
    {
      "item_id": "cluster_71_save_menu:00771052",
      "offset": 7802962,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早く行こう"
    },
    {
      "item_id": "cluster_71_save_menu:0077108A",
      "offset": 7803018,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、レドンドへ行かないと"
    },
    {
      "item_id": "cluster_71_save_menu:007710B8",
      "offset": 7803064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まず、街の人に話を"
    },
    {
      "item_id": "cluster_71_save_menu:007710D0",
      "offset": 7803088,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "聞いてみようよ"
    },
    {
      "item_id": "cluster_71_save_menu:00771126",
      "offset": 7803174,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、レドンドへ行かないと"
    },
    {
      "item_id": "cluster_71_save_menu:00771158",
      "offset": 7803224,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行き詰まった時は現場に"
    },
    {
      "item_id": "cluster_71_save_menu:00771174",
      "offset": 7803252,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行ってみるのも"
    },
    {
      "item_id": "cluster_71_save_menu:00771188",
      "offset": 7803272,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいんじゃないかな"
    },
    {
      "item_id": "cluster_71_save_menu:007711C8",
      "offset": 7803336,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、犯人は金庫室の奥だよ"
    },
    {
      "item_id": "cluster_71_save_menu:007711F6",
      "offset": 7803382,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっとこの奥に犯人がいるよ"
    },
    {
      "item_id": "cluster_71_save_menu:00771290",
      "offset": 7803536,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうしたの？"
    },
    {
      "item_id": "cluster_71_save_menu:007712A2",
      "offset": 7803554,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ソリンに行って二人組の事を"
    },
    {
      "item_id": "cluster_71_save_menu:007712C2",
      "offset": 7803586,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "調べようよ"
    },
    {
      "item_id": "cluster_71_save_menu:007712EC",
      "offset": 7803628,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "村の人に話を聞いてみよう"
    },
    {
      "item_id": "cluster_71_save_menu:00771324",
      "offset": 7803684,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクたちのニセモノは"
    },
    {
      "item_id": "cluster_71_save_menu:0077133E",
      "offset": 7803710,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "裏山にいるみたいだね。"
    },
    {
      "item_id": "cluster_71_save_menu:0077135A",
      "offset": 7803738,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "探してみよう"
    },
    {
      "item_id": "cluster_71_save_menu:00771386",
      "offset": 7803782,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そのダイムラーさんって人が"
    },
    {
      "item_id": "cluster_71_save_menu:007713A6",
      "offset": 7803814,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "怪しいのか…探してみよう"
    },
    {
      "item_id": "cluster_71_save_menu:007713DE",
      "offset": 7803870,
