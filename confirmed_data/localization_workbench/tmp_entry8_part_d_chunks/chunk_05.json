{
  "items": [
    {
      "item_id": "cluster_57_bank:00751378",
      "offset": 7672696,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "探すっていう本来の目的は？"
    },
    {
      "item_id": "cluster_57_bank:007513A4",
      "offset": 7672740,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "んなもん、後回しだっ！"
    },
    {
      "item_id": "cluster_57_bank:007513C0",
      "offset": 7672768,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレを怒らせたら"
    },
    {
      "item_id": "cluster_57_bank:007513D6",
      "offset": 7672790,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうなるか思い知らせて…"
    },
    {
      "item_id": "cluster_57_bank:00751406",
      "offset": 7672838,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エド…そのセリフ、"
    },
    {
      "item_id": "cluster_57_bank:0075141E",
      "offset": 7672862,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どっちが悪役か"
    },
    {
      "item_id": "cluster_57_bank:00751432",
      "offset": 7672882,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わからないと思いますよ"
    },
    {
      "item_id": "cluster_57_bank:0075145E",
      "offset": 7672926,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アル、行くぞ！"
    },
    {
      "item_id": "cluster_57_bank:00751472",
      "offset": 7672946,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっとケイトのヤツを"
    },
    {
      "item_id": "cluster_57_bank:0075148C",
      "offset": 7672972,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "探し出してやる！"
    },
    {
      "item_id": "cluster_57_bank:007514B8",
      "offset": 7673016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ、兄さん！"
    },
    {
      "item_id": "cluster_57_bank:007514F6",
      "offset": 7673078,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだか、目的が"
    },
    {
      "item_id": "cluster_57_bank:0075150C",
      "offset": 7673100,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "変わっているような気が…"
    },
    {
      "item_id": "cluster_57_bank:0075152A",
      "offset": 7673130,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私、不安…"
    },
    {
      "item_id": "cluster_57_bank:00751782",
      "offset": 7673730,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "調査と修理は終わりましたが、"
    },
    {
      "item_id": "cluster_57_bank:007517A4",
      "offset": 7673764,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まだ中はキメラでいっぱいです"
    },
    {
      "item_id": "cluster_57_bank:007517C6",
      "offset": 7673798,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気をつけてください"
    },
    {
      "item_id": "cluster_57_bank:00751840",
      "offset": 7673920,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダメですってば！"
    },
    {
      "item_id": "cluster_57_bank:0075186C",
      "offset": 7673964,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "例の事件の後、"
    },
    {
      "item_id": "cluster_57_bank:00751880",
      "offset": 7673984,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "調査や修理のため、"
    },
    {
      "item_id": "cluster_57_bank:00751898",
      "offset": 7674008,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "入城は禁じられてます"
    },
    {
      "item_id": "cluster_57_bank:00751928",
      "offset": 7674152,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダメですってば！"
    },
    {
      "item_id": "cluster_57_bank:00751954",
      "offset": 7674196,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "例の事件の後、"
    },
    {
      "item_id": "cluster_57_bank:00751968",
      "offset": 7674216,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "調査や修理のため、"
    },
    {
      "item_id": "cluster_57_bank:00751980",
      "offset": 7674240,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "入城は禁じられてます"
    },
    {
      "item_id": "cluster_57_bank:00751A10",
      "offset": 7674384,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダメですってば！"
    },
    {
      "item_id": "cluster_57_bank:00751A3C",
      "offset": 7674428,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "例の事件の後、"
    },
    {
      "item_id": "cluster_57_bank:00751A50",
      "offset": 7674448,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "調査や修理のため、"
    },
    {
      "item_id": "cluster_57_bank:00751A68",
      "offset": 7674472,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "入城は禁じられてます"
    },
    {
      "item_id": "cluster_58_military:00753100",
      "offset": 7680256,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケイトのヤツは"
    },
    {
      "item_id": "cluster_58_military:00753114",
      "offset": 7680276,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どこにいるんだ！？"
    },
    {
      "item_id": "cluster_58_military:00753138",
      "offset": 7680312,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、探す相手が違うって、"
    },
    {
      "item_id": "cluster_58_military:00753168",
      "offset": 7680360,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "探さなきゃならないのは、"
    },
    {
      "item_id": "cluster_58_military:00753186",
      "offset": 7680390,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーなのに…"
    },
    {
      "item_id": "cluster_58_military:007531C0",
      "offset": 7680448,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よう、待ってたぜ！"
    },
    {
      "item_id": "cluster_58_military:007531D8",
      "offset": 7680472,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の錬金術師よ！"
    },
    {
      "item_id": "cluster_58_military:007532A2",
      "offset": 7680674,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "またかよっ！"
    },
    {
      "item_id": "cluster_58_military:007532C6",
      "offset": 7680710,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一応、ボケてみただけだろ。"
    },
    {
      "item_id": "cluster_58_military:007532E6",
      "offset": 7680742,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなマジにならなくてもさぁ"
    },
    {
      "item_id": "cluster_58_military:0075331E",
      "offset": 7680798,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の錬金術師よ、"
    },
    {
      "item_id": "cluster_58_military:00753334",
      "offset": 7680820,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今度こそ俺のもとに"
    },
    {
      "item_id": "cluster_58_military:0075334C",
      "offset": 7680844,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ひれ伏せさせてやるぜっ！"
    },
    {
      "item_id": "cluster_58_military:007533BC",
      "offset": 7680956,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "興味がないのはわかるけど、"
    },
    {
      "item_id": "cluster_58_military:007533DC",
      "offset": 7680988,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "相手をしてあげるのも礼儀よ"
    },
    {
      "item_id": "cluster_58_military:00753406",
      "offset": 7681030,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わざわざ出てきたのに、"
    },
    {
      "item_id": "cluster_58_military:00753422",
      "offset": 7681058,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かわいそうだと思いません？"
    },
    {
      "item_id": "cluster_58_military:00753458",
      "offset": 7681112,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "同情すんなっ！"
    },
    {
      "item_id": "cluster_58_military:0075346C",
      "offset": 7681132,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここから先、大将のもとには"
    },
    {
      "item_id": "cluster_58_military:0075348C",
      "offset": 7681164,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行かせねぇぜ！"
    },
    {
      "item_id": "cluster_58_military:007534B8",
      "offset": 7681208,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なるほど。"
    },
    {
      "item_id": "cluster_58_military:007534C8",
      "offset": 7681224,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "では、この先に"
    },
    {
      "item_id": "cluster_58_military:007534DC",
      "offset": 7681244,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーがいるのだな？"
    },
    {
      "item_id": "cluster_58_military:00753502",
      "offset": 7681282,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "教えてくれて感謝しよう"
    },
    {
      "item_id": "cluster_58_military:00753550",
      "offset": 7681360,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ハッ、またいらねーこと"
    },
    {
      "item_id": "cluster_58_military:0075356C",
      "offset": 7681388,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言っちまったか！？"
    },
    {
      "item_id": "cluster_58_military:00753596",
      "offset": 7681430,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "てことは、ケイトのヤツも"
    },
    {
      "item_id": "cluster_58_military:007535B4",
      "offset": 7681460,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そこにいるんだよな？"
    },
    {
      "item_id": "cluster_58_military:007535DA",
      "offset": 7681498,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、兄さん、探す相手が"
    },
    {
      "item_id": "cluster_58_military:007535FA",
      "offset": 7681530,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "違うって…"
    },
    {
      "item_id": "cluster_58_military:0075361E",
      "offset": 7681566,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前ら、ごちゃごちゃ"
    },
    {
      "item_id": "cluster_58_military:00753638",
      "offset": 7681592,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うるせーぞ！"
    },
    {
      "item_id": "cluster_58_military:00753662",
      "offset": 7681634,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "とにかく、先には行かせねー！"
    },
    {
      "item_id": "cluster_58_military:00753684",
      "offset": 7681668,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ウチの大将の元へはな！"
    },
    {
      "item_id": "cluster_58_military:007536B2",
      "offset": 7681714,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なぜ、そんなにリンカーに"
    },
    {
      "item_id": "cluster_58_military:007536D0",
      "offset": 7681744,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "肩入れする？"
    },
    {
      "item_id": "cluster_58_military:007536FA",
      "offset": 7681786,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "フン！お前らのような、"
    },
    {
      "item_id": "cluster_58_military:00753716",
      "offset": 7681814,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エリート錬金術師には"
    },
    {
      "item_id": "cluster_58_military:00753730",
      "offset": 7681840,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっとわかんねーよ！"
    },
    {
      "item_id": "cluster_58_military:00753754",
      "offset": 7681876,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…大将はな、"
    },
    {
      "item_id": "cluster_58_military:00753766",
      "offset": 7681894,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "俺のショボイ錬金術を見て"
    },
    {
      "item_id": "cluster_58_military:00753784",
      "offset": 7681924,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すげーって言ってくれた…"
    },
    {
      "item_id": "cluster_58_military:007537AC",
      "offset": 7681964,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "俺の錬成術は、"
    },
    {
      "item_id": "cluster_58_military:007537C0",
      "offset": 7681984,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ただ筋肉を硬くするだけだ"
    },
    {
      "item_id": "cluster_58_military:007537F0",
      "offset": 7682032,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そう、そして殴るだけ"
    },
    {
      "item_id": "cluster_58_military:00753822",
      "offset": 7682082,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うっせー！"
    },
    {
      "item_id": "cluster_58_military:00753832",
      "offset": 7682098,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "チャチャいれんじゃねーよ！"
    },
    {
      "item_id": "cluster_58_military:00753864",
      "offset": 7682148,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ま、そのとーりだけどよ…"
    },
    {
      "item_id": "cluster_58_military:00753882",
      "offset": 7682178,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "けど、そんな俺の錬成術に"
    },
    {
      "item_id": "cluster_58_military:007538A0",
      "offset": 7682208,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "治癒錬成のヒントがあるってよ"
    },
    {
      "item_id": "cluster_58_military:007538D4",
      "offset": 7682260,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人間の身体のことを"
    },
    {
      "item_id": "cluster_58_military:007538EC",
      "offset": 7682284,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "良く理解していなければ"
    },
    {
      "item_id": "cluster_58_military:00753908",
      "offset": 7682312,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "肉体の操作はできないわ"
    },
    {
      "item_id": "cluster_58_military:0075392E",
      "offset": 7682350,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それは治癒錬成に"
    },
    {
      "item_id": "cluster_58_military:00753944",
      "offset": 7682372,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "通じるものでもある…"
    },
    {
      "item_id": "cluster_58_military:0075396E",
      "offset": 7682414,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "難しいことはわかんねー。"
    },
    {
      "item_id": "cluster_58_military:0075398C",
      "offset": 7682444,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "俺はいつもフィーリングで"
    },
    {
      "item_id": "cluster_58_military:007539AA",
      "offset": 7682474,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬成してるしよ"
    },
    {
      "item_id": "cluster_58_military:007539D4",
      "offset": 7682516,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "（ある意味、天才…？）"
    },
    {
      "item_id": "cluster_58_military:007539FC",
      "offset": 7682556,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "けどよ、そんな俺に"
    },
    {
      "item_id": "cluster_58_military:00753A14",
      "offset": 7682580,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大将はこう言った"
    },
    {
      "item_id": "cluster_58_military:00753A34",
      "offset": 7682612,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "俺の錬成術のメカニズムが"
    },
    {
      "item_id": "cluster_58_military:00753A52",
      "offset": 7682642,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わかれば、たくさんの身体の"
    },
    {
      "item_id": "cluster_58_military:00753A72",
      "offset": 7682674,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "弱い人が救えるってな"
    },
    {
      "item_id": "cluster_58_military:00753A9C",
      "offset": 7682716,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、こんな俺でも人の役に"
    },
    {
      "item_id": "cluster_58_military:00753ABE",
      "offset": 7682750,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "立てるならってよ！"
    },
    {
      "item_id": "cluster_58_military:00753B10",
      "offset": 7682832,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっぱお前らには"
    },
    {
      "item_id": "cluster_58_military:00753B26",
      "offset": 7682854,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わかんねーよな！"
    },
    {
      "item_id": "cluster_58_military:00753B66",
      "offset": 7682918,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あーっ、もう面倒だ！"
    },
    {
      "item_id": "cluster_58_military:00753B80",
      "offset": 7682944,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼と焔と雷！"
    },
    {
      "item_id": "cluster_58_military:00753B92",
      "offset": 7682962,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前ら俺と戦え！"
    },
    {
      "item_id": "cluster_58_military:00753BC0",
      "offset": 7683008,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "な、なんでそうなるんだよ！"
    },
    {
      "item_id": "cluster_58_military:00753BF8",
      "offset": 7683064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ほう、ご指名と来たか。"
    },
    {
      "item_id": "cluster_58_military:00753C14",
      "offset": 7683092,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よかろう！"
    },
    {
      "item_id": "cluster_58_military:00753C36",
      "offset": 7683126,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よー、ちょっと待てよ…"
    },
    {
      "item_id": "cluster_58_military:00753C52",
      "offset": 7683154,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんでオレ様も…？"
    },
    {
