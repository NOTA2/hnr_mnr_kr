{
  "items": [
    {
      "item_id": "cluster_55_east_city:0074E588",
      "offset": 7660936,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "勝手に殺すな！"
    },
    {
      "item_id": "cluster_55_east_city:0074E5D0",
      "offset": 7661008,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "では、ゆくぞ！"
    },
    {
      "item_id": "cluster_55_east_city:0074E696",
      "offset": 7661206,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうだ、鋼の？"
    },
    {
      "item_id": "cluster_55_east_city:0074E6AA",
      "offset": 7661226,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私の勇姿を"
    },
    {
      "item_id": "cluster_55_east_city:0074E6BA",
      "offset": 7661242,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その目に焼き付けたかね？"
    },
    {
      "item_id": "cluster_55_east_city:0074E6E4",
      "offset": 7661284,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "はいはい、お見事でした"
    },
    {
      "item_id": "cluster_55_east_city:0074E718",
      "offset": 7661336,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヒゲも消えたし、"
    },
    {
      "item_id": "cluster_55_east_city:0074E72E",
      "offset": 7661358,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これで胸をはって"
    },
    {
      "item_id": "cluster_55_east_city:0074E744",
      "offset": 7661380,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "帰れますね、大佐"
    },
    {
      "item_id": "cluster_55_east_city:0074E76E",
      "offset": 7661422,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ふ…私の手にかかれば、"
    },
    {
      "item_id": "cluster_55_east_city:0074E78A",
      "offset": 7661450,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この程度のキメラなど…"
    },
    {
      "item_id": "cluster_56_military:0074FDD0",
      "offset": 7667152,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "古めかしい城だな…"
    },
    {
      "item_id": "cluster_56_military:0074FDE8",
      "offset": 7667176,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ずいぶん使われて"
    },
    {
      "item_id": "cluster_56_military:0074FDFE",
      "offset": 7667198,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なかったようだけど"
    },
    {
      "item_id": "cluster_56_military:0074FE28",
      "offset": 7667240,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "地元の人間すら"
    },
    {
      "item_id": "cluster_56_military:0074FE3C",
      "offset": 7667260,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう忘れかけていたような"
    },
    {
      "item_id": "cluster_56_military:0074FE5A",
      "offset": 7667290,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "過去の遺物だもの"
    },
    {
      "item_id": "cluster_56_military:0074FE88",
      "offset": 7667336,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なるほど、軍の連中など"
    },
    {
      "item_id": "cluster_56_military:0074FEA4",
      "offset": 7667364,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "とうの昔に存在を"
    },
    {
      "item_id": "cluster_56_military:0074FEBA",
      "offset": 7667386,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "忘れ去っていたわけだ"
    },
    {
      "item_id": "cluster_56_military:0074FEDE",
      "offset": 7667422,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、仮にも国家の所有物に"
    },
    {
      "item_id": "cluster_56_military:0074FEFE",
      "offset": 7667454,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "勝手に住み着くのは"
    },
    {
      "item_id": "cluster_56_military:0074FF16",
      "offset": 7667478,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "感心せんな"
    },
    {
      "item_id": "cluster_56_military:0074FF3E",
      "offset": 7667518,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なら、いっちょ"
    },
    {
      "item_id": "cluster_56_military:0074FF52",
      "offset": 7667538,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お宅訪問と行くか！"
    },
    {
      "item_id": "cluster_56_military:0074FF6A",
      "offset": 7667562,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かなり手荒な訪問になるけどな"
    },
    {
      "item_id": "cluster_56_military:0074FFBA",
      "offset": 7667642,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィ、大丈夫？"
    },
    {
      "item_id": "cluster_56_military:0074FFDE",
      "offset": 7667678,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だ、大丈夫…"
    },
    {
      "item_id": "cluster_56_military:0075001A",
      "offset": 7667738,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私よりずっと小さいエドが"
    },
    {
      "item_id": "cluster_56_military:00750038",
      "offset": 7667768,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "がんばってるんだもの"
    },
    {
      "item_id": "cluster_56_military:00750052",
      "offset": 7667794,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私だって！"
    },
    {
      "item_id": "cluster_56_military:00750092",
      "offset": 7667858,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あんまり兄さんを"
    },
    {
      "item_id": "cluster_56_military:007500A8",
      "offset": 7667880,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "基準にしない方がいいと"
    },
    {
      "item_id": "cluster_56_military:007500C4",
      "offset": 7667908,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "思うけど…"
    },
    {
      "item_id": "cluster_56_military:00750308",
      "offset": 7668488,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "また会っちゃったわね、"
    },
    {
      "item_id": "cluster_56_military:00750324",
      "offset": 7668516,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の坊や"
    },
    {
      "item_id": "cluster_56_military:00750342",
      "offset": 7668546,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いい加減、その坊やって"
    },
    {
      "item_id": "cluster_56_military:0075035E",
      "offset": 7668574,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "呼び方どうにかして"
    },
    {
      "item_id": "cluster_56_military:00750376",
      "offset": 7668598,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "くれねぇかな"
    },
    {
      "item_id": "cluster_56_military:00750398",
      "offset": 7668632,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ふふ…考えとくわ"
    },
    {
      "item_id": "cluster_56_military:007503BE",
      "offset": 7668670,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しかし、また厄介な相手が"
    },
    {
      "item_id": "cluster_56_military:007503DC",
      "offset": 7668700,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "出てきたもんだ…"
    },
    {
      "item_id": "cluster_56_military:007503F2",
      "offset": 7668722,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "けどな…アル"
    },
    {
      "item_id": "cluster_56_military:00750416",
      "offset": 7668758,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん？"
    },
    {
      "item_id": "cluster_56_military:00750430",
      "offset": 7668784,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ますますビンゴって気に"
    },
    {
      "item_id": "cluster_56_military:0075044C",
      "offset": 7668812,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なってきたぜ…"
    },
    {
      "item_id": "cluster_56_military:00750460",
      "offset": 7668832,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アイツと出会うところ…"
    },
    {
      "item_id": "cluster_56_military:0075048E",
      "offset": 7668878,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "賢者の石に関わりがある！"
    },
    {
      "item_id": "cluster_56_military:007504B8",
      "offset": 7668920,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そういうこと。"
    },
    {
      "item_id": "cluster_56_military:007504CC",
      "offset": 7668940,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だけど、その前に"
    },
    {
      "item_id": "cluster_56_military:007504E2",
      "offset": 7668962,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここを切り抜けるのが先か…"
    },
    {
      "item_id": "cluster_56_military:00750536",
      "offset": 7669046,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "せっかく会ったんだし"
    },
    {
      "item_id": "cluster_56_military:00750550",
      "offset": 7669072,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "少しだけ遊んであげるわ＄"
    },
    {
      "item_id": "cluster_56_military:0075056E",
      "offset": 7669102,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の坊や"
    },
    {
      "item_id": "cluster_56_military:0075058E",
      "offset": 7669134,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "くっ…！"
    },
    {
      "item_id": "cluster_56_military:007505A8",
      "offset": 7669160,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "坊やって呼ぶんじゃねーって"
    },
    {
      "item_id": "cluster_56_military:007505C8",
      "offset": 7669192,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言ってんだろうがっ！！"
    },
    {
      "item_id": "cluster_56_military:007506A2",
      "offset": 7669410,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おい、いっちまったぞ。"
    },
    {
      "item_id": "cluster_56_military:007506BE",
      "offset": 7669438,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいのか、ほっといてよ？"
    },
    {
      "item_id": "cluster_56_military:007506E8",
      "offset": 7669480,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああ、深追いしない方がいい。"
    },
    {
      "item_id": "cluster_56_military:0075070A",
      "offset": 7669514,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こっちがやばいからな。"
    },
    {
      "item_id": "cluster_56_military:00750726",
      "offset": 7669542,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "先に進もう"
    },
    {
      "item_id": "cluster_57_bank:00750B9C",
      "offset": 7670684,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "小僧、また会ったな！"
    },
    {
      "item_id": "cluster_57_bank:00750BC2",
      "offset": 7670722,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "またバルド？"
    },
    {
      "item_id": "cluster_57_bank:00750BE2",
      "offset": 7670754,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "な、なんでバルドのヤツが"
    },
    {
      "item_id": "cluster_57_bank:00750C00",
      "offset": 7670784,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここに…？"
    },
    {
      "item_id": "cluster_57_bank:00750C22",
      "offset": 7670818,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中尉、どうなっている？"
    },
    {
      "item_id": "cluster_57_bank:00750C50",
      "offset": 7670864,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "バルドは現在、"
    },
    {
      "item_id": "cluster_57_bank:00750C64",
      "offset": 7670884,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "確かに刑務所で服役中です"
    },
    {
      "item_id": "cluster_57_bank:00750C8E",
      "offset": 7670926,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ならニセモノっちゅーこったな"
    },
    {
      "item_id": "cluster_57_bank:00750CC2",
      "offset": 7670978,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もしかしてケイトの人形！？"
    },
    {
      "item_id": "cluster_57_bank:00750CE2",
      "offset": 7671010,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それじゃあ、前に列車の中で"
    },
    {
      "item_id": "cluster_57_bank:00750D02",
      "offset": 7671042,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "会ったバルドもケイトが？"
    },
    {
      "item_id": "cluster_57_bank:00750D2E",
      "offset": 7671086,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ、私が人質にされて"
    },
    {
      "item_id": "cluster_57_bank:00750D48",
      "offset": 7671112,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドとアルが助けてくれた時の"
    },
    {
      "item_id": "cluster_57_bank:00750D6A",
      "offset": 7671146,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "列車強盗さんね！"
    },
    {
      "item_id": "cluster_57_bank:00750D96",
      "offset": 7671190,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ゴチャゴチャ言ってねぇで"
    },
    {
      "item_id": "cluster_57_bank:00750DB4",
      "offset": 7671220,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かかってきな！"
    },
    {
      "item_id": "cluster_57_bank:00750DD4",
      "offset": 7671252,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の、かかってこいと"
    },
    {
      "item_id": "cluster_57_bank:00750DEE",
      "offset": 7671278,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言っているようだが？"
    },
    {
      "item_id": "cluster_57_bank:00750E1A",
      "offset": 7671322,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐、その言い方だと、"
    },
    {
      "item_id": "cluster_57_bank:00750E36",
      "offset": 7671350,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分は関係ないっていう"
    },
    {
      "item_id": "cluster_57_bank:00750E52",
      "offset": 7671378,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "感じなんだけど？"
    },
    {
      "item_id": "cluster_57_bank:00750E78",
      "offset": 7671416,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "本人でないとわかった時点で"
    },
    {
      "item_id": "cluster_57_bank:00750E98",
      "offset": 7671448,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私が手を下す必要はなくなった"
    },
    {
      "item_id": "cluster_57_bank:00750EBA",
      "offset": 7671482,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それに…"
    },
    {
      "item_id": "cluster_57_bank:00750ED4",
      "offset": 7671508,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "残念ながら、鋼の"
    },
    {
      "item_id": "cluster_57_bank:00750EEA",
      "offset": 7671530,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "君をご指名だからな。"
    },
    {
      "item_id": "cluster_57_bank:00750F04",
      "offset": 7671556,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ああ、残念だ"
    },
    {
      "item_id": "cluster_57_bank:00750F2A",
      "offset": 7671594,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しかし大佐、一刻も早く先に"
    },
    {
      "item_id": "cluster_57_bank:00750F4A",
      "offset": 7671626,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "進まねばなりませんぞ"
    },
    {
      "item_id": "cluster_57_bank:00750F76",
      "offset": 7671670,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "少佐、ここは一気に"
    },
    {
      "item_id": "cluster_57_bank:00750F8E",
      "offset": 7671694,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "片付けた方が早く済むと、"
    },
    {
      "item_id": "cluster_57_bank:00750FAC",
      "offset": 7671724,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "君は言うわけだな"
    },
    {
      "item_id": "cluster_57_bank:00750FCC",
      "offset": 7671756,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たしかに一理ある。"
    },
    {
      "item_id": "cluster_57_bank:00750FE4",
      "offset": 7671780,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…よし、鋼の、"
    },
    {
      "item_id": "cluster_57_bank:00750FF8",
      "offset": 7671800,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "貸しにしておいてやろう"
    },
    {
      "item_id": "cluster_57_bank:00751026",
      "offset": 7671846,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんでオレの貸しなんだよ！"
    },
    {
      "item_id": "cluster_57_bank:0075105C",
      "offset": 7671900,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "き、貴様らっ！"
    },
    {
      "item_id": "cluster_57_bank:00751070",
      "offset": 7671920,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わざと俺様の存在を"
    },
    {
      "item_id": "cluster_57_bank:00751088",
      "offset": 7671944,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "無視してるだろっ！"
    },
    {
      "item_id": "cluster_57_bank:007510B2",
      "offset": 7671986,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あーあ。"
    },
    {
      "item_id": "cluster_57_bank:007510C0",
      "offset": 7672000,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "怒らせちゃったよ"
    },
    {
      "item_id": "cluster_57_bank:007510DE",
      "offset": 7672030,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あんまり怒らせると、"
    },
    {
      "item_id": "cluster_57_bank:007510F8",
