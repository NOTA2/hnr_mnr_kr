{
  "items": [
    {
      "item_id": "cluster_69_military:0076D0AE",
      "offset": 7786670,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "このカードじゃダメだな。"
    },
    {
      "item_id": "cluster_69_military:0076D0CC",
      "offset": 7786700,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "壁に足場をつくるには"
    },
    {
      "item_id": "cluster_69_military:0076D0E6",
      "offset": 7786726,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自然の６－４のカードが必要だ"
    },
    {
      "item_id": "cluster_69_military:0076D12E",
      "offset": 7786798,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いそげ！"
    },
    {
      "item_id": "cluster_69_military:0076D174",
      "offset": 7786868,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、"
    },
    {
      "item_id": "cluster_69_military:0076D182",
      "offset": 7786882,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早くマーティンス中佐を"
    },
    {
      "item_id": "cluster_69_military:0076D19E",
      "offset": 7786910,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "追わなきゃ！"
    },
    {
      "item_id": "cluster_69_military:0076D1B8",
      "offset": 7786936,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああ、わかってる！"
    },
    {
      "item_id": "cluster_69_military:0076D1D0",
      "offset": 7786960,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "壁に足場を作ってのぼるぞ！"
    },
    {
      "item_id": "cluster_69_military:0076D1F0",
      "offset": 7786992,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自然の６－４のカードだ！"
    },
    {
      "item_id": "cluster_70_military:0076DD52",
      "offset": 7789906,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…錬成融合。"
    },
    {
      "item_id": "cluster_70_military:0076DD64",
      "offset": 7789924,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それも自身とこの城を"
    },
    {
      "item_id": "cluster_70_military:0076DD7E",
      "offset": 7789950,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "融合したというのか"
    },
    {
      "item_id": "cluster_70_military:0076DDA6",
      "offset": 7789990,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんてヤツだよ。"
    },
    {
      "item_id": "cluster_70_military:0076DDBC",
      "offset": 7790012,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いったん逃げるぞ、アル！"
    },
    {
      "item_id": "cluster_70_military:0076DDEC",
      "offset": 7790060,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、逃げるってどこに！？"
    },
    {
      "item_id": "cluster_70_military:0076DE1E",
      "offset": 7790110,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どこって…"
    },
    {
      "item_id": "cluster_70_military:0076DE32",
      "offset": 7790130,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんなとこで戦えってのかよ！"
    },
    {
      "item_id": "cluster_70_military:0076DE70",
      "offset": 7790192,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "逃がすと思うのか？"
    },
    {
      "item_id": "cluster_70_military:0076DE88",
      "offset": 7790216,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この城はもはや"
    },
    {
      "item_id": "cluster_70_military:0076DE9C",
      "offset": 7790236,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我が肉体の一部と化した"
    },
    {
      "item_id": "cluster_70_military:0076DEC6",
      "offset": 7790278,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我が身体の中から"
    },
    {
      "item_id": "cluster_70_military:0076DEDC",
      "offset": 7790300,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "逃げられると思うてか！"
    },
    {
      "item_id": "cluster_70_military:0076DF28",
      "offset": 7790376,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セラフィ兄さん…"
    },
    {
      "item_id": "cluster_70_military:0076DF42",
      "offset": 7790402,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術って、誰かを"
    },
    {
      "item_id": "cluster_70_military:0076DF5A",
      "offset": 7790426,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "傷つけるためのものですか？"
    },
    {
      "item_id": "cluster_70_military:0076DF84",
      "offset": 7790468,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんが教えてくれた、"
    },
    {
      "item_id": "cluster_70_military:0076DFA0",
      "offset": 7790496,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術ってなんなんですか？"
    },
    {
      "item_id": "cluster_70_military:0076DFC4",
      "offset": 7790532,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…教えてください"
    },
    {
      "item_id": "cluster_70_military:0076DFEE",
      "offset": 7790574,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "時に傷つけることもあろう。"
    },
    {
      "item_id": "cluster_70_military:0076E012",
      "offset": 7790610,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、その力なくしては、"
    },
    {
      "item_id": "cluster_70_military:0076E030",
      "offset": 7790640,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰も守れはしないのだ"
    },
    {
      "item_id": "cluster_70_military:0076E060",
      "offset": 7790688,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…リンカーはさっき、"
    },
    {
      "item_id": "cluster_70_military:0076E07E",
      "offset": 7790718,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクや兄さんも"
    },
    {
      "item_id": "cluster_70_military:0076E092",
      "offset": 7790738,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "同じだって言った…"
    },
    {
      "item_id": "cluster_70_military:0076E0AC",
      "offset": 7790764,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクも最初、そう思った。"
    },
    {
      "item_id": "cluster_70_military:0076E0CE",
      "offset": 7790798,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だけど…"
    },
    {
      "item_id": "cluster_70_military:0076E0E6",
      "offset": 7790822,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっぱり違ってたよ"
    },
    {
      "item_id": "cluster_70_military:0076E10A",
      "offset": 7790858,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今でもボクたちは、"
    },
    {
      "item_id": "cluster_70_military:0076E122",
      "offset": 7790882,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "賢者の石を探している…"
    },
    {
      "item_id": "cluster_70_military:0076E14E",
      "offset": 7790926,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それで、"
    },
    {
      "item_id": "cluster_70_military:0076E15E",
      "offset": 7790942,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私とどこが違う？"
    },
    {
      "item_id": "cluster_70_military:0076E17A",
      "offset": 7790970,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "賢者の石を手に入れ、"
    },
    {
      "item_id": "cluster_70_military:0076E194",
      "offset": 7790996,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人体錬成という"
    },
    {
      "item_id": "cluster_70_military:0076E1A8",
      "offset": 7791016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "禁忌を犯してまでも母を…"
    },
    {
      "item_id": "cluster_70_military:0076E1D6",
      "offset": 7791062,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "勘違いしないで欲しい。"
    },
    {
      "item_id": "cluster_70_military:0076E1F2",
      "offset": 7791090,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクも兄さんも、今さら"
    },
    {
      "item_id": "cluster_70_military:0076E20E",
      "offset": 7791118,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなこと、思ってない"
    },
    {
      "item_id": "cluster_70_military:0076E232",
      "offset": 7791154,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああ。母さんを"
    },
    {
      "item_id": "cluster_70_military:0076E246",
      "offset": 7791174,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "生き返らせるなんて、とっくに"
    },
    {
      "item_id": "cluster_70_military:0076E268",
      "offset": 7791208,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誤りだったと気づいてるさ"
    },
    {
      "item_id": "cluster_70_military:0076E29A",
      "offset": 7791258,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ふふん…"
    },
    {
      "item_id": "cluster_70_military:0076E2AC",
      "offset": 7791276,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "反省しているから、"
    },
    {
      "item_id": "cluster_70_military:0076E2C4",
      "offset": 7791300,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私とは違うとでも？"
    },
    {
      "item_id": "cluster_70_military:0076E2E6",
      "offset": 7791334,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "単に覚悟が足りないだけ"
    },
    {
      "item_id": "cluster_70_military:0076E302",
      "offset": 7791362,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ではないのか？"
    },
    {
      "item_id": "cluster_70_military:0076E32A",
      "offset": 7791402,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレもアルも"
    },
    {
      "item_id": "cluster_70_military:0076E340",
      "offset": 7791424,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "覚悟ならできてるさ"
    },
    {
      "item_id": "cluster_70_military:0076E362",
      "offset": 7791458,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "万が一に、この身体を"
    },
    {
      "item_id": "cluster_70_military:0076E37C",
      "offset": 7791484,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "元に戻せたとして…"
    },
    {
      "item_id": "cluster_70_military:0076E3A4",
      "offset": 7791524,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いや、戻せるかどうかも"
    },
    {
      "item_id": "cluster_70_military:0076E3C0",
      "offset": 7791552,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わからないけどな。"
    },
    {
      "item_id": "cluster_70_military:0076E3D8",
      "offset": 7791576,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "仮に戻せたとしても…"
    },
    {
      "item_id": "cluster_70_military:0076E400",
      "offset": 7791616,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "世界の法則の流れに逆らい"
    },
    {
      "item_id": "cluster_70_military:0076E41E",
      "offset": 7791646,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人体錬成に手を染めた者"
    },
    {
      "item_id": "cluster_70_military:0076E444",
      "offset": 7791684,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その名は一生、"
    },
    {
      "item_id": "cluster_70_military:0076E458",
      "offset": 7791704,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "背負い続けなきゃならない"
    },
    {
      "item_id": "cluster_70_military:0076E48C",
      "offset": 7791756,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクたちは…"
    },
    {
      "item_id": "cluster_70_military:0076E4AA",
      "offset": 7791786,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレたちは…"
    },
    {
      "item_id": "cluster_70_military:0076E4CC",
      "offset": 7791820,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そういう業の道を歩む"
    },
    {
      "item_id": "cluster_70_military:0076E4E6",
      "offset": 7791846,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "覚悟をしたんだ！"
    },
    {
      "item_id": "cluster_70_military:0076E508",
      "offset": 7791880,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんな、ボクたちだから"
    },
    {
      "item_id": "cluster_70_military:0076E524",
      "offset": 7791908,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わかるんだ"
    },
    {
      "item_id": "cluster_70_military:0076E53A",
      "offset": 7791930,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…失ったものは、"
    },
    {
      "item_id": "cluster_70_military:0076E554",
      "offset": 7791956,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "元には戻せないって…"
    },
    {
      "item_id": "cluster_70_military:0076E57A",
      "offset": 7791994,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術は、望めば"
    },
    {
      "item_id": "cluster_70_military:0076E590",
      "offset": 7792016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんでもかなえてくれる、"
    },
    {
      "item_id": "cluster_70_military:0076E5AE",
      "offset": 7792046,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "魔法じゃないんだ"
    },
    {
      "item_id": "cluster_70_military:0076E5D2",
      "offset": 7792082,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "守るべきものを"
    },
    {
      "item_id": "cluster_70_military:0076E5E6",
      "offset": 7792102,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "失ってまで得た力というのは、"
    },
    {
      "item_id": "cluster_70_military:0076E608",
      "offset": 7792136,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんなんだ？"
    },
    {
      "item_id": "cluster_70_military:0076E624",
      "offset": 7792164,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんな錬成に"
    },
    {
      "item_id": "cluster_70_military:0076E636",
      "offset": 7792182,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんの意味があるんだ！？"
    },
    {
      "item_id": "cluster_70_military:0076E66A",
      "offset": 7792234,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大層な演説は、"
    },
    {
      "item_id": "cluster_70_military:0076E67E",
      "offset": 7792254,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それでおしまいかね？"
    },
    {
      "item_id": "cluster_70_military:0076E6A6",
      "offset": 7792294,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "理想を実現するには"
    },
    {
      "item_id": "cluster_70_military:0076E6BE",
      "offset": 7792318,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "犠牲というものも"
    },
    {
      "item_id": "cluster_70_military:0076E6D4",
      "offset": 7792340,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "時には必要なのだ！"
    },
    {
      "item_id": "cluster_70_military:0076E6F6",
      "offset": 7792374,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の錬金術師といえども、"
    },
    {
      "item_id": "cluster_70_military:0076E714",
      "offset": 7792404,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しょせんは"
    },
    {
      "item_id": "cluster_70_military:0076E724",
      "offset": 7792420,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "子供のたわごと！"
    },
    {
      "item_id": "cluster_70_military:0076E750",
      "offset": 7792464,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "子供といえども…"
    },
    {
      "item_id": "cluster_70_military:0076E76A",
      "offset": 7792490,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "むしろ子供だからこその"
    },
    {
      "item_id": "cluster_70_military:0076E786",
      "offset": 7792518,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "正論というのもある"
    },
    {
      "item_id": "cluster_70_military:0076E7AE",
      "offset": 7792558,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私やロイス大佐、"
    },
    {
      "item_id": "cluster_70_military:0076E7C6",
      "offset": 7792582,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あなたが"
    },
    {
      "item_id": "cluster_70_military:0076E7D4",
      "offset": 7792596,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "見失ってしまったものが、"
    },
    {
      "item_id": "cluster_70_military:0076E7F2",
      "offset": 7792626,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "彼らに見えることもあるのだ"
    },
    {
      "item_id": "cluster_70_military:0076E826",
      "offset": 7792678,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…そのようなたわごとを！"
    },
    {
      "item_id": "cluster_70_military:0076E85A",
      "offset": 7792730,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "時には犠牲も必要だなんて"
    },
    {
      "item_id": "cluster_70_military:0076E87C",
      "offset": 7792764,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんな言葉、"
    },
    {
      "item_id": "cluster_70_military:0076E890",
      "offset": 7792784,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんから"
    },
    {
      "item_id": "cluster_70_military:0076E8A0",
      "offset": 7792800,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "聞きたくはなかった"
    },
    {
      "item_id": "cluster_70_military:0076E8C2",
      "offset": 7792834,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大人とか子供とか関係ない。"
    },
    {
      "item_id": "cluster_70_military:0076E902",
      "offset": 7792898,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私はもう、これ以上、"
    },
    {
      "item_id": "cluster_70_military:0076E91C",
      "offset": 7792924,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大事な人たちを傷つけたくない"
    },
    {
      "item_id": "cluster_70_military:0076E948",
      "offset": 7792968,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "失いたくもない。"
    },
    {
      "item_id": "cluster_70_military:0076E962",
      "offset": 7792994,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから…"
    },
    {
      "item_id": "cluster_70_military:0076E9B0",
      "offset": 7793072,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ならば立て、"
    },
    {
      "item_id": "cluster_70_military:0076E9C4",
      "offset": 7793092,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分の足で。"
    },
    {
      "item_id": "cluster_70_military:0076E9D6",
      "offset": 7793110,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師を目指すならばな"
    },
    {
      "item_id": "cluster_70_military:0076EA0E",
      "offset": 7793166,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…はい。"
    },
    {
      "item_id": "cluster_70_military:0076EA20",
      "offset": 7793184,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術師よ、"
    },
    {
      "item_id": "cluster_70_military:0076EA32",
      "offset": 7793202,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大衆のためにあれ"
    },
    {
      "item_id": "cluster_70_military:0076EA58",
      "offset": 7793240,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この言葉を胸にしまい、"
    },
    {
      "item_id": "cluster_70_military:0076EA74",
      "offset": 7793268,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今度は私の足で歩きだします"
    },
    {
      "item_id": "cluster_70_military:0076EAA2",
      "offset": 7793314,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんの後を"
    },
    {
      "item_id": "cluster_70_military:0076EAB4",
      "offset": 7793332,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "追いかけるんじゃなく、"
    },
    {
      "item_id": "cluster_70_military:0076EAD0",
      "offset": 7793360,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分の信じた道を…"
    },
    {
      "item_id": "cluster_70_military:0076EB20",
      "offset": 7793440,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにをゴチャゴチャと"
    }
  ]
}