    {
      "item_id": "cluster_55_east_city:0074AD9C",
      "offset": 7646620,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…やっぱり思い出せません"
    },
    {
      "item_id": "cluster_55_east_city:0074ADD2",
      "offset": 7646674,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おのれ…そろいもそろって"
    },
    {
      "item_id": "cluster_55_east_city:0074ADF0",
      "offset": 7646704,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "俺をおちょくるかっ！"
