{
  "items": [
    {
      "item_id": "cluster_54_reward:00748ACA",
      "offset": 7637706,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、アレ！"
    },
    {
      "item_id": "cluster_54_reward:00748ADE",
      "offset": 7637726,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今、岩陰を横切ったの"
    },
    {
      "item_id": "cluster_54_reward:00748AF8",
      "offset": 7637752,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダイムラーじゃない！？"
    },
    {
      "item_id": "cluster_54_reward:00748B20",
      "offset": 7637792,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よっしゃー！"
    },
    {
      "item_id": "cluster_54_reward:00748B32",
      "offset": 7637810,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でかした、アル！"
    },
    {
      "item_id": "cluster_54_reward:00748B48",
      "offset": 7637832,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっさとカタをつけようぜ！"
    },
    {
      "item_id": "cluster_54_reward:00748BA8",
      "offset": 7637928,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "も、もう"
    },
    {
      "item_id": "cluster_54_reward:00748BB6",
      "offset": 7637942,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "追いつきおったのか！？"
    },
    {
      "item_id": "cluster_54_reward:00748BE4",
      "offset": 7637988,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あのさ、あんまり手間、"
    },
    {
      "item_id": "cluster_54_reward:00748C00",
      "offset": 7638016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "取らせないで欲しいんだよね"
    },
    {
      "item_id": "cluster_54_reward:00748C20",
      "offset": 7638048,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ちゃっちゃっといこうぜ"
    },
    {
      "item_id": "cluster_54_reward:00748C4C",
      "offset": 7638092,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わ、私が、いったい"
    },
    {
      "item_id": "cluster_54_reward:00748C64",
      "offset": 7638116,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにをしたと言うんじゃ！？"
    },
    {
      "item_id": "cluster_54_reward:00748C9C",
      "offset": 7638172,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あれぇ？"
    },
    {
      "item_id": "cluster_54_reward:00748CAA",
      "offset": 7638186,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あれだけのことやっといて"
    },
    {
      "item_id": "cluster_54_reward:00748CC8",
      "offset": 7638216,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しらを切るわけ？"
    },
    {
      "item_id": "cluster_54_reward:00748CFE",
      "offset": 7638270,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、一連の事件とは"
    },
    {
      "item_id": "cluster_54_reward:00748D1A",
      "offset": 7638298,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "無関係だと"
    },
    {
      "item_id": "cluster_54_reward:00748D2A",
      "offset": 7638314,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言っておるじゃろうが！"
    },
    {
      "item_id": "cluster_54_reward:00748D5E",
      "offset": 7638366,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あら、そういう態度、取る？"
    },
    {
      "item_id": "cluster_54_reward:00748D7E",
      "offset": 7638398,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なら力づくで"
    },
    {
      "item_id": "cluster_54_reward:00748D90",
      "offset": 7638416,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いくしかないな！"
    },
    {
      "item_id": "cluster_54_reward:00748DBC",
      "offset": 7638460,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わ、私は力には"
    },
    {
      "item_id": "cluster_54_reward:00748DD0",
      "offset": 7638480,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自信がないからな…"
    },
    {
      "item_id": "cluster_54_reward:00748DF4",
      "offset": 7638516,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "に、逃げるが勝ちじゃっ！"
    },
    {
      "item_id": "cluster_54_reward:00748E30",
      "offset": 7638576,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ、待て、コラっ！"
    },
    {
      "item_id": "cluster_54_reward:0074908A",
      "offset": 7639178,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それにしたって"
    },
    {
      "item_id": "cluster_54_reward:0074909E",
      "offset": 7639198,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きりがないぜ。"
    },
    {
      "item_id": "cluster_54_reward:007490B2",
      "offset": 7639218,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっさとボスを倒さなきゃ"
    },
    {
      "item_id": "cluster_54_reward:007490E2",
      "offset": 7639266,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もっと奥まで行かないと、"
    },
    {
      "item_id": "cluster_54_reward:00749100",
      "offset": 7639296,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボスはいないだろうね"
    },
    {
      "item_id": "cluster_54_reward:0074914E",
      "offset": 7639374,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだか、大佐、"
    },
    {
      "item_id": "cluster_54_reward:00749164",
      "offset": 7639396,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "不機嫌そうだよ"
    },
    {
      "item_id": "cluster_54_reward:0074918C",
      "offset": 7639436,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "笑いすぎたかな。"
    },
    {
      "item_id": "cluster_54_reward:007491BC",
      "offset": 7639484,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、あのヒゲ…ププッ"
    },
    {
      "item_id": "cluster_54_reward:007492F6",
      "offset": 7639798,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっぱり大佐のそのヒゲ、"
    },
    {
      "item_id": "cluster_54_reward:00749314",
      "offset": 7639828,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "緊張感に欠けるんだよなぁ"
    },
    {
      "item_id": "cluster_54_reward:0074933E",
      "offset": 7639870,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "余計なお世話だ！"
    },
    {
      "item_id": "cluster_54_reward:00749354",
      "offset": 7639892,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "落とせるなら、"
    },
    {
      "item_id": "cluster_54_reward:00749368",
      "offset": 7639912,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "落としたいのはやまやまだ"
    },
    {
      "item_id": "cluster_54_reward:0074939E",
      "offset": 7639966,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだ、落ちないのか。"
    },
    {
      "item_id": "cluster_54_reward:007493BA",
      "offset": 7639994,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "てっきり気に入ってるのかと"
    },
    {
      "item_id": "cluster_54_reward:007493DA",
      "offset": 7640026,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "思ったよ"
    },
    {
      "item_id": "cluster_54_reward:00749408",
      "offset": 7640072,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰がだ！"
    },
    {
      "item_id": "cluster_54_reward:00749428",
      "offset": 7640104,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも落ちないってことは、"
    },
    {
      "item_id": "cluster_54_reward:00749446",
      "offset": 7640134,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ずっとそのままってことも"
    },
    {
      "item_id": "cluster_54_reward:00749464",
      "offset": 7640164,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あるわけですよね…"
    },
    {
      "item_id": "cluster_54_reward:007494AC",
      "offset": 7640236,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ、そりゃ最悪だよな。"
    },
    {
      "item_id": "cluster_54_reward:007494C8",
      "offset": 7640264,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一生、そんなヒゲで"
    },
    {
      "item_id": "cluster_54_reward:007494E0",
      "offset": 7640288,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "暮らすなんて！"
    },
    {
      "item_id": "cluster_54_reward:007495F0",
      "offset": 7640560,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これが最後の素材…"
    },
    {
      "item_id": "cluster_54_reward:0074960C",
      "offset": 7640588,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "クルジウム、ゲットだぜ！"
    },
    {
      "item_id": "cluster_54_reward:00749670",
      "offset": 7640688,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ウィンリィのところに戻るか"
    },
    {
      "item_id": "cluster_55_east_city:0074A47E",
      "offset": 7644286,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あのう、"
    },
    {
      "item_id": "cluster_55_east_city:0074A48C",
      "offset": 7644300,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "根本的問題なんですけど"
    },
    {
      "item_id": "cluster_55_east_city:0074A4A8",
      "offset": 7644328,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰を探してるんですか？"
    },
    {
      "item_id": "cluster_55_east_city:0074A512",
      "offset": 7644434,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダイムラーのヤツを"
    },
    {
      "item_id": "cluster_55_east_city:0074A52A",
      "offset": 7644458,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "手にかけた犯人をだよ"
    },
    {
      "item_id": "cluster_55_east_city:0074A556",
      "offset": 7644502,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それで、誰かその犯人の"
    },
    {
      "item_id": "cluster_55_east_city:0074A572",
      "offset": 7644530,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "顔を知ってるんですか？"
    },
    {
      "item_id": "cluster_55_east_city:0074A5B0",
      "offset": 7644592,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐、犯人の目星くらい"
    },
    {
      "item_id": "cluster_55_east_city:0074A5CC",
      "offset": 7644620,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ついてるよね？"
    },
    {
      "item_id": "cluster_55_east_city:0074A610",
      "offset": 7644688,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そっちは？"
    },
    {
      "item_id": "cluster_55_east_city:0074A632",
      "offset": 7644722,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ついてたら聞かないって"
    },
    {
      "item_id": "cluster_55_east_city:0074A660",
      "offset": 7644768,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ったく、そろいもそろって"
    },
    {
      "item_id": "cluster_55_east_city:0074A67E",
      "offset": 7644798,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "考えもなしに"
    },
    {
      "item_id": "cluster_55_east_city:0074A690",
      "offset": 7644816,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "遺跡をさまよってるのかよ"
    },
    {
      "item_id": "cluster_55_east_city:0074A6C6",
      "offset": 7644870,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…そういう"
    },
    {
      "item_id": "cluster_55_east_city:0074A6D6",
      "offset": 7644886,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐は"
    },
    {
      "item_id": "cluster_55_east_city:0074A6EE",
      "offset": 7644910,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうなのかね？"
    },
    {
      "item_id": "cluster_55_east_city:0074A732",
      "offset": 7644978,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレ様がそんなこと"
    },
    {
      "item_id": "cluster_55_east_city:0074A74A",
      "offset": 7645002,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "分かるわけねぇだろうが"
    },
    {
      "item_id": "cluster_55_east_city:0074A77E",
      "offset": 7645054,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなこと胸はって"
    },
    {
      "item_id": "cluster_55_east_city:0074A796",
      "offset": 7645078,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言わないでください"
    },
    {
      "item_id": "cluster_55_east_city:0074A7B4",
      "offset": 7645108,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…まったくこの人たちは"
    },
    {
      "item_id": "cluster_55_east_city:0074A7EE",
      "offset": 7645166,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっべ！"
    },
    {
      "item_id": "cluster_55_east_city:0074A83C",
      "offset": 7645244,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…なにしてんだ、ありゃ？"
    },
    {
      "item_id": "cluster_55_east_city:0074A86C",
      "offset": 7645292,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだか"
    },
    {
      "item_id": "cluster_55_east_city:0074A87A",
      "offset": 7645306,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あわててるみたいですけど"
    },
    {
      "item_id": "cluster_55_east_city:0074A8CC",
      "offset": 7645388,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ふっ…さすがだな"
    },
    {
      "item_id": "cluster_55_east_city:0074A8E2",
      "offset": 7645410,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よくぞ俺が犯人だと見破った！"
    },
    {
      "item_id": "cluster_55_east_city:0074A904",
      "offset": 7645444,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さすが鋼の錬金術師"
    },
    {
      "item_id": "cluster_55_east_city:0074A940",
      "offset": 7645504,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どういうことだ？"
    },
    {
      "item_id": "cluster_55_east_city:0074A968",
      "offset": 7645544,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうか、貴様が"
    },
    {
      "item_id": "cluster_55_east_city:0074A97C",
      "offset": 7645564,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダイムラーをやった犯人か"
    },
    {
      "item_id": "cluster_55_east_city:0074A9AC",
      "offset": 7645612,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにぃ！？"
    },
    {
      "item_id": "cluster_55_east_city:0074A9BC",
      "offset": 7645628,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…知ってて"
    },
    {
      "item_id": "cluster_55_east_city:0074A9CC",
      "offset": 7645644,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "追ってきたんじゃないのか？"
    },
    {
      "item_id": "cluster_55_east_city:0074A9FE",
      "offset": 7645694,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "知らんな"
    },
    {
      "item_id": "cluster_55_east_city:0074AA0C",
      "offset": 7645708,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、手間が省けた"
    },
    {
      "item_id": "cluster_55_east_city:0074AA24",
      "offset": 7645732,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "感謝しよう"
    },
    {
      "item_id": "cluster_55_east_city:0074AA4A",
      "offset": 7645770,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ぐあーー！"
    },
    {
      "item_id": "cluster_55_east_city:0074AA5A",
      "offset": 7645786,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "またケイトにバカにされる！"
    },
    {
      "item_id": "cluster_55_east_city:0074AA7A",
      "offset": 7645818,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "単細胞バカって言われるー！"
    },
    {
      "item_id": "cluster_55_east_city:0074AAAC",
      "offset": 7645868,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…愚かね"
    },
    {
      "item_id": "cluster_55_east_city:0074AAE8",
      "offset": 7645928,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ところで、向こうはエドのこと"
    },
    {
      "item_id": "cluster_55_east_city:0074AB0A",
      "offset": 7645962,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "知ってるみたいだけど"
    },
    {
      "item_id": "cluster_55_east_city:0074AB24",
      "offset": 7645988,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "知り合いですか？"
    },
    {
      "item_id": "cluster_55_east_city:0074AB5E",
      "offset": 7646046,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんな筋肉バカに"
    },
    {
      "item_id": "cluster_55_east_city:0074AB74",
      "offset": 7646068,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "知り合いなんかいるかよ"
    },
    {
      "item_id": "cluster_55_east_city:0074ABC4",
      "offset": 7646148,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにか言ったかね、"
    },
    {
      "item_id": "cluster_55_east_city:0074ABDC",
      "offset": 7646172,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドワード・エルリック？"
    },
    {
      "item_id": "cluster_55_east_city:0074ABFA",
      "offset": 7646202,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "筋肉がどうとか…"
