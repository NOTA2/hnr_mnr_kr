{
  "items": [
    {
      "item_id": "cluster_62_central:00761518",
      "offset": 7738648,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私、美人だから"
    },
    {
      "item_id": "cluster_62_central:0076152C",
      "offset": 7738668,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっとさらわれてしまうわ"
    },
    {
      "item_id": "cluster_62_central:00761564",
      "offset": 7738724,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人質が私だったらって"
    },
    {
      "item_id": "cluster_62_central:0076157E",
      "offset": 7738750,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "考えると…"
    },
    {
      "item_id": "cluster_62_central:0076158E",
      "offset": 7738766,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああ、心臓が止まってしまうわ"
    },
    {
      "item_id": "cluster_62_central:00761642",
      "offset": 7738946,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…助けていただいて"
    },
    {
      "item_id": "cluster_62_central:0076165A",
      "offset": 7738970,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ありがとうございます"
    },
    {
      "item_id": "cluster_62_central:00761680",
      "offset": 7739008,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケガはしてない？"
    },
    {
      "item_id": "cluster_62_central:007616A2",
      "offset": 7739042,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私は大丈夫です。"
    },
    {
      "item_id": "cluster_62_central:007616B8",
      "offset": 7739064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、あなたはさっきの戦いで"
    },
    {
      "item_id": "cluster_62_central:007616DA",
      "offset": 7739098,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "傷だらけになっています"
    },
    {
      "item_id": "cluster_62_central:0076174E",
      "offset": 7739214,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あんた錬金術師なのか？"
    },
    {
      "item_id": "cluster_62_central:00761782",
      "offset": 7739266,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…集中しますから"
    },
    {
      "item_id": "cluster_62_central:00761798",
      "offset": 7739288,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "静かに…"
    },
    {
      "item_id": "cluster_62_central:00761850",
      "offset": 7739472,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "治癒の錬金術師…"
    },
    {
      "item_id": "cluster_62_central:00761866",
      "offset": 7739494,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あんた、治癒錬成できるのか？"
    },
    {
      "item_id": "cluster_62_central:00761892",
      "offset": 7739538,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あまりひどくないものなら…"
    },
    {
      "item_id": "cluster_62_central:007618B2",
      "offset": 7739570,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "治癒錬成でできるものには"
    },
    {
      "item_id": "cluster_62_central:007618D0",
      "offset": 7739600,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "限界があります"
    },
    {
      "item_id": "cluster_62_central:007618F2",
      "offset": 7739634,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そりゃそうだ"
    },
    {
      "item_id": "cluster_62_central:0076190E",
      "offset": 7739662,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ところで悪人たちはどちらに？"
    },
    {
      "item_id": "cluster_62_central:0076193E",
      "offset": 7739710,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ロープでぐるぐる巻きにして"
    },
    {
      "item_id": "cluster_62_central:0076195E",
      "offset": 7739742,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "車掌に引き渡したから"
    },
    {
      "item_id": "cluster_62_central:00761978",
      "offset": 7739768,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "安心していいよ"
    },
    {
      "item_id": "cluster_62_central:0076199A",
      "offset": 7739802,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボスは人間じゃなかったけどな"
    },
    {
      "item_id": "cluster_62_central:007619D2",
      "offset": 7739858,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人質になるなんて初めての事で"
    },
    {
      "item_id": "cluster_62_central:007619F4",
      "offset": 7739892,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "とても緊張してしまいました"
    },
    {
      "item_id": "cluster_62_central:00761A26",
      "offset": 7739942,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "へぇ、怖くなかったのか？"
    },
    {
      "item_id": "cluster_62_central:00761A5A",
      "offset": 7739994,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっと誰かが助けてくれるって"
    },
    {
      "item_id": "cluster_62_central:00761A7C",
      "offset": 7740028,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "信じていましたから"
    },
    {
      "item_id": "cluster_62_central:00761AA2",
      "offset": 7740066,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あはは、大物だね！"
    },
    {
      "item_id": "cluster_62_central:00761AC6",
      "offset": 7740102,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アルフォンス・エルリックです"
    },
    {
      "item_id": "cluster_62_central:00761AF2",
      "offset": 7740146,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレはエドワード・エルリック"
    },
    {
      "item_id": "cluster_62_central:00761B14",
      "offset": 7740180,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の錬金術師だ"
    },
    {
      "item_id": "cluster_62_central:00761B36",
      "offset": 7740214,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私はコーニッシュ・ロイスです"
    },
    {
      "item_id": "cluster_62_central:00761BA8",
      "offset": 7740328,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドワードさんは"
    },
    {
      "item_id": "cluster_62_central:00761BBE",
      "offset": 7740350,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師なのですか？"
    },
    {
      "item_id": "cluster_62_central:00761C1E",
      "offset": 7740446,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私はこれから国家錬金術師に"
    },
    {
      "item_id": "cluster_62_central:00761C3E",
      "offset": 7740478,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なるために試験を受けるんです"
    },
    {
      "item_id": "cluster_62_central:00761C72",
      "offset": 7740530,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんでまた？"
    },
    {
      "item_id": "cluster_62_central:00761C84",
      "offset": 7740548,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師でなくても"
    },
    {
      "item_id": "cluster_62_central:00761CA0",
      "offset": 7740576,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいんじゃないの"
    },
    {
      "item_id": "cluster_62_central:00761CC8",
      "offset": 7740616,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師になれば"
    },
    {
      "item_id": "cluster_62_central:00761CE2",
      "offset": 7740642,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私の治癒錬成で、もっと多くの"
    },
    {
      "item_id": "cluster_62_central:00761D04",
      "offset": 7740676,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人を助けられると思って"
    },
    {
      "item_id": "cluster_62_central:00761D32",
      "offset": 7740722,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "偉いねぇ"
    },
    {
      "item_id": "cluster_62_central:00761D4E",
      "offset": 7740750,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんな…エドワードさんの方が"
    },
    {
      "item_id": "cluster_62_central:00761D70",
      "offset": 7740784,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まだお小さいのに大衆のために"
    },
    {
      "item_id": "cluster_62_central:00761D92",
      "offset": 7740818,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "働いていらっしゃるわ"
    },
    {
      "item_id": "cluster_62_central:00761DBE",
      "offset": 7740862,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰がウルトラ豆粒錬金術師だ！"
    },
    {
      "item_id": "cluster_62_central:00761DE0",
      "offset": 7740896,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これでも、１５歳だぁ"
    },
    {
      "item_id": "cluster_62_central:00761E0C",
      "offset": 7740940,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あら、ごめんなさい。"
    },
    {
      "item_id": "cluster_62_central:00761E32",
      "offset": 7740978,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "１５歳ならまだ成長期ですもの"
    },
    {
      "item_id": "cluster_62_central:00761E54",
      "offset": 7741012,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっと、もっと大きくなれるわ"
    },
    {
      "item_id": "cluster_62_central:00761E88",
      "offset": 7741064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お気遣いありがとッ！"
    },
    {
      "item_id": "cluster_62_central:00761EAE",
      "offset": 7741102,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "じゃ、あんたも"
    },
    {
      "item_id": "cluster_62_central:00761EC2",
      "offset": 7741122,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セントラルシティに行くのか？"
    },
    {
      "item_id": "cluster_62_central:00761EF6",
      "offset": 7741174,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドワードさんたちも"
    },
    {
      "item_id": "cluster_62_central:00761F10",
      "offset": 7741200,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セントラルシティへ"
    },
    {
      "item_id": "cluster_62_central:00761F28",
      "offset": 7741224,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行かれるんですね"
    },
    {
      "item_id": "cluster_62_central:00761F50",
      "offset": 7741264,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "調べたい事もあるし"
    },
    {
      "item_id": "cluster_62_central:00761F68",
      "offset": 7741288,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この事件の報告もしないと"
    },
    {
      "item_id": "cluster_62_central:00761F86",
      "offset": 7741318,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いけなくなりましたから"
    },
    {
      "item_id": "cluster_62_central:00761FB0",
      "offset": 7741360,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私、決めました！"
    },
    {
      "item_id": "cluster_62_central:00761FC6",
      "offset": 7741382,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お二人と行動を共にいたします"
    },
    {
      "item_id": "cluster_62_central:00762018",
      "offset": 7741464,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "実は私、家から出たことは"
    },
    {
      "item_id": "cluster_62_central:00762036",
      "offset": 7741494,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ほとんどないので"
    },
    {
      "item_id": "cluster_62_central:0076204C",
      "offset": 7741516,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この一人旅も心細かったのです"
    },
    {
      "item_id": "cluster_62_central:00762080",
      "offset": 7741568,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "旅は道連れっていうし。"
    },
    {
      "item_id": "cluster_62_central:0076209C",
      "offset": 7741596,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "良いよね、兄さん"
    },
    {
      "item_id": "cluster_62_central:007620BA",
      "offset": 7741626,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ま、そういうことならな。"
    },
    {
      "item_id": "cluster_62_central:007620D8",
      "offset": 7741656,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ただ、ひとつだけ条件がある！"
    },
    {
      "item_id": "cluster_62_central:00762110",
      "offset": 7741712,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "な、なんでしょうか…？"
    },
    {
      "item_id": "cluster_62_central:0076213C",
      "offset": 7741756,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その堅っ苦しいしゃべり方は"
    },
    {
      "item_id": "cluster_62_central:0076215C",
      "offset": 7741788,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やめてくれ"
    },
    {
      "item_id": "cluster_62_central:00762182",
      "offset": 7741826,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "はい、わかりました！"
    },
    {
      "item_id": "cluster_62_central:0076219C",
      "offset": 7741852,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私の事はコニィと呼んで下さい"
    },
    {
      "item_id": "cluster_62_central:007621BE",
      "offset": 7741886,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よろしくお願いしますね！"
    },
    {
      "item_id": "cluster_62_central:007621EE",
      "offset": 7741934,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクのことはアルでいいよ"
    },
    {
      "item_id": "cluster_62_central:00762214",
      "offset": 7741972,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレはエドって呼んでくれ。"
    },
    {
      "item_id": "cluster_62_central:00762234",
      "offset": 7742004,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よろしくな"
    },
    {
      "item_id": "cluster_62_central:0076224E",
      "offset": 7742030,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィはなんで錬金術を？"
    },
    {
      "item_id": "cluster_62_central:0076227E",
      "offset": 7742078,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄の遺志を継ぐためです"
    },
    {
      "item_id": "cluster_62_central:007622AC",
      "offset": 7742124,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お兄さん…いたの？"
    },
    {
      "item_id": "cluster_62_central:007622D2",
      "offset": 7742162,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師だった兄は"
    },
    {
      "item_id": "cluster_62_central:007622EE",
      "offset": 7742190,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イシュヴァールの反乱で"
    },
    {
      "item_id": "cluster_62_central:00762310",
      "offset": 7742224,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "戦死した…らしいです"
    },
    {
      "item_id": "cluster_62_central:00762336",
      "offset": 7742262,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "らしいって？"
    },
    {
      "item_id": "cluster_62_central:00762356",
      "offset": 7742294,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そう伝えられただけで、"
    },
    {
      "item_id": "cluster_62_central:00762372",
      "offset": 7742322,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "形見の品も何も…"
    },
    {
      "item_id": "cluster_62_central:0076239A",
      "offset": 7742362,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうなんだ。"
    },
    {
      "item_id": "cluster_62_central:007623AC",
      "offset": 7742380,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…そんなこと聞いてごめん"
    },
    {
      "item_id": "cluster_62_central:007623D8",
      "offset": 7742424,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ、気にしないでください"
    },
    {
      "item_id": "cluster_62_central:00762400",
      "offset": 7742464,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それに亡くなった証が"
    },
    {
      "item_id": "cluster_62_central:0076241A",
      "offset": 7742490,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "無いってことは、"
    },
    {
      "item_id": "cluster_62_central:00762430",
      "offset": 7742512,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もしかしたら…ってことも"
    },
    {
      "item_id": "cluster_62_central:00762460",
      "offset": 7742560,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お兄さんって、"
    },
    {
      "item_id": "cluster_62_central:00762474",
      "offset": 7742580,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どんな人？"
    },
    {
      "item_id": "cluster_62_central:00762492",
      "offset": 7742610,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄は「錬金術師よ"
    },
    {
      "item_id": "cluster_62_central:007624A8",
      "offset": 7742632,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大衆のためにあれ」という"
    },
    {
      "item_id": "cluster_62_central:007624C6",
      "offset": 7742662,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言葉を大切にしていました"
    },
    {
      "item_id": "cluster_62_central:007624EE",
      "offset": 7742702,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そして、多くの人の"
    },
    {
      "item_id": "cluster_62_central:00762506",
      "offset": 7742726,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "役に立つため"
    },
    {
      "item_id": "cluster_62_central:00762518",
