{
  "items": [
    {
      "item_id": "cluster_60_military:00759050",
      "offset": 7704656,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早くこっちに来い！"
    },
    {
      "item_id": "cluster_60_military:0075915E",
      "offset": 7704926,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今のは、やばかった…"
    },
    {
      "item_id": "cluster_60_military:00759184",
      "offset": 7704964,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "つうかよ、"
    },
    {
      "item_id": "cluster_60_military:00759194",
      "offset": 7704980,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前ら錬金術師だろ？"
    },
    {
      "item_id": "cluster_60_military:007591FE",
      "offset": 7705086,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…？　今度はなんだ！？"
    },
    {
      "item_id": "cluster_60_military:00759262",
      "offset": 7705186,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ウソだろ、オイ！"
    },
    {
      "item_id": "cluster_60_military:007593CC",
      "offset": 7705548,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐！"
    },
    {
      "item_id": "cluster_60_military:007593F6",
      "offset": 7705590,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エド…まだ何か用か？"
    },
    {
      "item_id": "cluster_60_military:00759422",
      "offset": 7705634,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ったく。"
    },
    {
      "item_id": "cluster_60_military:00759432",
      "offset": 7705650,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ひとを子供扱いばっかして、"
    },
    {
      "item_id": "cluster_60_military:00759452",
      "offset": 7705682,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どっちが子供だよ"
    },
    {
      "item_id": "cluster_60_military:00759472",
      "offset": 7705714,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どう転んだって、"
    },
    {
      "item_id": "cluster_60_military:00759488",
      "offset": 7705736,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーを一人で倒せるなんて"
    },
    {
      "item_id": "cluster_60_military:007594AA",
      "offset": 7705770,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中佐だって思ってないだろ？"
    },
    {
      "item_id": "cluster_60_military:007594DC",
      "offset": 7705820,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マスタング大佐もさ、"
    },
    {
      "item_id": "cluster_60_military:007594F6",
      "offset": 7705846,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "仲間を疑っても"
    },
    {
      "item_id": "cluster_60_military:0075950A",
      "offset": 7705866,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しかたないと思わない？"
    },
    {
      "item_id": "cluster_60_military:0075953E",
      "offset": 7705918,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…そうだな。"
    },
    {
      "item_id": "cluster_60_military:00759550",
      "offset": 7705936,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よもや年下にさとされることに"
    },
    {
      "item_id": "cluster_60_military:00759572",
      "offset": 7705970,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なろうとは思わなかった"
    },
    {
      "item_id": "cluster_60_military:0075959E",
      "offset": 7706014,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…マーティンス中佐、"
    },
    {
      "item_id": "cluster_60_military:007595B8",
      "offset": 7706040,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "疑って、すまなかった"
    },
    {
      "item_id": "cluster_60_military:007595E4",
      "offset": 7706084,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いや…オレ様の方こそ、"
    },
    {
      "item_id": "cluster_60_military:00759600",
      "offset": 7706112,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "隠し事をしていたのは事実だ…"
    },
    {
      "item_id": "cluster_60_military:00759622",
      "offset": 7706146,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "疑われても仕方なかったさ"
    },
    {
      "item_id": "cluster_60_military:00759676",
      "offset": 7706230,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まさに雨降って地固まる"
    },
    {
      "item_id": "cluster_60_military:00759692",
      "offset": 7706258,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "というヤツですな！"
    },
    {
      "item_id": "cluster_60_military:007596AA",
      "offset": 7706282,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我輩感動！"
    },
    {
      "item_id": "cluster_60_military:007596C4",
      "offset": 7706308,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドワード・エルリック、"
    },
    {
      "item_id": "cluster_60_military:007596E2",
      "offset": 7706338,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さすが我輩が惚れ込んだ男だ！"
    },
    {
      "item_id": "cluster_60_military:00759716",
      "offset": 7706390,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "少佐はいいんだって！"
    },
    {
      "item_id": "cluster_60_military:00759730",
      "offset": 7706416,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だぁ～っ、離れろ～！"
    },
    {
      "item_id": "cluster_60_military:0075974A",
      "offset": 7706442,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アル、助けてくれ～"
    },
    {
      "item_id": "cluster_60_military:00759774",
      "offset": 7706484,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、"
    },
    {
      "item_id": "cluster_60_military:00759782",
      "offset": 7706498,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たまにいいことをしたんだから"
    },
    {
      "item_id": "cluster_60_military:007597A4",
      "offset": 7706532,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ありがたく抱きしめられれば？"
    },
    {
      "item_id": "cluster_60_military:007598CE",
      "offset": 7706830,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーの野郎は"
    },
    {
      "item_id": "cluster_60_military:007598E4",
      "offset": 7706852,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう目の前だ。"
    },
    {
      "item_id": "cluster_60_military:007598F8",
      "offset": 7706872,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "後戻りしてるヒマはねぇぞ！"
    },
    {
      "item_id": "cluster_60_military:007599E6",
      "offset": 7707110,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "前に来たときは"
    },
    {
      "item_id": "cluster_60_military:007599FA",
      "offset": 7707130,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここで落とされたんだっけ…"
    },
    {
      "item_id": "cluster_60_military:00759A26",
      "offset": 7707174,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それでマーティンス中佐を"
    },
    {
      "item_id": "cluster_60_military:00759A44",
      "offset": 7707204,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "疑ったり、仲直りしたり…"
    },
    {
      "item_id": "cluster_60_military:00759A74",
      "offset": 7707252,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "つい、この間のことみたいだな"
    },
    {
      "item_id": "cluster_60_military:00759AA8",
      "offset": 7707304,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "つい、この間だよ、兄さん"
    },
    {
      "item_id": "cluster_60_military:00759AD4",
      "offset": 7707348,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "え、そうか？"
    },
    {
      "item_id": "cluster_60_military:00759AF2",
      "offset": 7707378,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よし、ここは一発！"
    },
    {
      "item_id": "cluster_60_military:00759B0A",
      "offset": 7707402,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ドハデに錬成してやるか！"
    },
    {
      "item_id": "cluster_60_military:00759B36",
      "offset": 7707446,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "石の６－６のカードだ！"
    },
    {
      "item_id": "cluster_60_military:00759B52",
      "offset": 7707474,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それで橋を作ってやる！"
    },
    {
      "item_id": "cluster_60_military:00759B78",
      "offset": 7707512,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "準備はいいか？"
    },
    {
      "item_id": "cluster_60_military:00759C14",
      "offset": 7707668,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いくぞ！"
    },
    {
      "item_id": "cluster_60_military:00759C86",
      "offset": 7707782,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "けど、こんなとこまで"
    },
    {
      "item_id": "cluster_60_military:00759CA0",
      "offset": 7707808,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "花つみに来させられて"
    },
    {
      "item_id": "cluster_60_military:00759CBA",
      "offset": 7707834,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレたち一体なんなんだ…？"
    },
    {
      "item_id": "cluster_60_military:00759CEC",
      "offset": 7707884,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "グチらない、グチらない"
    },
    {
      "item_id": "cluster_60_military:00759D2A",
      "offset": 7707946,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "このカードじゃダメだな。"
    },
    {
      "item_id": "cluster_60_military:00759D48",
      "offset": 7707976,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここに橋を作るには"
    },
    {
      "item_id": "cluster_60_military:00759D60",
      "offset": 7708000,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "石の６－６のカードが必要だ"
    },
    {
      "item_id": "cluster_60_military:00759DD8",
      "offset": 7708120,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "石の６－６だぞ"
    },
    {
      "item_id": "cluster_61_military:0075ACAE",
      "offset": 7711918,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我が城でずいぶんと"
    },
    {
      "item_id": "cluster_61_military:0075ACC6",
      "offset": 7711942,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "騒々しいマネをしてくれるな"
    },
    {
      "item_id": "cluster_61_military:0075AD90",
      "offset": 7712144,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカー！"
    },
    {
      "item_id": "cluster_61_military:0075ADA0",
      "offset": 7712160,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ついに親玉が登場ってわけか"
    },
    {
      "item_id": "cluster_61_military:0075ADCA",
      "offset": 7712202,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいか、この前の借り"
    },
    {
      "item_id": "cluster_61_military:0075ADE4",
      "offset": 7712228,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しっかり返させて"
    },
    {
      "item_id": "cluster_61_military:0075ADFA",
      "offset": 7712250,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もらうからな！"
    },
    {
      "item_id": "cluster_61_military:0075AE1E",
      "offset": 7712286,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それは楽しみだ"
    },
    {
      "item_id": "cluster_61_military:0075AE32",
      "offset": 7712306,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが…できるかな？"
    },
    {
      "item_id": "cluster_61_military:0075AE6C",
      "offset": 7712364,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それは！"
    },
    {
      "item_id": "cluster_61_military:0075AE7A",
      "offset": 7712378,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "賢者の石…か"
    },
    {
      "item_id": "cluster_61_military:0075AE98",
      "offset": 7712408,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだと！？"
    },
    {
      "item_id": "cluster_61_military:0075AEAA",
      "offset": 7712426,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダイムラーから奪ったのは"
    },
    {
      "item_id": "cluster_61_military:0075AEC8",
      "offset": 7712456,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "賢者の石だったというのか？"
    },
    {
      "item_id": "cluster_61_military:0075AEFA",
      "offset": 7712506,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "賢者の石…"
    },
    {
      "item_id": "cluster_61_military:0075AF0A",
      "offset": 7712522,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…それほどにまで欲しいか"
    },
    {
      "item_id": "cluster_61_military:0075AF28",
      "offset": 7712552,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その力を欲し、なんとする"
    },
    {
      "item_id": "cluster_61_military:0075AF72",
      "offset": 7712626,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "元の身体に戻るためだ"
    },
    {
      "item_id": "cluster_61_military:0075AF98",
      "offset": 7712664,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、それが賢者の石なら"
    },
    {
      "item_id": "cluster_61_military:0075AFB8",
      "offset": 7712696,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクらに渡して欲しいんだ"
    },
    {
      "item_id": "cluster_61_military:0075AFE2",
      "offset": 7712738,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なるほど、機械鎧か。"
    },
    {
      "item_id": "cluster_61_military:0075AFFC",
      "offset": 7712764,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それが鋼の錬金術師と"
    },
    {
      "item_id": "cluster_61_military:0075B016",
      "offset": 7712790,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "呼ばれるゆえんか"
    },
    {
      "item_id": "cluster_61_military:0075B036",
      "offset": 7712822,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、元の身体に戻るなどと"
    },
    {
      "item_id": "cluster_61_military:0075B056",
      "offset": 7712854,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それが禁断の人体錬成だと"
    },
    {
      "item_id": "cluster_61_military:0075B074",
      "offset": 7712884,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "知っているのか？"
    },
    {
      "item_id": "cluster_61_military:0075B0A2",
      "offset": 7712930,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "残念ながら、"
    },
    {
      "item_id": "cluster_61_military:0075B0B4",
      "offset": 7712948,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人体錬成に関しては身をもって"
    },
    {
      "item_id": "cluster_61_military:0075B0D6",
      "offset": 7712982,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よーく知ってるんでね"
    },
    {
      "item_id": "cluster_61_military:0075B0FA",
      "offset": 7713018,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "てめぇに"
    },
    {
      "item_id": "cluster_61_military:0075B108",
      "offset": 7713032,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いちいち言われなくても"
    },
    {
      "item_id": "cluster_61_military:0075B124",
      "offset": 7713060,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わかってるさ"
    },
    {
      "item_id": "cluster_61_military:0075B148",
      "offset": 7713096,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "身をもって…だと？"
    },
    {
      "item_id": "cluster_61_military:0075B16C",
      "offset": 7713132,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…まさか"
    },
    {
      "item_id": "cluster_61_military:0075B18C",
      "offset": 7713164,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気づいたかよ。"
    },
    {
      "item_id": "cluster_61_military:0075B1A0",
      "offset": 7713184,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そのまさかさ！"
    },
    {
      "item_id": "cluster_61_military:0075B1C6",
      "offset": 7713222,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうか！"
    },
    {
      "item_id": "cluster_61_military:0075B1D4",
      "offset": 7713236,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "禁断の人体錬成に手を染め、"
    },
    {
      "item_id": "cluster_61_military:0075B1F4",
      "offset": 7713268,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "手足を失ったかっ！"
    },
    {
      "item_id": "cluster_61_military:0075B236",
      "offset": 7713334,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクらは母さんを"
    },
    {
      "item_id": "cluster_61_military:0075B24C",
      "offset": 7713356,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "生き返らせようと…"
    },
    {
      "item_id": "cluster_61_military:0075B26C",
      "offset": 7713388,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わかったら、さっさと"
    },
    {
      "item_id": "cluster_61_military:0075B286",
      "offset": 7713414,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "賢者の石をよこしな！"
    },
    {
      "item_id": "cluster_61_military:0075B2B2",
      "offset": 7713458,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そしたら、今までのこと"
    },
    {
      "item_id": "cluster_61_military:0075B2CE",
      "offset": 7713486,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "目をつぶってやってもいいぜ？"
    },
    {
