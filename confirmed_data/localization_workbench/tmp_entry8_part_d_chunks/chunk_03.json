{
  "items": [
    {
      "item_id": "cluster_55_east_city:0074D27C",
      "offset": 7656060,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しーっ！"
    },
    {
      "item_id": "cluster_55_east_city:0074D28A",
      "offset": 7656074,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、声がおっきいよ！"
    },
    {
      "item_id": "cluster_55_east_city:0074D2A8",
      "offset": 7656104,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィに聞こえちゃうよ"
    },
    {
      "item_id": "cluster_55_east_city:0074D2DC",
      "offset": 7656156,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私も考えてはいたが、"
    },
    {
      "item_id": "cluster_55_east_city:0074D2F6",
      "offset": 7656182,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あくまでも可能性にすぎん"
    },
    {
      "item_id": "cluster_55_east_city:0074D314",
      "offset": 7656212,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まだ彼女には話さん方がいい"
    },
    {
      "item_id": "cluster_55_east_city:0074D350",
      "offset": 7656272,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マスタング大佐！"
    },
    {
      "item_id": "cluster_55_east_city:0074D366",
      "offset": 7656294,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中央司令部と連絡が"
    },
    {
      "item_id": "cluster_55_east_city:0074D37E",
      "offset": 7656318,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "つきそうだということです"
    },
    {
      "item_id": "cluster_55_east_city:0074D3CC",
      "offset": 7656396,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ、ああ"
    },
    {
      "item_id": "cluster_55_east_city:0074D3F4",
      "offset": 7656436,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…鋼の、わかってるな？"
    },
    {
      "item_id": "cluster_55_east_city:0074D422",
      "offset": 7656482,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いちいち念を"
    },
    {
      "item_id": "cluster_55_east_city:0074D434",
      "offset": 7656500,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "押さなくていいって"
    },
    {
      "item_id": "cluster_55_east_city:0074D44C",
      "offset": 7656524,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ガキじゃねーんだからさ"
    },
    {
      "item_id": "cluster_55_east_city:0074D480",
      "offset": 7656576,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ねえ、エド"
    },
    {
      "item_id": "cluster_55_east_city:0074D490",
      "offset": 7656592,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっきから何を話してたの？"
    },
    {
      "item_id": "cluster_55_east_city:0074D4C8",
      "offset": 7656648,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍の機密、機密"
    },
    {
      "item_id": "cluster_55_east_city:0074D4F4",
      "offset": 7656692,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私だけ仲間はずれ？"
    },
    {
      "item_id": "cluster_55_east_city:0074D50C",
      "offset": 7656716,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなヒドイ…"
    },
    {
      "item_id": "cluster_55_east_city:0074D538",
      "offset": 7656760,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん！"
    },
    {
      "item_id": "cluster_55_east_city:0074D546",
      "offset": 7656774,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんな言い方しなくたって"
    },
    {
      "item_id": "cluster_55_east_city:0074D57C",
      "offset": 7656828,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ホントはね、"
    },
    {
      "item_id": "cluster_55_east_city:0074D58E",
      "offset": 7656846,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中央に帰ったら、おいしいモノ"
    },
    {
      "item_id": "cluster_55_east_city:0074D5B0",
      "offset": 7656880,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "食べたいとか、そういう…"
    },
    {
      "item_id": "cluster_55_east_city:0074D5E0",
      "offset": 7656928,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…アルってウソが"
    },
    {
      "item_id": "cluster_55_east_city:0074D5F6",
      "offset": 7656950,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "下手ですね"
    },
    {
      "item_id": "cluster_55_east_city:0074D606",
      "offset": 7656966,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すぐ表情に出るから"
    },
    {
      "item_id": "cluster_55_east_city:0074D636",
      "offset": 7657014,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ひょ、表情って…？"
    },
    {
      "item_id": "cluster_55_east_city:0074D64E",
      "offset": 7657038,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクの？"
    },
    {
      "item_id": "cluster_55_east_city:0074D66C",
      "offset": 7657068,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、いいんです"
    },
    {
      "item_id": "cluster_55_east_city:0074D682",
      "offset": 7657090,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一般人には話せないことって"
    },
    {
      "item_id": "cluster_55_east_city:0074D6A2",
      "offset": 7657122,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっとありますよね"
    },
    {
      "item_id": "cluster_55_east_city:0074D6D2",
      "offset": 7657170,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…コニィ"
    },
    {
      "item_id": "cluster_55_east_city:0074D6F4",
      "offset": 7657204,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、私も絶対、"
    },
    {
      "item_id": "cluster_55_east_city:0074D70C",
      "offset": 7657228,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師になるんです"
    },
    {
      "item_id": "cluster_55_east_city:0074D72A",
      "offset": 7657258,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "絶対です"
    },
    {
      "item_id": "cluster_55_east_city:0074D77A",
      "offset": 7657338,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いったんイーストシティに戻る"
    },
    {
      "item_id": "cluster_55_east_city:0074D7CC",
      "offset": 7657420,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーは追わなくていいの？"
    },
    {
      "item_id": "cluster_55_east_city:0074D7EE",
      "offset": 7657454,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "このまま逃がしちゃう気かよ"
    },
    {
      "item_id": "cluster_55_east_city:0074D826",
      "offset": 7657510,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まあ、待て"
    },
    {
      "item_id": "cluster_55_east_city:0074D836",
      "offset": 7657526,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "追うにしても態勢の立て直しだ"
    },
    {
      "item_id": "cluster_55_east_city:0074D858",
      "offset": 7657560,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "情報の分析も必要だしな"
    },
    {
      "item_id": "cluster_55_east_city:0074D964",
      "offset": 7657828,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ホント、逃げ足だけは"
    },
    {
      "item_id": "cluster_55_east_city:0074D97E",
      "offset": 7657854,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "速い奴だな"
    },
    {
      "item_id": "cluster_55_east_city:0074D9A0",
      "offset": 7657888,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もはや遺跡の外は"
    },
    {
      "item_id": "cluster_55_east_city:0074D9B6",
      "offset": 7657910,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兵が固めているはず"
    },
    {
      "item_id": "cluster_55_east_city:0074D9CE",
      "offset": 7657934,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "逃げられはしない"
    },
    {
      "item_id": "cluster_55_east_city:0074D9FC",
      "offset": 7657980,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "へえ。手回しいいんだ。"
    },
    {
      "item_id": "cluster_55_east_city:0074DA32",
      "offset": 7658034,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…待った"
    },
    {
      "item_id": "cluster_55_east_city:0074DA40",
      "offset": 7658048,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あそこに誰かいる"
    },
    {
      "item_id": "cluster_55_east_city:0074DA6E",
      "offset": 7658094,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人…か？"
    },
    {
      "item_id": "cluster_55_east_city:0074DA7C",
      "offset": 7658108,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰か倒れているようだぜ？"
    },
    {
      "item_id": "cluster_55_east_city:0074DAB2",
      "offset": 7658162,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんなところで"
    },
    {
      "item_id": "cluster_55_east_city:0074DAC6",
      "offset": 7658182,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "倒れている可能性のある"
    },
    {
      "item_id": "cluster_55_east_city:0074DAE2",
      "offset": 7658210,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人間といえば…"
    },
    {
      "item_id": "cluster_55_east_city:0074DB0E",
      "offset": 7658254,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうやらお互い考えたことは"
    },
    {
      "item_id": "cluster_55_east_city:0074DB2E",
      "offset": 7658286,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "同じようだな"
    },
    {
      "item_id": "cluster_55_east_city:0074DB58",
      "offset": 7658328,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐、"
    },
    {
      "item_id": "cluster_55_east_city:0074DB70",
      "offset": 7658352,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "君と同じというのが、"
    },
    {
      "item_id": "cluster_55_east_city:0074DB8A",
      "offset": 7658378,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いささか気に入らんがな"
    },
    {
      "item_id": "cluster_55_east_city:0074DC18",
      "offset": 7658520,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…死んでる"
    },
    {
      "item_id": "cluster_55_east_city:0074DC34",
      "offset": 7658548,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ホークアイ中尉、"
    },
    {
      "item_id": "cluster_55_east_city:0074DC4A",
      "offset": 7658570,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "報告は正確に頼む"
    },
    {
      "item_id": "cluster_55_east_city:0074DC76",
      "offset": 7658614,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダイムラーは…"
    },
    {
      "item_id": "cluster_55_east_city:0074DC96",
      "offset": 7658646,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いえ、殺害されました"
    },
    {
      "item_id": "cluster_55_east_city:0074DCC2",
      "offset": 7658690,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…いったい誰が"
    },
    {
      "item_id": "cluster_55_east_city:0074DD0C",
      "offset": 7658764,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アル、どうした？"
    },
    {
      "item_id": "cluster_55_east_city:0074DD34",
      "offset": 7658804,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダイムラーって"
    },
    {
      "item_id": "cluster_55_east_city:0074DD48",
      "offset": 7658824,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たしか…黒いカバンを"
    },
    {
      "item_id": "cluster_55_east_city:0074DD62",
      "offset": 7658850,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "持ってなかった？"
    },
    {
      "item_id": "cluster_55_east_city:0074DD90",
      "offset": 7658896,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐、黒いカバンって"
    },
    {
      "item_id": "cluster_55_east_city:0074DDAA",
      "offset": 7658922,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "覚えてる？"
    },
    {
      "item_id": "cluster_55_east_city:0074DDD2",
      "offset": 7658962,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん。ダイムラーが屋敷から"
    },
    {
      "item_id": "cluster_55_east_city:0074DDF4",
      "offset": 7658996,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "逃げ出すときに"
    },
    {
      "item_id": "cluster_55_east_city:0074DE08",
      "offset": 7659016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "カバンを持っていたんだよ"
    },
    {
      "item_id": "cluster_55_east_city:0074DE38",
      "offset": 7659064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…それがなくなっている"
    },
    {
      "item_id": "cluster_55_east_city:0074DE54",
      "offset": 7659092,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "というわけか"
    },
    {
      "item_id": "cluster_55_east_city:0074DE7E",
      "offset": 7659134,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐、もしやそのカバンが"
    },
    {
      "item_id": "cluster_55_east_city:0074DE9C",
      "offset": 7659164,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一連の事件のカギを"
    },
    {
      "item_id": "cluster_55_east_city:0074DEB4",
      "offset": 7659188,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "握っているのでは？"
    },
    {
      "item_id": "cluster_55_east_city:0074DEE4",
      "offset": 7659236,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その可能性はあるな"
    },
    {
      "item_id": "cluster_55_east_city:0074DEFC",
      "offset": 7659260,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ならば、カバンを奪った犯人を"
    },
    {
      "item_id": "cluster_55_east_city:0074DF1E",
      "offset": 7659294,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "追わねばなるまい"
    },
    {
      "item_id": "cluster_55_east_city:0074DF4C",
      "offset": 7659340,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…だろうね"
    },
    {
      "item_id": "cluster_55_east_city:0074DF5C",
      "offset": 7659356,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "恐らくそいつが何らかの真相を"
    },
    {
      "item_id": "cluster_55_east_city:0074DF7E",
      "offset": 7659390,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "知ってるってことだ"
    },
    {
      "item_id": "cluster_55_east_city:0074DFAE",
      "offset": 7659438,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "犯人探しより"
    },
    {
      "item_id": "cluster_55_east_city:0074DFC0",
      "offset": 7659456,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "女の子を追っかけてた方が"
    },
    {
      "item_id": "cluster_55_east_city:0074DFDE",
      "offset": 7659486,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "性に合ってるんだがな"
    },
    {
      "item_id": "cluster_55_east_city:0074E010",
      "offset": 7659536,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オ、オホン"
    },
    {
      "item_id": "cluster_55_east_city:0074E038",
      "offset": 7659576,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ハイハイ"
    },
    {
      "item_id": "cluster_55_east_city:0074E046",
      "offset": 7659590,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マジメにやりますよ"
    },
    {
      "item_id": "cluster_55_east_city:0074E076",
      "offset": 7659638,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダイムラーを殺害したのが"
    },
    {
      "item_id": "cluster_55_east_city:0074E094",
      "offset": 7659668,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "何者か知らんが、まだ"
    },
    {
      "item_id": "cluster_55_east_city:0074E0AE",
      "offset": 7659694,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この辺りにいるかもしれんな"
    },
    {
      "item_id": "cluster_55_east_city:0074E0E0",
      "offset": 7659744,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "逃がすかよ！"
    },
    {
      "item_id": "cluster_55_east_city:0074E236",
      "offset": 7660086,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうやらここで"
    },
    {
      "item_id": "cluster_55_east_city:0074E24A",
      "offset": 7660106,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行き止まりみたいだな"
    },
    {
      "item_id": "cluster_55_east_city:0074E276",
      "offset": 7660150,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、あれ！"
    },
    {
      "item_id": "cluster_55_east_city:0074E2A4",
      "offset": 7660196,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よし、あれを倒せば"
    },
    {
      "item_id": "cluster_55_east_city:0074E2BC",
      "offset": 7660220,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この事件は解決だな"
    },
    {
      "item_id": "cluster_55_east_city:0074E2EC",
      "offset": 7660268,
      "source_group": "registry_a_entry8_prefixed_texts",
