{
  "items": [
    {
      "item_id": "cluster_71_save_menu:00772B7C",
      "offset": 7809916,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐、バルド人形は"
    },
    {
      "item_id": "cluster_71_save_menu:00772B94",
      "offset": 7809940,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "西側区画の下水道に"
    },
    {
      "item_id": "cluster_71_save_menu:00772BAC",
      "offset": 7809964,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "隠れていると思われます"
    },
    {
      "item_id": "cluster_71_save_menu:00772BD8",
      "offset": 7810008,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐はあてにならないわね…"
    },
    {
      "item_id": "cluster_71_save_menu:00772C02",
      "offset": 7810050,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドワード君、"
    },
    {
      "item_id": "cluster_71_save_menu:00772C16",
      "offset": 7810070,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アルフォンス君、"
    },
    {
      "item_id": "cluster_71_save_menu:00772C2C",
      "offset": 7810092,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私たちだけで何とかしましょう"
    },
    {
      "item_id": "cluster_71_save_menu:00772C7C",
      "offset": 7810172,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あのコ、どこ行ったのかしら…"
    },
    {
      "item_id": "cluster_71_save_menu:00772C9E",
      "offset": 7810206,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イーストシティからは"
    },
    {
      "item_id": "cluster_71_save_menu:00772CB8",
      "offset": 7810232,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "出ていないとは思うけど…"
    },
    {
      "item_id": "cluster_71_save_menu:00772D04",
      "offset": 7810308,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今はアルがいないんだ！"
    },
    {
      "item_id": "cluster_71_save_menu:00772D20",
      "offset": 7810336,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレがなんとかしないと！"
    },
    {
      "item_id": "cluster_71_save_menu:00772D6C",
      "offset": 7810412,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今はアルがいないだろ。"
    },
    {
      "item_id": "cluster_71_save_menu:00772D88",
      "offset": 7810440,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一体なにを期待してんだ？"
    },
    {
      "item_id": "cluster_71_save_menu:00772DC2",
      "offset": 7810498,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アルいない時、フラグミス"
    },
    {
      "item_id": "cluster_71_save_menu:00772E4A",
      "offset": 7810634,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今はアルがいないから"
    },
    {
      "item_id": "cluster_71_save_menu:00772E64",
      "offset": 7810660,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セーブはできないぞ"
    },
    {
      "item_id": "cluster_71_save_menu:00772E96",
      "offset": 7810710,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これまでの旅を記録する？"
    },
    {
      "item_id": "cluster_71_save_menu:00772EE2",
      "offset": 7810786,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "前の記録に上書きしてもいい？"
    },
    {
      "item_id": "cluster_71_save_menu:00772F3A",
      "offset": 7810874,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セーブ中だよ"
    },
    {
      "item_id": "cluster_71_save_menu:00772F5C",
      "offset": 7810908,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セーブ完了！"
    },
    {
      "item_id": "cluster_71_save_menu:00772F7A",
      "offset": 7810938,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "このままゲームを続けるの？"
    },
    {
      "item_id": "cluster_71_save_menu:007730B0",
      "offset": 7811248,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今までの旅をセーブするか？"
    },
    {
      "item_id": "cluster_71_save_menu:00773106",
      "offset": 7811334,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "前のデータに上書きするぞ？"
    },
    {
      "item_id": "cluster_71_save_menu:00773164",
      "offset": 7811428,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セーブ中だ…"
    },
    {
      "item_id": "cluster_71_save_menu:0077318E",
      "offset": 7811470,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セーブ完了！"
    },
    {
      "item_id": "cluster_71_save_menu:007731B4",
      "offset": 7811508,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "このまま旅を続けるか？"
    }
  ]
}