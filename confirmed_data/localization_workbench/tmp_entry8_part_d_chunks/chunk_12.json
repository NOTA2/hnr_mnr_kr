{
  "items": [
    {
      "item_id": "cluster_61_military:0075F1A2",
      "offset": 7729570,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今度こそ、"
    },
    {
      "item_id": "cluster_61_military:0075F1B6",
      "offset": 7729590,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これで終わりだろうな"
    },
    {
      "item_id": "cluster_61_military:0075F2DE",
      "offset": 7729886,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あれが…"
    },
    {
      "item_id": "cluster_61_military:0075F30A",
      "offset": 7729930,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドって、"
    },
    {
      "item_id": "cluster_61_military:0075F31E",
      "offset": 7729950,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あんな変な色だったかしら"
    },
    {
      "item_id": "cluster_61_military:0075F352",
      "offset": 7730002,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "違うわっ！"
    },
    {
      "item_id": "cluster_61_military:0075F378",
      "offset": 7730040,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケイトによると、"
    },
    {
      "item_id": "cluster_61_military:0075F39C",
      "offset": 7730076,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "試作品だったらしいわね"
    },
    {
      "item_id": "cluster_61_military:0075F3CA",
      "offset": 7730122,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "試作品？"
    },
    {
      "item_id": "cluster_61_military:0075F3DC",
      "offset": 7730140,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まだ未完成ってことですか"
    },
    {
      "item_id": "cluster_61_military:0075F408",
      "offset": 7730184,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なるほど。"
    },
    {
      "item_id": "cluster_61_military:0075F41C",
      "offset": 7730204,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まだ色ぬりが"
    },
    {
      "item_id": "cluster_61_military:0075F42E",
      "offset": 7730222,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "終わってないんですね"
    },
    {
      "item_id": "cluster_61_military:0075F45E",
      "offset": 7730270,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…そういうわけでも"
    },
    {
      "item_id": "cluster_61_military:0075F476",
      "offset": 7730294,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ないと思うけど…"
    },
    {
      "item_id": "cluster_61_military:0075F49A",
      "offset": 7730330,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まだ未完成ってことなら、"
    },
    {
      "item_id": "cluster_61_military:0075F4BC",
      "offset": 7730364,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "楽勝だな"
    },
    {
      "item_id": "cluster_61_military:0075F4DC",
      "offset": 7730396,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケイトの話によれば、"
    },
    {
      "item_id": "cluster_61_military:0075F4F6",
      "offset": 7730422,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "戦闘能力はエドワード君を"
    },
    {
      "item_id": "cluster_61_military:0075F514",
      "offset": 7730452,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "はるかに超えているとのことよ"
    },
    {
      "item_id": "cluster_61_military:0075F548",
      "offset": 7730504,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの小娘、"
    },
    {
      "item_id": "cluster_61_military:0075F560",
      "offset": 7730528,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレに隠れてそんなことを"
    },
    {
      "item_id": "cluster_61_military:0075F57E",
      "offset": 7730558,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言ってやがったのか！？"
    },
    {
      "item_id": "cluster_61_military:0075F5B0",
      "offset": 7730608,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドワード・エルリックよ、"
    },
    {
      "item_id": "cluster_61_military:0075F5D4",
      "offset": 7730644,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "恐れてはいかんぞ"
    },
    {
      "item_id": "cluster_61_military:0075F610",
      "offset": 7730704,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "強い敵と戦うことこそ"
    },
    {
      "item_id": "cluster_61_military:0075F62A",
      "offset": 7730730,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "武人の本望！"
    },
    {
      "item_id": "cluster_61_military:0075F66C",
      "offset": 7730796,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "恐れてはいないけどさ…"
    },
    {
      "item_id": "cluster_61_military:0075F69E",
      "offset": 7730846,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ならばよいが…"
    },
    {
      "item_id": "cluster_61_military:0075F6E4",
      "offset": 7730916,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キミたち！"
    },
    {
      "item_id": "cluster_61_military:0075F6F8",
      "offset": 7730936,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいかげんにしないか！"
    },
    {
      "item_id": "cluster_61_military:0075F736",
      "offset": 7730998,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうですよ！"
    },
    {
      "item_id": "cluster_61_military:0075F74C",
      "offset": 7731020,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "遊びで来ているのでは"
    },
    {
      "item_id": "cluster_61_military:0075F766",
      "offset": 7731046,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ないんですから！"
    },
    {
      "item_id": "cluster_61_military:0075F78C",
      "offset": 7731084,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キミらがゴチャゴチャと"
    },
    {
      "item_id": "cluster_61_military:0075F7A8",
      "offset": 7731112,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さわいでいるから、"
    },
    {
      "item_id": "cluster_61_military:0075F7C4",
      "offset": 7731140,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私が目立たんではないか！"
    },
    {
      "item_id": "cluster_61_military:0075F824",
      "offset": 7731236,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "主役はオレだぞ！"
    },
    {
      "item_id": "cluster_61_military:0075F84C",
      "offset": 7731276,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクも主役でしょ！？"
    },
    {
      "item_id": "cluster_61_military:0075F878",
      "offset": 7731320,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なに言ってんだ、"
    },
    {
      "item_id": "cluster_61_military:0075F8A0",
      "offset": 7731360,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "「鋼の錬金術師」だぞ！"
    },
    {
      "item_id": "cluster_61_military:0075F8BC",
      "offset": 7731388,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "主役はオレに決まってんだろ！"
    },
    {
      "item_id": "cluster_61_military:0075F8F0",
      "offset": 7731440,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなぁ～"
    },
    {
      "item_id": "cluster_61_military:0075F90E",
      "offset": 7731470,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "では、我輩も目立つとしよう！"
    },
    {
      "item_id": "cluster_61_military:0075F95E",
      "offset": 7731550,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "みんな、好き勝手なこと"
    },
    {
      "item_id": "cluster_61_military:0075F97A",
      "offset": 7731578,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やってる時じゃないですよ！"
    },
    {
      "item_id": "cluster_61_military:0075F99A",
      "offset": 7731610,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいんですか、ホークアイさん"
    },
    {
      "item_id": "cluster_61_military:0075F9D4",
      "offset": 7731668,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう知りません…"
    },
    {
      "item_id": "cluster_61_military:0075F9FC",
      "offset": 7731708,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "フン、なまぬるい！"
    },
    {
      "item_id": "cluster_61_military:0075FA18",
      "offset": 7731736,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうせ最後なのだから、"
    },
    {
      "item_id": "cluster_61_military:0075FA34",
      "offset": 7731764,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "好きにやらせてもらう！"
    },
    {
      "item_id": "cluster_61_military:0075FB10",
      "offset": 7731984,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、"
    },
    {
      "item_id": "cluster_61_military:0075FB20",
      "offset": 7732000,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やったね！"
    },
    {
      "item_id": "cluster_61_military:0075FB3E",
      "offset": 7732030,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それでこそ"
    },
    {
      "item_id": "cluster_61_military:0075FB4E",
      "offset": 7732046,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我輩が見込んだ男だ！"
    },
    {
      "item_id": "cluster_61_military:0075FB7A",
      "offset": 7732090,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだかスッゴイ錬成を"
    },
    {
      "item_id": "cluster_61_military:0075FB96",
      "offset": 7732118,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いっぱい見ちゃいました。"
    },
    {
      "item_id": "cluster_61_military:0075FBC4",
      "offset": 7732164,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "感動です！"
    },
    {
      "item_id": "cluster_61_military:0075FBFC",
      "offset": 7732220,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これにて一件落着だな"
    },
    {
      "item_id": "cluster_61_military:0075FC36",
      "offset": 7732278,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "任務完了です"
    },
    {
      "item_id": "cluster_61_military:0075FC5A",
      "offset": 7732314,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よーし、それじゃ戻るか！"
    },
    {
      "item_id": "cluster_61_military:0075FD0E",
      "offset": 7732494,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんなところにいちゃダメだよ"
    },
    {
      "item_id": "cluster_61_military:0075FD3E",
      "offset": 7732542,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんでこんなところに…？"
    },
    {
      "item_id": "cluster_62_central:007609CA",
      "offset": 7735754,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっぱり「賢者の石」って"
    },
    {
      "item_id": "cluster_62_central:007609E8",
      "offset": 7735784,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なかなか見つからないものだね"
    },
    {
      "item_id": "cluster_62_central:00760A16",
      "offset": 7735830,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ガセネタばっかりだもんなぁ。"
    },
    {
      "item_id": "cluster_62_central:00760A38",
      "offset": 7735864,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一度、セントラルシティに"
    },
    {
      "item_id": "cluster_62_central:00760A56",
      "offset": 7735894,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "戻ってみるか"
    },
    {
      "item_id": "cluster_62_central:00760A78",
      "offset": 7735928,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうしようよ。"
    },
    {
      "item_id": "cluster_62_central:00760A8C",
      "offset": 7735948,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "新しい情報が"
    },
    {
      "item_id": "cluster_62_central:00760A9E",
      "offset": 7735966,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あるかもしれないしね"
    },
    {
      "item_id": "cluster_62_central:00760AEA",
      "offset": 7736042,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "動くな！！"
    },
    {
      "item_id": "cluster_62_central:00760B22",
      "offset": 7736098,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この列車は赤の団、"
    },
    {
      "item_id": "cluster_62_central:00760B3A",
      "offset": 7736122,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "バルド一味が乗っ取った。"
    },
    {
      "item_id": "cluster_62_central:00760B58",
      "offset": 7736152,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ムダな抵抗はするな"
    },
    {
      "item_id": "cluster_62_central:00760B8C",
      "offset": 7736204,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、どうする？"
    },
    {
      "item_id": "cluster_62_central:00760BB6",
      "offset": 7736246,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こう何度も列車強盗にあう"
    },
    {
      "item_id": "cluster_62_central:00760BD4",
      "offset": 7736276,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレらって不運だよなぁ"
    },
    {
      "item_id": "cluster_62_central:00760C14",
      "offset": 7736340,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだお前ら。"
    },
    {
      "item_id": "cluster_62_central:00760C28",
      "offset": 7736360,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "緊張感なさすぎるぞ"
    },
    {
      "item_id": "cluster_62_central:00760C58",
      "offset": 7736408,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "じゃあさ、抵抗したら"
    },
    {
      "item_id": "cluster_62_central:00760C72",
      "offset": 7736434,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうするつもりだよ"
    },
    {
      "item_id": "cluster_62_central:00760C96",
      "offset": 7736470,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こっちはなぁ、既に人質を"
    },
    {
      "item_id": "cluster_62_central:00760CB4",
      "offset": 7736500,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "とってんだ。"
    },
    {
      "item_id": "cluster_62_central:00760CC6",
      "offset": 7736518,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そいつの命の保証はなくなるな"
    },
    {
      "item_id": "cluster_62_central:00760CF4",
      "offset": 7736564,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人質かぁ"
    },
    {
      "item_id": "cluster_62_central:00760D0E",
      "offset": 7736590,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "妙な気を起こすなよ。"
    },
    {
      "item_id": "cluster_62_central:00760D2E",
      "offset": 7736622,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "俺はこの車両を見張る。"
    },
    {
      "item_id": "cluster_62_central:00760D4A",
      "offset": 7736650,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前はボスの所に戻れ"
    },
    {
      "item_id": "cluster_62_central:00760D94",
      "offset": 7736724,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "仕方がない。"
    },
    {
      "item_id": "cluster_62_central:00760DA6",
      "offset": 7736742,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "助けに行くか…"
    },
    {
      "item_id": "cluster_62_central:00760DD2",
      "offset": 7736786,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうだね、兄さん"
    },
    {
      "item_id": "cluster_62_central:00760ED2",
      "offset": 7737042,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだぁ、やるってのか？"
    },
    {
      "item_id": "cluster_62_central:00760FCA",
      "offset": 7737290,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "俺は旅の行商人。"
    },
    {
      "item_id": "cluster_62_central:00760FE0",
      "offset": 7737312,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "身体にいい薬はいらないかい？"
    },
    {
      "item_id": "cluster_62_central:00761004",
      "offset": 7737348,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自然の２－５のレベル２だよ。"
    },
    {
      "item_id": "cluster_62_central:00761026",
      "offset": 7737382,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "８００センズだけど、"
    },
    {
      "item_id": "cluster_62_central:00761040",
      "offset": 7737408,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "買っていくかい？"
    },
    {
      "item_id": "cluster_62_central:0076106E",
      "offset": 7737454,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自然の２－５、レベル２か…"
    },
    {
      "item_id": "cluster_62_central:007610DC",
      "offset": 7737564,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お客さんの手持ちカードから"
    },
    {
      "item_id": "cluster_62_central:007610FC",
      "offset": 7737596,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いらないものを選んでください"
    },
    {
      "item_id": "cluster_62_central:00761174",
      "offset": 7737716,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おや、いらないのですか？"
    },
    {
      "item_id": "cluster_62_central:00761192",
      "offset": 7737746,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いつでもどうぞ"
    },
    {
      "item_id": "cluster_62_central:007611B6",
      "offset": 7737782,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お客さんの素材カードの"
    },
    {
      "item_id": "cluster_62_central:007611D2",
      "offset": 7737810,
      "source_group": "registry_a_entry8_prefixed_texts",
