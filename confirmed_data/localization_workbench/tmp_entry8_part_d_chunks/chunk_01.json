{
  "items": [
    {
      "item_id": "cluster_55_east_city:0074AECE",
      "offset": 7646926,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ほれ、よく見てみろっ！"
    },
    {
      "item_id": "cluster_55_east_city:0074AF00",
      "offset": 7646976,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これが下品かっ！？"
    },
    {
      "item_id": "cluster_55_east_city:0074AF2A",
      "offset": 7647018,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きゃーっ、セクハラっ！"
    },
    {
      "item_id": "cluster_55_east_city:0074AF46",
      "offset": 7647046,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キモチワルイ！"
    },
    {
      "item_id": "cluster_55_east_city:0074AF72",
      "offset": 7647090,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キモチワルイ、言うなー！"
    },
    {
      "item_id": "cluster_55_east_city:0074AFA8",
      "offset": 7647144,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんもコニィも"
    },
    {
      "item_id": "cluster_55_east_city:0074AFBE",
      "offset": 7647166,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう忘れちゃったの？"
    },
    {
      "item_id": "cluster_55_east_city:0074AFD8",
      "offset": 7647192,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "レドンドにいた銀行強盗だよ"
    },
    {
      "item_id": "cluster_55_east_city:0074B016",
      "offset": 7647254,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "忘れるわけねーだろ！"
    },
    {
      "item_id": "cluster_55_east_city:0074B030",
      "offset": 7647280,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "からかってるだけだよ"
    },
    {
      "item_id": "cluster_55_east_city:0074B062",
      "offset": 7647330,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんか言ったか！"
    },
    {
      "item_id": "cluster_55_east_city:0074B096",
      "offset": 7647382,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いや、こっちの話！"
    },
    {
      "item_id": "cluster_55_east_city:0074B0C0",
      "offset": 7647424,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それでその銀行強盗さんが"
    },
    {
      "item_id": "cluster_55_east_city:0074B0DE",
      "offset": 7647454,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんでここに？"
    },
    {
      "item_id": "cluster_55_east_city:0074B0F2",
      "offset": 7647474,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここ、銀行じゃないですよ？"
    },
    {
      "item_id": "cluster_55_east_city:0074B12A",
      "offset": 7647530,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから言ってるだろうが！"
    },
    {
      "item_id": "cluster_55_east_city:0074B148",
      "offset": 7647560,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "俺がダイムラーをやった"
    },
    {
      "item_id": "cluster_55_east_city:0074B164",
      "offset": 7647588,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "犯人だって！"
    },
    {
      "item_id": "cluster_55_east_city:0074B18E",
      "offset": 7647630,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "また自白したな"
    },
    {
      "item_id": "cluster_55_east_city:0074B1BA",
      "offset": 7647674,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "救いようのないバカですね"
    },
    {
      "item_id": "cluster_55_east_city:0074B212",
      "offset": 7647762,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それにあの手にしているのが"
    },
    {
      "item_id": "cluster_55_east_city:0074B232",
      "offset": 7647794,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ダイムラーから奪った"
    },
    {
      "item_id": "cluster_55_east_city:0074B24C",
      "offset": 7647820,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "カバンのようだしな"
    },
    {
      "item_id": "cluster_55_east_city:0074B27C",
      "offset": 7647868,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自白に加えて、"
    },
    {
      "item_id": "cluster_55_east_city:0074B290",
      "offset": 7647888,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "物的証拠も完璧、と"
    },
    {
      "item_id": "cluster_55_east_city:0074B2C0",
      "offset": 7647936,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "要するに、"
    },
    {
      "item_id": "cluster_55_east_city:0074B2D0",
      "offset": 7647952,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こいつをぶっ倒せば"
    },
    {
      "item_id": "cluster_55_east_city:0074B2E8",
      "offset": 7647976,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "事件解決ってことだろ？"
    },
    {
      "item_id": "cluster_55_east_city:0074B31C",
      "offset": 7648028,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "乱暴な物言いだな。"
    },
    {
      "item_id": "cluster_55_east_city:0074B334",
      "offset": 7648052,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、聞きたいこともある"
    },
    {
      "item_id": "cluster_55_east_city:0074B352",
      "offset": 7648082,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ほどほどにな"
    },
    {
      "item_id": "cluster_55_east_city:0074B37C",
      "offset": 7648124,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "へーい。"
    },
    {
      "item_id": "cluster_55_east_city:0074B38A",
      "offset": 7648138,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "じゃ、さっさとはじめようぜ"
    },
    {
      "item_id": "cluster_55_east_city:0074B3C2",
      "offset": 7648194,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐よ、"
    },
    {
      "item_id": "cluster_55_east_city:0074B3DC",
      "offset": 7648220,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここはひとつ、この我輩が！"
    },
    {
      "item_id": "cluster_55_east_city:0074B428",
      "offset": 7648296,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お、やるってか？"
    },
    {
      "item_id": "cluster_55_east_city:0074B43E",
      "offset": 7648318,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "望むところよ！"
    },
    {
      "item_id": "cluster_55_east_city:0074B51A",
      "offset": 7648538,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうやら勝負あったようだな"
    },
    {
      "item_id": "cluster_55_east_city:0074B53A",
      "offset": 7648570,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、ここまでもったこと"
    },
    {
      "item_id": "cluster_55_east_city:0074B558",
      "offset": 7648600,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ほめてやろう"
    },
    {
      "item_id": "cluster_55_east_city:0074B580",
      "offset": 7648640,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まーた、ランディったら"
    },
    {
      "item_id": "cluster_55_east_city:0074B59C",
      "offset": 7648668,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんなところで"
    },
    {
      "item_id": "cluster_55_east_city:0074B5B0",
      "offset": 7648688,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "寄り道してんのー？"
    },
    {
      "item_id": "cluster_55_east_city:0074B5F8",
      "offset": 7648760,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ～！あのちっこいのは！"
    },
    {
      "item_id": "cluster_55_east_city:0074B62E",
      "offset": 7648814,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ちっこい？"
    },
    {
      "item_id": "cluster_55_east_city:0074B640",
      "offset": 7648832,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰が豆粒だって！？"
    },
    {
      "item_id": "cluster_55_east_city:0074B658",
      "offset": 7648856,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰がミジンコだって！？"
    },
    {
      "item_id": "cluster_55_east_city:0074B68C",
      "offset": 7648908,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ま、待て！"
    },
    {
      "item_id": "cluster_55_east_city:0074B69C",
      "offset": 7648924,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰もエドのことなんか"
    },
    {
      "item_id": "cluster_55_east_city:0074B6B6",
      "offset": 7648950,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言ってないだろうがっ！"
    },
    {
      "item_id": "cluster_55_east_city:0074B6EA",
      "offset": 7649002,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うぉぉぉぉぉ！"
    },
    {
      "item_id": "cluster_55_east_city:0074B6FE",
      "offset": 7649022,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ぶっとばーす！"
    },
    {
      "item_id": "cluster_55_east_city:0074B72A",
      "offset": 7649066,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん！"
    },
    {
      "item_id": "cluster_55_east_city:0074B738",
      "offset": 7649080,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、落ち着いてっ！"
    },
    {
      "item_id": "cluster_55_east_city:0074B75A",
      "offset": 7649114,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ほら、あの子…"
    },
    {
      "item_id": "cluster_55_east_city:0074B786",
      "offset": 7649158,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あーっ！！"
    },
    {
      "item_id": "cluster_55_east_city:0074B796",
      "offset": 7649174,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ソリンの裏山でっ！"
    },
    {
      "item_id": "cluster_55_east_city:0074B7CC",
      "offset": 7649228,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクたちの偽者を作った"
    },
    {
      "item_id": "cluster_55_east_city:0074B7E8",
      "offset": 7649256,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術師の子だよ！"
    },
    {
      "item_id": "cluster_55_east_city:0074B818",
      "offset": 7649304,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああ、そういえば、"
    },
    {
      "item_id": "cluster_55_east_city:0074B830",
      "offset": 7649328,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなのもいたっけか"
    },
    {
      "item_id": "cluster_55_east_city:0074B85C",
      "offset": 7649372,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "てーかさ、"
    },
    {
      "item_id": "cluster_55_east_city:0074B86C",
      "offset": 7649388,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前ら仲間だったのか？"
    },
    {
      "item_id": "cluster_55_east_city:0074B8A0",
      "offset": 7649440,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "仲間ねぇ…うーん"
    },
    {
      "item_id": "cluster_55_east_city:0074B8D0",
      "offset": 7649488,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ま、お守り役ってとこかな"
    },
    {
      "item_id": "cluster_55_east_city:0074B906",
      "offset": 7649542,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰のお守り役だって！？"
    },
    {
      "item_id": "cluster_55_east_city:0074B934",
      "offset": 7649588,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アンタよ、アンタ！"
    },
    {
      "item_id": "cluster_55_east_city:0074B94C",
      "offset": 7649612,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんであたしが、ワザワザ"
    },
    {
      "item_id": "cluster_55_east_city:0074B96A",
      "offset": 7649642,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "出てきたと思ってんのよ？"
    },
    {
      "item_id": "cluster_55_east_city:0074B99A",
      "offset": 7649690,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰も頼んでねーだろうが"
    },
    {
      "item_id": "cluster_55_east_city:0074B9C8",
      "offset": 7649736,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "仕方ないでしょ"
    },
    {
      "item_id": "cluster_55_east_city:0074B9DC",
      "offset": 7649756,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お兄ちゃんの"
    },
    {
      "item_id": "cluster_55_east_city:0074B9EE",
      "offset": 7649774,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言いつけなんだもん"
    },
    {
      "item_id": "cluster_55_east_city:0074BA18",
      "offset": 7649816,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そういうことだ"
    },
    {
      "item_id": "cluster_55_east_city:0074BABA",
      "offset": 7649978,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あまりにランディの帰りが"
    },
    {
      "item_id": "cluster_55_east_city:0074BAD8",
      "offset": 7650008,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "遅いのでな"
    },
    {
      "item_id": "cluster_55_east_city:0074BAE8",
      "offset": 7650024,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "様子を見に来た"
    },
    {
      "item_id": "cluster_55_east_city:0074BB06",
      "offset": 7650054,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…大将ならしかたねぇか"
    },
    {
      "item_id": "cluster_55_east_city:0074BB22",
      "offset": 7650082,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、例のカバンはちゃんと"
    },
    {
      "item_id": "cluster_55_east_city:0074BB42",
      "offset": 7650114,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "手に入れたぜ"
    },
    {
      "item_id": "cluster_55_east_city:0074BB5E",
      "offset": 7650142,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たしかに"
    },
    {
      "item_id": "cluster_55_east_city:0074BB6C",
      "offset": 7650156,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "探していたものだ"
    },
    {
      "item_id": "cluster_55_east_city:0074BB98",
      "offset": 7650200,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やることはちゃーんと"
    },
    {
      "item_id": "cluster_55_east_city:0074BBB2",
      "offset": 7650226,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やってるんだぜ？"
    },
    {
      "item_id": "cluster_55_east_city:0074BBE2",
      "offset": 7650274,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "えばんないのー！"
    },
    {
      "item_id": "cluster_55_east_city:0074BBF8",
      "offset": 7650296,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんな連中、相手にしてないで"
    },
    {
      "item_id": "cluster_55_east_city:0074BC1A",
      "offset": 7650330,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっさと帰ってきなさいよ"
    },
    {
      "item_id": "cluster_55_east_city:0074BCC2",
      "offset": 7650498,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…新手。"
    },
    {
      "item_id": "cluster_55_east_city:0074BCD0",
      "offset": 7650512,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの後ろのも錬金術師か？"
    },
    {
      "item_id": "cluster_55_east_city:0074BCEE",
      "offset": 7650542,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐、どう思う？"
    },
    {
      "item_id": "cluster_55_east_city:0074BD16",
      "offset": 7650582,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の、君も感じたか？"
    },
    {
      "item_id": "cluster_55_east_city:0074BD30",
      "offset": 7650608,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "後ろの男…"
    },
    {
      "item_id": "cluster_55_east_city:0074BD58",
      "offset": 7650648,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かなりの錬金術師と見た"
    },
    {
      "item_id": "cluster_55_east_city:0074BD8C",
      "offset": 7650700,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの声…"
    },
    {
      "item_id": "cluster_55_east_city:0074BD9A",
      "offset": 7650714,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ロイス…まさか"
    },
    {
      "item_id": "cluster_55_east_city:0074BDD2",
      "offset": 7650770,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐、"
    },
    {
      "item_id": "cluster_55_east_city:0074BDEA",
      "offset": 7650794,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "顔色悪いけど？"
    },
    {
      "item_id": "cluster_55_east_city:0074BE10",
      "offset": 7650832,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いや、ロイス…大佐が"
    },
    {
      "item_id": "cluster_55_east_city:0074BE2A",
      "offset": 7650858,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここに…いるはずがねぇ"
    },
    {
      "item_id": "cluster_55_east_city:0074BE5E",
      "offset": 7650910,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐、"
    },
    {
      "item_id": "cluster_55_east_city:0074BE76",
      "offset": 7650934,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…その名は"
    },
    {
