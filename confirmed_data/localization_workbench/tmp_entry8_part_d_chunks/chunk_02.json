{
  "items": [
    {
      "item_id": "cluster_55_east_city:0074C12C",
      "offset": 7651628,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それが礼儀だと思います"
    },
    {
      "item_id": "cluster_55_east_city:0074C160",
      "offset": 7651680,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コ、コニィ。"
    },
    {
      "item_id": "cluster_55_east_city:0074C172",
      "offset": 7651698,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "また、そんな相手を"
    },
    {
      "item_id": "cluster_55_east_city:0074C18A",
      "offset": 7651722,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "挑発するようなことを…"
    },
    {
      "item_id": "cluster_55_east_city:0074C1BE",
      "offset": 7651774,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だって、アル。"
    },
    {
      "item_id": "cluster_55_east_city:0074C1D2",
      "offset": 7651794,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの人、仮面はつけてるし、"
    },
    {
      "item_id": "cluster_55_east_city:0074C1F2",
      "offset": 7651826,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "名乗りもしないし…"
    },
    {
      "item_id": "cluster_55_east_city:0074C21A",
      "offset": 7651866,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああいうのを"
    },
    {
      "item_id": "cluster_55_east_city:0074C22C",
      "offset": 7651884,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "礼儀知らずって言うんです！"
    },
    {
      "item_id": "cluster_55_east_city:0074C25E",
      "offset": 7651934,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まあ、良かろう。"
    },
    {
      "item_id": "cluster_55_east_city:0074C274",
      "offset": 7651956,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そう、我が名はリンカー。"
    },
    {
      "item_id": "cluster_55_east_city:0074C292",
      "offset": 7651986,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "娘、君の名は？"
    },
    {
      "item_id": "cluster_55_east_city:0074C2B8",
      "offset": 7652024,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コーニッシュ・ロイスよ"
    },
    {
      "item_id": "cluster_55_east_city:0074C2E6",
      "offset": 7652070,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コーニッシュか"
    },
    {
      "item_id": "cluster_55_east_city:0074C2FA",
      "offset": 7652090,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コーニッシュ…コニィ？"
    },
    {
      "item_id": "cluster_55_east_city:0074C32E",
      "offset": 7652142,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "う、うう…コニィ？"
    },
    {
      "item_id": "cluster_55_east_city:0074C364",
      "offset": 7652196,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だ、大丈夫、お兄ちゃん！？"
    },
    {
      "item_id": "cluster_55_east_city:0074C396",
      "offset": 7652246,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ちょっと、アンタ、"
    },
    {
      "item_id": "cluster_55_east_city:0074C3AE",
      "offset": 7652270,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お兄ちゃんになにしたのよ！"
    },
    {
      "item_id": "cluster_55_east_city:0074C3E0",
      "offset": 7652320,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "な、なにをしたって…"
    },
    {
      "item_id": "cluster_55_east_city:0074C3FA",
      "offset": 7652346,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "知らないわよ！"
    },
    {
      "item_id": "cluster_55_east_city:0074C426",
      "offset": 7652390,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お兄ちゃんをいじめるんなら"
    },
    {
      "item_id": "cluster_55_east_city:0074C446",
      "offset": 7652422,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "許さないからねっ！"
    },
    {
      "item_id": "cluster_55_east_city:0074C470",
      "offset": 7652464,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだかわからないけど、"
    },
    {
      "item_id": "cluster_55_east_city:0074C48E",
      "offset": 7652494,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうやら穏便に済む"
    },
    {
      "item_id": "cluster_55_east_city:0074C4A6",
      "offset": 7652518,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "雰囲気じゃないようだな"
    },
    {
      "item_id": "cluster_55_east_city:0074C574",
      "offset": 7652724,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "じ、尋常じゃない力だぜ。"
    },
    {
      "item_id": "cluster_55_east_city:0074C598",
      "offset": 7652760,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…まさか"
    },
    {
      "item_id": "cluster_55_east_city:0074C5BE",
      "offset": 7652798,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんもそう思った？"
    },
    {
      "item_id": "cluster_55_east_city:0074C5F0",
      "offset": 7652848,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああ。あのカバンの中身が、"
    },
    {
      "item_id": "cluster_55_east_city:0074C610",
      "offset": 7652880,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もしかして賢者の石かもな"
    },
    {
      "item_id": "cluster_55_east_city:0074C640",
      "offset": 7652928,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もしそうなら"
    },
    {
      "item_id": "cluster_55_east_city:0074C652",
      "offset": 7652946,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの黒いカバンが"
    },
    {
      "item_id": "cluster_55_east_city:0074C668",
      "offset": 7652968,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "狙われているのも納得いくね"
    },
    {
      "item_id": "cluster_55_east_city:0074C6A0",
      "offset": 7653024,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なあ、大佐。"
    },
    {
      "item_id": "cluster_55_east_city:0074C6BE",
      "offset": 7653054,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…大佐？"
    },
    {
      "item_id": "cluster_55_east_city:0074C6E4",
      "offset": 7653092,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっきの錬金術師"
    },
    {
      "item_id": "cluster_55_east_city:0074C6FA",
      "offset": 7653114,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…リンカーと名乗ったが、"
    },
    {
      "item_id": "cluster_55_east_city:0074C718",
      "offset": 7653144,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まさか…ロイス大佐だと？"
    },
    {
      "item_id": "cluster_55_east_city:0074C766",
      "offset": 7653222,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、ロイス大佐は"
    },
    {
      "item_id": "cluster_55_east_city:0074C77E",
      "offset": 7653246,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "戦死したと報告されている"
    },
    {
      "item_id": "cluster_55_east_city:0074C79C",
      "offset": 7653276,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イシュヴァール内乱時にな"
    },
    {
      "item_id": "cluster_55_east_city:0074C7F6",
      "offset": 7653366,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "何か隠しているな？"
    },
    {
      "item_id": "cluster_55_east_city:0074C80E",
      "offset": 7653390,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中佐、命令だ。話してもらおう"
    },
    {
      "item_id": "cluster_55_east_city:0074C840",
      "offset": 7653440,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…たしかに"
    },
    {
      "item_id": "cluster_55_east_city:0074C850",
      "offset": 7653456,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "「死んだ」んだ、大佐は"
    },
    {
      "item_id": "cluster_55_east_city:0074C86C",
      "offset": 7653484,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの内乱で…"
    },
    {
      "item_id": "cluster_55_east_city:0074C890",
      "offset": 7653520,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…今はそういうことに"
    },
    {
      "item_id": "cluster_55_east_city:0074C8AA",
      "offset": 7653546,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しておこう"
    },
    {
      "item_id": "cluster_55_east_city:0074C8BA",
      "offset": 7653562,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、仮に…"
    },
    {
      "item_id": "cluster_55_east_city:0074C8EE",
      "offset": 7653614,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "仮に敵前逃亡を助けた"
    },
    {
      "item_id": "cluster_55_east_city:0074C908",
      "offset": 7653640,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "となれば、"
    },
    {
      "item_id": "cluster_55_east_city:0074C918",
      "offset": 7653656,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ただじゃ済まないよな"
    },
    {
      "item_id": "cluster_55_east_city:0074C950",
      "offset": 7653712,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の、聞いていたのか"
    },
    {
      "item_id": "cluster_55_east_city:0074C98C",
      "offset": 7653772,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そりゃ、二人で深刻な顔して"
    },
    {
      "item_id": "cluster_55_east_city:0074C9AC",
      "offset": 7653804,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コソコソやってれば"
    },
    {
      "item_id": "cluster_55_east_city:0074C9C4",
      "offset": 7653828,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気になるからね"
    },
    {
      "item_id": "cluster_55_east_city:0074C9F4",
      "offset": 7653876,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…君にも話しておいた方が"
    },
    {
      "item_id": "cluster_55_east_city:0074CA12",
      "offset": 7653906,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よさそうだな"
    },
    {
      "item_id": "cluster_55_east_city:0074CA36",
      "offset": 7653942,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ロイス大佐ってヤツのこと？"
    },
    {
      "item_id": "cluster_55_east_city:0074CA56",
      "offset": 7653974,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐ってことは国家錬金術師？"
    },
    {
      "item_id": "cluster_55_east_city:0074CA8A",
      "offset": 7654026,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "調律の錬金術師と呼ばれ、"
    },
    {
      "item_id": "cluster_55_east_city:0074CAA8",
      "offset": 7654056,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "治癒錬成の権威だった"
    },
    {
      "item_id": "cluster_55_east_city:0074CAD2",
      "offset": 7654098,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だった…って？　過去形？"
    },
    {
      "item_id": "cluster_55_east_city:0074CB0C",
      "offset": 7654156,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、彼の錬金術師資格は"
    },
    {
      "item_id": "cluster_55_east_city:0074CB2A",
      "offset": 7654186,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "剥奪された"
    },
    {
      "item_id": "cluster_55_east_city:0074CB5E",
      "offset": 7654238,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "剥奪！？"
    },
    {
      "item_id": "cluster_55_east_city:0074CB7E",
      "offset": 7654270,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "正確には"
    },
    {
      "item_id": "cluster_55_east_city:0074CB8C",
      "offset": 7654284,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "剥奪されるところだった"
    },
    {
      "item_id": "cluster_55_east_city:0074CBA8",
      "offset": 7654312,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "というべきかな"
    },
    {
      "item_id": "cluster_55_east_city:0074CBCE",
      "offset": 7654350,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "剥奪される前に"
    },
    {
      "item_id": "cluster_55_east_city:0074CBE2",
      "offset": 7654370,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "内乱で死亡した？"
    },
    {
      "item_id": "cluster_55_east_city:0074CC08",
      "offset": 7654408,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そういうことだ"
    },
    {
      "item_id": "cluster_55_east_city:0074CC2E",
      "offset": 7654446,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、なんで"
    },
    {
      "item_id": "cluster_55_east_city:0074CC40",
      "offset": 7654464,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "資格剥奪なんてことに"
    },
    {
      "item_id": "cluster_55_east_city:0074CC5A",
      "offset": 7654490,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なったんだ？"
    },
    {
      "item_id": "cluster_55_east_city:0074CC7E",
      "offset": 7654526,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっきも言ったが、"
    },
    {
      "item_id": "cluster_55_east_city:0074CC96",
      "offset": 7654550,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "治癒錬成の第一人者とまで"
    },
    {
      "item_id": "cluster_55_east_city:0074CCB4",
      "offset": 7654580,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言われていた人だった"
    },
    {
      "item_id": "cluster_55_east_city:0074CCE6",
      "offset": 7654630,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師の中でも"
    },
    {
      "item_id": "cluster_55_east_city:0074CD00",
      "offset": 7654656,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エリートだったってことね？"
    },
    {
      "item_id": "cluster_55_east_city:0074CD32",
      "offset": 7654706,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが鋼の、わかるだろう？"
    },
    {
      "item_id": "cluster_55_east_city:0074CD50",
      "offset": 7654736,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "治癒錬成といえば…"
    },
    {
      "item_id": "cluster_55_east_city:0074CD86",
      "offset": 7654790,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ある意味…生命を操る、"
    },
    {
      "item_id": "cluster_55_east_city:0074CDA2",
      "offset": 7654818,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人体錬成に"
    },
    {
      "item_id": "cluster_55_east_city:0074CDB2",
      "offset": 7654834,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もっとも近い錬金術"
    },
    {
      "item_id": "cluster_55_east_city:0074CDDA",
      "offset": 7654874,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…まさか！？"
    },
    {
      "item_id": "cluster_55_east_city:0074CE04",
      "offset": 7654916,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それはない…と信じたいな。"
    },
    {
      "item_id": "cluster_55_east_city:0074CE24",
      "offset": 7654948,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キメラの錬成では、それなりの"
    },
    {
      "item_id": "cluster_55_east_city:0074CE46",
      "offset": 7654982,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "実績はあったようだが…"
    },
    {
      "item_id": "cluster_55_east_city:0074CE72",
      "offset": 7655026,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、真偽はどうであれ、"
    },
    {
      "item_id": "cluster_55_east_city:0074CE90",
      "offset": 7655056,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人体錬成に手を染めている、"
    },
    {
      "item_id": "cluster_55_east_city:0074CEB0",
      "offset": 7655088,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "という噂が流れてな…"
    },
    {
      "item_id": "cluster_55_east_city:0074CEDC",
      "offset": 7655132,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人体…錬成…か。"
    },
    {
      "item_id": "cluster_55_east_city:0074CEF2",
      "offset": 7655154,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、噂だけなんだろ？"
    },
    {
      "item_id": "cluster_55_east_city:0074CF20",
      "offset": 7655200,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍のお偉方はいちいち反抗的な"
    },
    {
      "item_id": "cluster_55_east_city:0074CF42",
      "offset": 7655234,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ロイス大佐が"
    },
    {
      "item_id": "cluster_55_east_city:0074CF54",
      "offset": 7655252,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "前から気に入らなかったのさ"
    },
    {
      "item_id": "cluster_55_east_city:0074CF8C",
      "offset": 7655308,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それで、噂を口実に"
    },
    {
      "item_id": "cluster_55_east_city:0074CFA4",
      "offset": 7655332,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "資格剥奪ってことか…？"
    },
    {
