{
  "items": [
    {
      "item_id": "cluster_69_military:0076BEF8",
      "offset": 7782136,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "年頃なのはわかるが…"
    },
    {
      "item_id": "cluster_69_military:0076BF1C",
      "offset": 7782172,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そういうことをしては"
    },
    {
      "item_id": "cluster_69_military:0076BF36",
      "offset": 7782198,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イカンぞ！"
    },
    {
      "item_id": "cluster_69_military:0076BF58",
      "offset": 7782232,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、誤解だって！"
    },
    {
      "item_id": "cluster_69_military:0076BF72",
      "offset": 7782258,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "事故だって！"
    },
    {
      "item_id": "cluster_69_military:0076BF8E",
      "offset": 7782286,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐、灯りだ、灯り！"
    },
    {
      "item_id": "cluster_69_military:0076BFA8",
      "offset": 7782312,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "灯りをつけてくれよ！"
    },
    {
      "item_id": "cluster_69_military:0076C054",
      "offset": 7782484,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐、"
    },
    {
      "item_id": "cluster_69_military:0076C06C",
      "offset": 7782508,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "説明してもらえないか？"
    },
    {
      "item_id": "cluster_69_military:0076C094",
      "offset": 7782548,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああん？"
    },
    {
      "item_id": "cluster_69_military:0076C0A2",
      "offset": 7782562,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "説明しろって、何を？"
    },
    {
      "item_id": "cluster_69_military:0076C0CC",
      "offset": 7782604,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我々がここにいるワケをだ"
    },
    {
      "item_id": "cluster_69_military:0076C0F4",
      "offset": 7782644,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もとはといえば中佐、"
    },
    {
      "item_id": "cluster_69_military:0076C10E",
      "offset": 7782670,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "君が何かの音がするといって"
    },
    {
      "item_id": "cluster_69_military:0076C12E",
      "offset": 7782702,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの場に立ち止まった"
    },
    {
      "item_id": "cluster_69_military:0076C152",
      "offset": 7782738,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すると襲ってきたのは鉄球だ"
    },
    {
      "item_id": "cluster_69_military:0076C172",
      "offset": 7782770,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そして今度は君の指示で"
    },
    {
      "item_id": "cluster_69_military:0076C18E",
      "offset": 7782798,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "逃げ込んだ通路で、この有様"
    },
    {
      "item_id": "cluster_69_military:0076C1B8",
      "offset": 7782840,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ずいぶんと"
    },
    {
      "item_id": "cluster_69_military:0076C1C8",
      "offset": 7782856,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "タイミングのいいことだ"
    },
    {
      "item_id": "cluster_69_military:0076C1F4",
      "offset": 7782900,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "何が言いてぇんだ？"
    },
    {
      "item_id": "cluster_69_military:0076C21E",
      "offset": 7782942,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "単刀直入に言おう。"
    },
    {
      "item_id": "cluster_69_military:0076C236",
      "offset": 7782966,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私は君を疑っている、"
    },
    {
      "item_id": "cluster_69_military:0076C250",
      "offset": 7782992,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーの仲間ではないかとね"
    },
    {
      "item_id": "cluster_69_military:0076C282",
      "offset": 7783042,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前は信用していると"
    },
    {
      "item_id": "cluster_69_military:0076C29C",
      "offset": 7783068,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言いながら…"
    },
    {
      "item_id": "cluster_69_military:0076C2B8",
      "offset": 7783096,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ずっとオレ様をそういう目で"
    },
    {
      "item_id": "cluster_69_military:0076C2D8",
      "offset": 7783128,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "見ていたってわけかい？"
    },
    {
      "item_id": "cluster_69_military:0076C300",
      "offset": 7783168,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これだから軍の連中の"
    },
    {
      "item_id": "cluster_69_military:0076C31A",
      "offset": 7783194,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やり口は…"
    },
    {
      "item_id": "cluster_69_military:0076C33A",
      "offset": 7783226,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中佐、君もその軍の一員だ。"
    },
    {
      "item_id": "cluster_69_military:0076C35A",
      "offset": 7783258,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "君のその発言…問題になるぞ"
    },
    {
      "item_id": "cluster_69_military:0076C384",
      "offset": 7783300,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かつての君の戦友と同じ道を"
    },
    {
      "item_id": "cluster_69_military:0076C3A4",
      "offset": 7783332,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "歩むつもりか？"
    },
    {
      "item_id": "cluster_69_military:0076C3CA",
      "offset": 7783370,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ふっ…それもいいかもな"
    },
    {
      "item_id": "cluster_69_military:0076C3FE",
      "offset": 7783422,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐！"
    },
    {
      "item_id": "cluster_69_military:0076C416",
      "offset": 7783446,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分がなにを言ってるか"
    },
    {
      "item_id": "cluster_69_military:0076C432",
      "offset": 7783474,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わかってんのか！？"
    },
    {
      "item_id": "cluster_69_military:0076C45C",
      "offset": 7783516,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エド…ワリぃな。"
    },
    {
      "item_id": "cluster_69_military:0076C472",
      "offset": 7783538,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、いい加減…"
    },
    {
      "item_id": "cluster_69_military:0076C488",
      "offset": 7783560,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キレちまったよっ！"
    },
    {
      "item_id": "cluster_69_military:0076C4B2",
      "offset": 7783602,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すべてしゃべってやるよ！"
    },
    {
      "item_id": "cluster_69_military:0076C4D0",
      "offset": 7783632,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マスタング、てめぇが"
    },
    {
      "item_id": "cluster_69_military:0076C4EA",
      "offset": 7783658,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "知りてぇことをっ！"
    },
    {
      "item_id": "cluster_69_military:0076C50C",
      "offset": 7783692,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうさ、ロイス大佐を"
    },
    {
      "item_id": "cluster_69_military:0076C526",
      "offset": 7783718,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "脱走させたのはオレ様さ！"
    },
    {
      "item_id": "cluster_69_military:0076C556",
      "offset": 7783766,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…やはりそうか"
    },
    {
      "item_id": "cluster_69_military:0076C57C",
      "offset": 7783804,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの内乱が…"
    },
    {
      "item_id": "cluster_69_military:0076C58E",
      "offset": 7783822,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イシュヴァールの内乱が"
    },
    {
      "item_id": "cluster_69_military:0076C5AA",
      "offset": 7783850,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すべてを変えちまった"
    },
    {
      "item_id": "cluster_69_military:0076C5CE",
      "offset": 7783886,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ロイス大佐は、錬金術師が"
    },
    {
      "item_id": "cluster_69_military:0076C5EC",
      "offset": 7783916,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ただの兵器になってゆくことに"
    },
    {
      "item_id": "cluster_69_military:0076C60E",
      "offset": 7783950,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "苦しんだんだよ"
    },
    {
      "item_id": "cluster_69_military:0076C62C",
      "offset": 7783980,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "治癒錬成を研究してきた"
    },
    {
      "item_id": "cluster_69_military:0076C648",
      "offset": 7784008,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分の理想と"
    },
    {
      "item_id": "cluster_69_military:0076C65A",
      "offset": 7784026,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かけ離れてゆくことにな"
    },
    {
      "item_id": "cluster_69_military:0076C680",
      "offset": 7784064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、軍の上層部は"
    },
    {
      "item_id": "cluster_69_military:0076C698",
      "offset": 7784088,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ロイス大佐の具申を無視した！"
    },
    {
      "item_id": "cluster_69_military:0076C6BA",
      "offset": 7784122,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それだけならともかく…"
    },
    {
      "item_id": "cluster_69_military:0076C6E2",
      "offset": 7784162,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "奴ら、つまらん噂を流して、"
    },
    {
      "item_id": "cluster_69_military:0076C702",
      "offset": 7784194,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐の資格剥奪まで"
    },
    {
      "item_id": "cluster_69_military:0076C71A",
      "offset": 7784218,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "企みやがった！"
    },
    {
      "item_id": "cluster_69_military:0076C73A",
      "offset": 7784250,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…こんなことが許されて"
    },
    {
      "item_id": "cluster_69_military:0076C756",
      "offset": 7784278,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいのかよ"
    },
    {
      "item_id": "cluster_69_military:0076C778",
      "offset": 7784312,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、戦死を偽装し、"
    },
    {
      "item_id": "cluster_69_military:0076C794",
      "offset": 7784340,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "脱走させたか…"
    },
    {
      "item_id": "cluster_69_military:0076C7B8",
      "offset": 7784376,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だけど、あの人の"
    },
    {
      "item_id": "cluster_69_military:0076C7CE",
      "offset": 7784398,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "苦しんでる様を"
    },
    {
      "item_id": "cluster_69_military:0076C7E2",
      "offset": 7784418,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "見てらんなかったんだよ！"
    },
    {
      "item_id": "cluster_69_military:0076C812",
      "offset": 7784466,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…確かに、あの場にいた誰もが"
    },
    {
      "item_id": "cluster_69_military:0076C834",
      "offset": 7784500,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "正気を保っていることなど"
    },
    {
      "item_id": "cluster_69_military:0076C852",
      "offset": 7784530,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "できなかったかもしれない…"
    },
    {
      "item_id": "cluster_69_military:0076C8A2",
      "offset": 7784610,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、脱走が資格剥奪を"
    },
    {
      "item_id": "cluster_69_military:0076C8BE",
      "offset": 7784638,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "恨んでのことではなかったと"
    },
    {
      "item_id": "cluster_69_military:0076C8DE",
      "offset": 7784670,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言い切れるか？"
    },
    {
      "item_id": "cluster_69_military:0076C904",
      "offset": 7784708,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの人はそんな人じゃねぇ！"
    },
    {
      "item_id": "cluster_69_military:0076C924",
      "offset": 7784740,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "共に理想を語り合った仲だ！"
    },
    {
      "item_id": "cluster_69_military:0076C94E",
      "offset": 7784782,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術師よ、大衆のためにあれ"
    },
    {
      "item_id": "cluster_69_military:0076C970",
      "offset": 7784816,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その理想を追い求めた人だった"
    },
    {
      "item_id": "cluster_69_military:0076C9A4",
      "offset": 7784868,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、結果を見ろ！"
    },
    {
      "item_id": "cluster_69_military:0076C9BC",
      "offset": 7784892,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヤツはリンカーと名乗り、"
    },
    {
      "item_id": "cluster_69_military:0076C9DA",
      "offset": 7784922,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国を混乱に陥れようとしている"
    },
    {
      "item_id": "cluster_69_military:0076CA08",
      "offset": 7784968,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前のやったことが"
    },
    {
      "item_id": "cluster_69_military:0076CA20",
      "offset": 7784992,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かえって大衆を"
    },
    {
      "item_id": "cluster_69_military:0076CA34",
      "offset": 7785012,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "苦しめているんだ！"
    },
    {
      "item_id": "cluster_69_military:0076CA58",
      "offset": 7785048,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…大佐、もういいだろ。"
    },
    {
      "item_id": "cluster_69_military:0076CA74",
      "offset": 7785076,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐を責めたって"
    },
    {
      "item_id": "cluster_69_military:0076CA96",
      "offset": 7785110,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しかたないしさ…"
    },
    {
      "item_id": "cluster_69_military:0076CABE",
      "offset": 7785150,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ロイス大佐は「死んだ」んだ。"
    },
    {
      "item_id": "cluster_69_military:0076CAE0",
      "offset": 7785184,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それで、あの人はもう苦しまず"
    },
    {
      "item_id": "cluster_69_military:0076CB02",
      "offset": 7785218,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "平穏な日々を送れるはずだった"
    },
    {
      "item_id": "cluster_69_military:0076CB2E",
      "offset": 7785262,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それなのに…"
    },
    {
      "item_id": "cluster_69_military:0076CB40",
      "offset": 7785280,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの人はまたこっちに"
    },
    {
      "item_id": "cluster_69_military:0076CB5A",
      "offset": 7785306,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "戻ってきちまった"
    },
    {
      "item_id": "cluster_69_military:0076CB7C",
      "offset": 7785340,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…なんでなんだよ。"
    },
    {
      "item_id": "cluster_69_military:0076CB94",
      "offset": 7785364,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんで戻ってきたんだ！？"
    },
    {
      "item_id": "cluster_69_military:0076CBEC",
      "offset": 7785452,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どこへ行く？"
    },
    {
      "item_id": "cluster_69_military:0076CC10",
      "offset": 7785488,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分でやったことのケジメは"
    },
    {
      "item_id": "cluster_69_military:0076CC30",
      "offset": 7785520,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分でつける"
    },
    {
      "item_id": "cluster_69_military:0076CC52",
      "offset": 7785554,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケジメ…だと？"
    },
    {
      "item_id": "cluster_69_military:0076CC76",
      "offset": 7785590,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの日、オレ様のしたことが"
    },
    {
      "item_id": "cluster_69_military:0076CC96",
      "offset": 7785622,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "間違いだというのなら…"
    },
    {
      "item_id": "cluster_69_military:0076CCBC",
