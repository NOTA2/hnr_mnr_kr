{
  "items": [
    {
      "item_id": "cluster_71_save_menu:007716F0",
      "offset": 7804656,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "下水道でリンカーを探さなきゃ"
    },
    {
      "item_id": "cluster_71_save_menu:00771712",
      "offset": 7804690,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "下水道の入口は西側だよ"
    },
    {
      "item_id": "cluster_71_save_menu:00771748",
      "offset": 7804744,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっと下水道の奥に"
    },
    {
      "item_id": "cluster_71_save_menu:00771760",
      "offset": 7804768,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーがいるんだよ"
    },
    {
      "item_id": "cluster_71_save_menu:00771794",
      "offset": 7804820,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐、"
    },
    {
      "item_id": "cluster_71_save_menu:007717AC",
      "offset": 7804844,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大丈夫かな…"
    },
    {
      "item_id": "cluster_71_save_menu:007717D8",
      "offset": 7804888,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "東方軍司令部が"
    },
    {
      "item_id": "cluster_71_save_menu:007717EC",
      "offset": 7804908,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キメラに襲われてるんだ！"
    },
    {
      "item_id": "cluster_71_save_menu:0077180A",
      "offset": 7804938,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早く行かないと！"
    },
    {
      "item_id": "cluster_71_save_menu:0077183A",
      "offset": 7804986,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キメラがうじゃうじゃいるね。"
    },
    {
      "item_id": "cluster_71_save_menu:0077185C",
      "offset": 7805020,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "建物をまわりこんで、"
    },
    {
      "item_id": "cluster_71_save_menu:00771876",
      "offset": 7805046,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "司令部の裏口から入ろうか？"
    },
    {
      "item_id": "cluster_71_save_menu:007718B0",
      "offset": 7805104,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "仕方がないから、大佐の手帳を"
    },
    {
      "item_id": "cluster_71_save_menu:007718D2",
      "offset": 7805138,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "取りに行ってあげようよ"
    },
    {
      "item_id": "cluster_71_save_menu:00771908",
      "offset": 7805192,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キメラの親玉が"
    },
    {
      "item_id": "cluster_71_save_menu:0077191C",
      "offset": 7805212,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "練兵場にいるようだよ！"
    },
    {
      "item_id": "cluster_71_save_menu:00771952",
      "offset": 7805266,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "久しぶりにゆっくりできるね。"
    },
    {
      "item_id": "cluster_71_save_menu:00771974",
      "offset": 7805300,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イースト南側の宿屋に行こうよ"
    },
    {
      "item_id": "cluster_71_save_menu:007719B0",
      "offset": 7805360,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もうリンカーの居場所の"
    },
    {
      "item_id": "cluster_71_save_menu:007719CC",
      "offset": 7805388,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "情報は入ってるかな？"
    },
    {
      "item_id": "cluster_71_save_menu:007719E6",
      "offset": 7805414,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐のところにいってみよう"
    },
    {
      "item_id": "cluster_71_save_menu:00771A20",
      "offset": 7805472,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早くリンカーを捕まえなきゃ。"
    },
    {
      "item_id": "cluster_71_save_menu:00771A42",
      "offset": 7805506,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イーストシティ近くの"
    },
    {
      "item_id": "cluster_71_save_menu:00771A5C",
      "offset": 7805532,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "古城だったよね"
    },
    {
      "item_id": "cluster_71_save_menu:00771A8A",
      "offset": 7805578,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーは"
    },
    {
      "item_id": "cluster_71_save_menu:00771A9A",
      "offset": 7805594,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "城の奥にいるのかな？"
    },
    {
      "item_id": "cluster_71_save_menu:00771AB4",
      "offset": 7805620,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まずは進んでみようか…"
    },
    {
      "item_id": "cluster_71_save_menu:00771AEA",
      "offset": 7805674,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうして、あの人が？"
    },
    {
      "item_id": "cluster_71_save_menu:00771B04",
      "offset": 7805700,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…やっぱり、リンカーは"
    },
    {
      "item_id": "cluster_71_save_menu:00771B20",
      "offset": 7805728,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "「賢者の石」を！？"
    },
    {
      "item_id": "cluster_71_save_menu:00771B52",
      "offset": 7805778,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、石の７－６のカードで"
    },
    {
      "item_id": "cluster_71_save_menu:00771B74",
      "offset": 7805812,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いったい何をするつもりなの？"
    },
    {
      "item_id": "cluster_71_save_menu:00771BB0",
      "offset": 7805872,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "先をいそごう！"
    },
    {
      "item_id": "cluster_71_save_menu:00771C3C",
      "offset": 7806012,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ランディは軍の人が"
    },
    {
      "item_id": "cluster_71_save_menu:00771C54",
      "offset": 7806036,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "連れて行ったよ。"
    },
    {
      "item_id": "cluster_71_save_menu:00771C6A",
      "offset": 7806058,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクらは先に進もう"
    },
    {
      "item_id": "cluster_71_save_menu:00771CAA",
      "offset": 7806122,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "先をいそごう！"
    },
    {
      "item_id": "cluster_71_save_menu:00771CD8",
      "offset": 7806168,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "先をいそごう！"
    },
    {
      "item_id": "cluster_71_save_menu:00771CF8",
      "offset": 7806200,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "扉を壊すなら"
    },
    {
      "item_id": "cluster_71_save_menu:00771D0A",
      "offset": 7806218,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "金属の７－４のカードが"
    },
    {
      "item_id": "cluster_71_save_menu:00771D26",
      "offset": 7806246,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "必要だね"
    },
    {
      "item_id": "cluster_71_save_menu:00771D4E",
      "offset": 7806286,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、"
    },
    {
      "item_id": "cluster_71_save_menu:00771D5C",
      "offset": 7806300,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "先をいそごう！"
    },
    {
      "item_id": "cluster_71_save_menu:00771D8A",
      "offset": 7806346,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早く中佐を追わなきゃ！"
    },
    {
      "item_id": "cluster_71_save_menu:00771DC2",
      "offset": 7806402,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自然の６－４のカードで"
    },
    {
      "item_id": "cluster_71_save_menu:00771DDE",
      "offset": 7806430,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "壁に足場を作るんだよね！"
    },
    {
      "item_id": "cluster_71_save_menu:00771E16",
      "offset": 7806486,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっぱりマーティンス中佐は"
    },
    {
      "item_id": "cluster_71_save_menu:00771E36",
      "offset": 7806518,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "裏切り者なんかじゃなかった♪"
    },
    {
      "item_id": "cluster_71_save_menu:00771E58",
      "offset": 7806552,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクは信じてたよ"
    },
    {
      "item_id": "cluster_71_save_menu:00771E70",
      "offset": 7806576,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "メンバーも揃ったし、"
    },
    {
      "item_id": "cluster_71_save_menu:00771E8A",
      "offset": 7806602,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーのところへ急ごう！"
    },
    {
      "item_id": "cluster_71_save_menu:00771F26",
      "offset": 7806758,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アームストロング少佐、"
    },
    {
      "item_id": "cluster_71_save_menu:00771F42",
      "offset": 7806786,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中央軍司令部の中庭に"
    },
    {
      "item_id": "cluster_71_save_menu:00771F5C",
      "offset": 7806812,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "来いっていってたよね"
    },
    {
      "item_id": "cluster_71_save_menu:00771F92",
      "offset": 7806866,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、"
    },
    {
      "item_id": "cluster_71_save_menu:00771FA0",
      "offset": 7806880,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中庭で少佐が待ってるよ"
    },
    {
      "item_id": "cluster_71_save_menu:00771FD8",
      "offset": 7806936,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たくさん戦ったから"
    },
    {
      "item_id": "cluster_71_save_menu:00771FF0",
      "offset": 7806960,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "つかれたんじゃない？"
    },
    {
      "item_id": "cluster_71_save_menu:0077200A",
      "offset": 7806986,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セントラルの宿屋に泊まろうよ"
    },
    {
      "item_id": "cluster_71_save_menu:00772056",
      "offset": 7807062,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、エリシアちゃんのこと"
    },
    {
      "item_id": "cluster_71_save_menu:00772078",
      "offset": 7807096,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヒューズ中佐に知らせに"
    },
    {
      "item_id": "cluster_71_save_menu:00772094",
      "offset": 7807124,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行かないと！"
    },
    {
      "item_id": "cluster_71_save_menu:007720A8",
      "offset": 7807144,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっと軍法会議所にいるよ！"
    },
    {
      "item_id": "cluster_71_save_menu:007720E2",
      "offset": 7807202,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヒューズ中佐を追いかけよう！"
    },
    {
      "item_id": "cluster_71_save_menu:00772104",
      "offset": 7807236,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中佐の家は中央区画だよ"
    },
    {
      "item_id": "cluster_71_save_menu:0077213A",
      "offset": 7807290,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、"
    },
    {
      "item_id": "cluster_71_save_menu:00772148",
      "offset": 7807304,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早くエリシアちゃんを"
    },
    {
      "item_id": "cluster_71_save_menu:00772162",
      "offset": 7807330,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さがしにいこうよ！"
    },
    {
      "item_id": "cluster_71_save_menu:00772194",
      "offset": 7807380,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かくれんぼだったとはね♪"
    },
    {
      "item_id": "cluster_71_save_menu:007721B2",
      "offset": 7807410,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さ、エリシアちゃんを探そうよ"
    },
    {
      "item_id": "cluster_71_save_menu:007721E0",
      "offset": 7807456,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エリシア捜しフラグミス"
    },
    {
      "item_id": "cluster_71_save_menu:00772226",
      "offset": 7807526,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ハボック少尉…なんだか、"
    },
    {
      "item_id": "cluster_71_save_menu:00772244",
      "offset": 7807556,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すごくあやしかったね…"
    },
    {
      "item_id": "cluster_71_save_menu:00772260",
      "offset": 7807584,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "追いかけてみようか？"
    },
    {
      "item_id": "cluster_71_save_menu:00772294",
      "offset": 7807636,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ハボック少尉、"
    },
    {
      "item_id": "cluster_71_save_menu:007722A8",
      "offset": 7807656,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "東側区画へ行ったみたい"
    },
    {
      "item_id": "cluster_71_save_menu:007722D0",
      "offset": 7807696,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ハボック追跡フラグミス"
    },
    {
      "item_id": "cluster_71_save_menu:007722FA",
      "offset": 7807738,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、どこへ行こうか？"
    },
    {
      "item_id": "cluster_71_save_menu:00772396",
      "offset": 7807894,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、最上階へいそごう！"
    },
    {
      "item_id": "cluster_71_save_menu:007723D2",
      "offset": 7807954,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんのようだね、"
    },
    {
      "item_id": "cluster_71_save_menu:007723FA",
      "offset": 7807994,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなに私と話したいのか？"
    },
    {
      "item_id": "cluster_71_save_menu:0077244E",
      "offset": 7808078,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここはボクの出番なんだから"
    },
    {
      "item_id": "cluster_71_save_menu:0077246E",
      "offset": 7808110,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "取らないでくださいよ！"
    },
    {
      "item_id": "cluster_71_save_menu:0077249C",
      "offset": 7808156,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オホン、オホン！"
    },
    {
      "item_id": "cluster_71_save_menu:007724B2",
      "offset": 7808178,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、最上階へいそごう！"
    },
    {
      "item_id": "cluster_71_save_menu:00772502",
      "offset": 7808258,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、最上階へいそごう！"
    },
    {
      "item_id": "cluster_71_save_menu:0077253C",
      "offset": 7808316,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、最上階へいそごう！"
    },
    {
      "item_id": "cluster_71_save_menu:00772576",
      "offset": 7808374,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、最上階へいそごう！"
    },
    {
      "item_id": "cluster_71_save_menu:007725B0",
      "offset": 7808432,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、いよいよだね！"
    },
    {
      "item_id": "cluster_71_save_menu:007725D8",
      "offset": 7808472,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、目指すは古城だよ！"
    },
    {
      "item_id": "cluster_71_save_menu:00772662",
      "offset": 7808610,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中央軍司令部の受付で"
    },
    {
      "item_id": "cluster_71_save_menu:0077267C",
      "offset": 7808636,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "書類をもらってくるんだったね"
    },
    {
      "item_id": "cluster_71_save_menu:007726B8",
      "offset": 7808696,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ブラッドレイ大総統に"
    },
    {
      "item_id": "cluster_71_save_menu:007726D2",
      "offset": 7808722,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この書類を届けなきゃ"
    },
    {
      "item_id": "cluster_71_save_menu:00772706",
      "offset": 7808774,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今度はこの書類を"
    },
    {
      "item_id": "cluster_71_save_menu:0077271C",
      "offset": 7808796,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "東方軍司令部の受付に"
    },
    {
      "item_id": "cluster_71_save_menu:00772736",
      "offset": 7808822,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "届けるんっだったね"
    },
    {
      "item_id": "cluster_71_save_menu:00772768",
      "offset": 7808872,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さ、この書類を大総統に"
    },
    {
      "item_id": "cluster_71_save_menu:00772784",
      "offset": 7808900,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "届けたら終わりだね。"
    },
    {
      "item_id": "cluster_71_save_menu:0077279E",
      "offset": 7808926,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ホントに終わるのかな…"
    },
    {
