{
  "items": [
    {
      "item_id": "cluster_70_military:0076EB3A",
      "offset": 7793466,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言っている"
    },
    {
      "item_id": "cluster_70_military:0076EB60",
      "offset": 7793504,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "逃げろ、コニィ！"
    },
    {
      "item_id": "cluster_70_military:0076EB8C",
      "offset": 7793548,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私…逃げません。"
    },
    {
      "item_id": "cluster_70_military:0076EBA6",
      "offset": 7793574,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これでも私は"
    },
    {
      "item_id": "cluster_70_military:0076EBB8",
      "offset": 7793592,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術師のつもりだから"
    },
    {
      "item_id": "cluster_70_military:0076EBEA",
      "offset": 7793642,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、エドもアルも…"
    },
    {
      "item_id": "cluster_70_military:0076EC06",
      "offset": 7793670,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "みんなを守るための錬金術を…"
    },
    {
      "item_id": "cluster_70_military:0076EC30",
      "offset": 7793712,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私は使います！"
    },
    {
      "item_id": "cluster_70_military:0076ECA6",
      "offset": 7793830,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍の狗どもめ！"
    },
    {
      "item_id": "cluster_70_military:0076ECBE",
      "offset": 7793854,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "残らず消滅するがいいっ！"
    },
    {
      "item_id": "cluster_70_military:0076ED02",
      "offset": 7793922,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…セラフィ兄さん、"
    },
    {
      "item_id": "cluster_70_military:0076ED1E",
      "offset": 7793950,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう後戻りは"
    },
    {
      "item_id": "cluster_70_military:0076ED30",
      "offset": 7793968,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "できないんですか？"
    },
    {
      "item_id": "cluster_70_military:0076ED5C",
      "offset": 7794012,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍の狗が、"
    },
    {
      "item_id": "cluster_70_military:0076ED6C",
      "offset": 7794028,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私に悔い改めよと言うか！？"
    },
    {
      "item_id": "cluster_70_military:0076EDA0",
      "offset": 7794080,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍の…狗。"
    },
    {
      "item_id": "cluster_70_military:0076EDB4",
      "offset": 7794100,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私のことまで…哀しいよ"
    },
    {
      "item_id": "cluster_70_military:0076EDE0",
      "offset": 7794144,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ふん。クズどもが、"
    },
    {
      "item_id": "cluster_70_military:0076EDF8",
      "offset": 7794168,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そろいもそろって私の理想を"
    },
    {
      "item_id": "cluster_70_military:0076EE18",
      "offset": 7794200,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "邪魔するつもりか！？"
    },
    {
      "item_id": "cluster_70_military:0076EE48",
      "offset": 7794248,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "べつにてめぇの理想なんか"
    },
    {
      "item_id": "cluster_70_military:0076EE66",
      "offset": 7794278,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうだっていいんだよ！"
    },
    {
      "item_id": "cluster_70_military:0076EE82",
      "offset": 7794306,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "許せねぇ、理由が３つ"
    },
    {
      "item_id": "cluster_70_military:0076EEAC",
      "offset": 7794348,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "最期まで、てめぇを信じた"
    },
    {
      "item_id": "cluster_70_military:0076EECA",
      "offset": 7794378,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐を"
    },
    {
      "item_id": "cluster_70_military:0076EEE2",
      "offset": 7794402,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "愚か者だと言ったことが１つ！"
    },
    {
      "item_id": "cluster_70_military:0076EF14",
      "offset": 7794452,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そしてもう１つ、"
    },
    {
      "item_id": "cluster_70_military:0076EF2A",
      "offset": 7794474,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それはオレたち兄弟が"
    },
    {
      "item_id": "cluster_70_military:0076EF44",
      "offset": 7794500,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "てめぇと同類だと言ったこと！"
    },
    {
      "item_id": "cluster_70_military:0076EF76",
      "offset": 7794550,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そして最後の１つは…"
    },
    {
      "item_id": "cluster_70_military:0076EFA0",
      "offset": 7794592,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たった一人の妹なのに"
    },
    {
      "item_id": "cluster_70_military:0076EFBA",
      "offset": 7794618,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…そんなコニィを"
    },
    {
      "item_id": "cluster_70_military:0076EFD0",
      "offset": 7794640,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "泣かせたことだ！"
    },
    {
      "item_id": "cluster_70_military:0076F0D6",
      "offset": 7794902,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…バカな。"
    },
    {
      "item_id": "cluster_70_military:0076F0E6",
      "offset": 7794918,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この私が敗れる、だ、と？"
    },
    {
      "item_id": "cluster_70_military:0076F114",
      "offset": 7794964,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言ったろ。"
    },
    {
      "item_id": "cluster_70_military:0076F124",
      "offset": 7794980,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術は魔法でもないし、"
    },
    {
      "item_id": "cluster_70_military:0076F142",
      "offset": 7795010,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "無尽蔵の力でもない"
    },
    {
      "item_id": "cluster_70_military:0076F164",
      "offset": 7795044,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "無理な錬成は、"
    },
    {
      "item_id": "cluster_70_military:0076F178",
      "offset": 7795064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "必ず己に跳ね返ってくるのさ"
    },
    {
      "item_id": "cluster_70_military:0076F1AE",
      "offset": 7795118,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…等価交換。"
    },
    {
      "item_id": "cluster_70_military:0076F1C4",
      "offset": 7795140,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どんなに優れた錬金術師でも"
    },
    {
      "item_id": "cluster_70_military:0076F1E4",
      "offset": 7795172,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この法則だけは超えられない "
    },
    {
      "item_id": "cluster_70_military:0076F218",
      "offset": 7795224,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まして、てめぇは大事なものを"
    },
    {
      "item_id": "cluster_70_military:0076F23A",
      "offset": 7795258,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "次々に失っちまった"
    },
    {
      "item_id": "cluster_70_military:0076F25C",
      "offset": 7795292,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "代価に支払えるものなんて、"
    },
    {
      "item_id": "cluster_70_military:0076F27C",
      "offset": 7795324,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう残っていなかったんだよ"
    },
    {
      "item_id": "cluster_70_military:0076F2B2",
      "offset": 7795378,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セラフィ兄さん…"
    },
    {
      "item_id": "cluster_70_military:0076F2C8",
      "offset": 7795400,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私と兄さんはどこで道を "
    },
    {
      "item_id": "cluster_70_military:0076F2E6",
      "offset": 7795430,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "間違えてしまったのかな"
    },
    {
      "item_id": "cluster_70_military:0076F30C",
      "offset": 7795468,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "小さい頃、スタート地点は"
    },
    {
      "item_id": "cluster_70_military:0076F32A",
      "offset": 7795498,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "同じだったのに…、"
    },
    {
      "item_id": "cluster_70_military:0076F342",
      "offset": 7795522,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これじゃ哀しすぎる"
    },
    {
      "item_id": "cluster_70_military:0076F370",
      "offset": 7795568,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "敗れた上に…"
    },
    {
      "item_id": "cluster_70_military:0076F382",
      "offset": 7795586,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "子供たちに…"
    },
    {
      "item_id": "cluster_70_military:0076F394",
      "offset": 7795604,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "説教までされるとはな"
    },
    {
      "item_id": "cluster_70_military:0076F3C4",
      "offset": 7795652,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "子供だからこそ、"
    },
    {
      "item_id": "cluster_70_military:0076F3DA",
      "offset": 7795674,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "見えるものがある。"
    },
    {
      "item_id": "cluster_70_military:0076F3F6",
      "offset": 7795702,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そう言ったはず…"
    },
    {
      "item_id": "cluster_70_military:0076F416",
      "offset": 7795734,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ロイス大佐、あなたは"
    },
    {
      "item_id": "cluster_70_military:0076F430",
      "offset": 7795760,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍と別の道を"
    },
    {
      "item_id": "cluster_70_military:0076F442",
      "offset": 7795778,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "歩もうとしながら…"
    },
    {
      "item_id": "cluster_70_military:0076F464",
      "offset": 7795812,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "結局はそんな軍の大人に"
    },
    {
      "item_id": "cluster_70_military:0076F480",
      "offset": 7795840,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なってしまっていたのだ。"
    },
    {
      "item_id": "cluster_70_military:0076F4B0",
      "offset": 7795888,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私も他人は笑えぬが"
    },
    {
      "item_id": "cluster_70_military:0076F4DC",
      "offset": 7795932,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私の理想は…"
    },
    {
      "item_id": "cluster_70_military:0076F4EE",
      "offset": 7795950,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "間違っていたのか…？"
    },
    {
      "item_id": "cluster_70_military:0076F508",
      "offset": 7795976,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "認めない…認めない…"
    },
    {
      "item_id": "cluster_70_military:0076F530",
      "offset": 7796016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "認めるものかーーー！！"
    },
    {
      "item_id": "cluster_70_military:0076F7C4",
      "offset": 7796676,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セラフィ兄さん！！"
    },
    {
      "item_id": "cluster_70_military:0076F7F2",
      "offset": 7796722,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ママ…ママ。"
    },
    {
      "item_id": "cluster_70_military:0076F80A",
      "offset": 7796746,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクね、ママのために…"
    },
    {
      "item_id": "cluster_70_military:0076F82A",
      "offset": 7796778,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "平和な世界を作ってみせるよ"
    },
    {
      "item_id": "cluster_70_military:0076F858",
      "offset": 7796824,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう誰も泣くことのない…"
    },
    {
      "item_id": "cluster_70_military:0076F87A",
      "offset": 7796858,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "みんなが幸せになれる世界。"
    },
    {
      "item_id": "cluster_70_military:0076F89E",
      "offset": 7796894,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術の勉強をして…"
    },
    {
      "item_id": "cluster_70_military:0076F8C6",
      "offset": 7796934,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師になって…"
    },
    {
      "item_id": "cluster_70_military:0076F8E6",
      "offset": 7796966,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そしたらママ、ほめてくれる？"
    },
    {
      "item_id": "cluster_70_military:0076F91E",
      "offset": 7797022,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…うん。"
    },
    {
      "item_id": "cluster_70_military:0076F930",
      "offset": 7797040,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ママね、セラフィのこと、"
    },
    {
      "item_id": "cluster_70_military:0076F952",
      "offset": 7797074,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いっぱいほめてあげるわ"
    },
    {
      "item_id": "cluster_70_military:0076F982",
      "offset": 7797122,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…よかっ"
    },
    {
      "item_id": "cluster_70_military:0076F9BE",
      "offset": 7797182,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セラフィ兄さん！！"
    },
    {
      "item_id": "cluster_70_military:0076F9DA",
      "offset": 7797210,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "置いていかないでよ。"
    },
    {
      "item_id": "cluster_70_military:0076F9F8",
      "offset": 7797240,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "また一緒に暮らそうよ"
    },
    {
      "item_id": "cluster_70_military:0076FA20",
      "offset": 7797280,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ほら、ママが待ってるよ。"
    },
    {
      "item_id": "cluster_70_military:0076FA42",
      "offset": 7797314,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "故郷に帰ろう。"
    },
    {
      "item_id": "cluster_70_military:0076FA5A",
      "offset": 7797338,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから目を覚ましてよっ！"
    },
    {
      "item_id": "cluster_70_military:0076FA86",
      "offset": 7797382,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セラフィ兄さん…"
    },
    {
      "item_id": "cluster_70_military:0076FAB6",
      "offset": 7797430,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まだリンカーにも"
    },
    {
      "item_id": "cluster_70_military:0076FACC",
      "offset": 7797452,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "残ってたんだね"
    },
    {
      "item_id": "cluster_70_military:0076FAF2",
      "offset": 7797490,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああ。幼い日、"
    },
    {
      "item_id": "cluster_70_military:0076FB0A",
      "offset": 7797514,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分が理想を思い描いた"
    },
    {
      "item_id": "cluster_70_military:0076FB26",
      "offset": 7797542,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "スタート地点の記憶が…"
    },
    {
      "item_id": "cluster_70_military:0076FB68",
      "offset": 7797608,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ようやく終わったな"
    },
    {
      "item_id": "cluster_70_military:0076FB9A",
      "offset": 7797658,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだか後味はあんまし、"
    },
    {
      "item_id": "cluster_70_military:0076FBB8",
      "offset": 7797688,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "よくないけどね"
    },
    {
      "item_id": "cluster_70_military:0076FBDC",
      "offset": 7797724,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お互いに"
    },
    {
      "item_id": "cluster_70_military:0076FBEA",
      "offset": 7797738,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍の狗になってしまった故の"
    },
    {
      "item_id": "cluster_70_military:0076FC0A",
      "offset": 7797770,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "業というヤツだ…"
    },
    {
      "item_id": "cluster_70_military:0076FC30",
      "offset": 7797808,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それでもオレたち兄弟は、"
    },
    {
      "item_id": "cluster_70_military:0076FC4E",
      "offset": 7797838,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍の狗と呼ばれようとも…"
    },
    {
      "item_id": "cluster_70_military:0076FC7E",
      "offset": 7797886,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "成し遂げなければ、"
    },
    {
      "item_id": "cluster_70_military:0076FC96",
      "offset": 7797910,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ならないことがある、"
    },
    {
      "item_id": "cluster_70_military:0076FCC0",
      "offset": 7797952,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の、君は道を誤るなよ"
    },
    {
      "item_id": "cluster_70_military:0076FCE8",
      "offset": 7797992,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私は君を"
    },
    {
      "item_id": "cluster_70_military:0076FCF6",
      "offset": 7798006,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "討ちたくはないからな"
    },
    {
      "item_id": "cluster_70_military:0076FD22",
      "offset": 7798050,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレだって、大佐となんか"
    },
    {
      "item_id": "cluster_70_military:0076FD40",
      "offset": 7798080,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "戦いたかないさ"
    },
    {
      "item_id": "cluster_70_military:0076FD64",
      "offset": 7798116,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ならば、お互いに"
    },
    {
      "item_id": "cluster_70_military:0076FD7A",
      "offset": 7798138,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気をつけるとするか"
    },
    {
      "item_id": "cluster_70_military:0076FDD4",
      "offset": 7798228,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐…我々、軍の人間に"
    },
    {
      "item_id": "cluster_70_military:0076FDF0",
      "offset": 7798256,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーの罪を裁く権利は"
    },
    {
      "item_id": "cluster_70_military:0076FE0E",
      "offset": 7798286,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あったのでしょうか？"
    },
    {
      "item_id": "cluster_70_military:0076FE4E",
      "offset": 7798350,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "裁いたのは我々ではない…"
    },
    {
      "item_id": "cluster_70_military:0076FE76",
      "offset": 7798390,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あそこにいる兄弟さ"
    },
    {
      "item_id": "cluster_70_military:0076FEA6",
      "offset": 7798438,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "彼らはその十字架を背負い、"
    },
    {
      "item_id": "cluster_70_military:0076FEC6",
      "offset": 7798470,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これからも旅を続ける"
    },
    {
      "item_id": "cluster_70_military:0076FEEE",
      "offset": 7798510,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そう…あの背中にある十字架に"
    },
    {
      "item_id": "cluster_70_military:0076FF10",
      "offset": 7798544,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "様々な想いをのせて…"
    }
  ]
}