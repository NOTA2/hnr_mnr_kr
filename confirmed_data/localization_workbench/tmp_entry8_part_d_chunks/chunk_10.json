{
  "items": [
    {
      "item_id": "cluster_61_military:0075CA68",
      "offset": 7719528,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "敵討ちなど、"
    },
    {
      "item_id": "cluster_61_military:0075CA7A",
      "offset": 7719546,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私の趣味ではないのだがな"
    },
    {
      "item_id": "cluster_61_military:0075CAA4",
      "offset": 7719588,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あのバカ者に化けて出られても"
    },
    {
      "item_id": "cluster_61_military:0075CAC6",
      "offset": 7719622,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "寝覚めが悪いからな…"
    },
    {
      "item_id": "cluster_61_military:0075CB08",
      "offset": 7719688,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もとより承知！"
    },
    {
      "item_id": "cluster_61_military:0075CB20",
      "offset": 7719712,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐の死出に"
    },
    {
      "item_id": "cluster_61_military:0075CB3E",
      "offset": 7719742,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我輩の拳を手向けましょうぞ！"
    },
    {
      "item_id": "cluster_61_military:0075CB94",
      "offset": 7719828,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "待って、兄さん！"
    },
    {
      "item_id": "cluster_61_military:0075CBAE",
      "offset": 7719854,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィの様子が…"
    },
    {
      "item_id": "cluster_61_military:0075CBC6",
      "offset": 7719878,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "変だよ。"
    },
    {
      "item_id": "cluster_61_military:0075CC08",
      "offset": 7719944,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィ？"
    },
    {
      "item_id": "cluster_61_military:0075CC3C",
      "offset": 7719996,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…なんでなの？"
    },
    {
      "item_id": "cluster_61_military:0075CC60",
      "offset": 7720032,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィ…"
    },
    {
      "item_id": "cluster_61_military:0075CC74",
      "offset": 7720052,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "泣いてる…？"
    },
    {
      "item_id": "cluster_61_military:0075CC96",
      "offset": 7720086,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんで、リンカーが、"
    },
    {
      "item_id": "cluster_61_military:0075CCB4",
      "offset": 7720116,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんで…"
    },
    {
      "item_id": "cluster_61_military:0075CCC4",
      "offset": 7720132,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この写真を"
    },
    {
      "item_id": "cluster_61_military:0075CCD4",
      "offset": 7720148,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "持ってるの…？"
    },
    {
      "item_id": "cluster_61_military:0075CD52",
      "offset": 7720274,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この写真が唯一の兄さんとの"
    },
    {
      "item_id": "cluster_61_military:0075CD72",
      "offset": 7720306,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "絆なのに…"
    },
    {
      "item_id": "cluster_61_military:0075CD84",
      "offset": 7720324,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それをなんで"
    },
    {
      "item_id": "cluster_61_military:0075CD96",
      "offset": 7720342,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーが…？"
    },
    {
      "item_id": "cluster_61_military:0075CDBA",
      "offset": 7720378,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…説明してください。"
    },
    {
      "item_id": "cluster_61_military:0075CDD8",
      "offset": 7720408,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あなたは…"
    },
    {
      "item_id": "cluster_61_military:0075CDE8",
      "offset": 7720424,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっぱり、兄さんなんですか？"
    },
    {
      "item_id": "cluster_61_military:0075CE72",
      "offset": 7720562,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オマエは…"
    },
    {
      "item_id": "cluster_61_military:0075CE98",
      "offset": 7720600,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィ…？"
    },
    {
      "item_id": "cluster_61_military:0075CEBC",
      "offset": 7720636,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんなら、なんで？"
    },
    {
      "item_id": "cluster_61_military:0075CEDA",
      "offset": 7720666,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんなの、言ってたことと、"
    },
    {
      "item_id": "cluster_61_military:0075CEFA",
      "offset": 7720698,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ぜんぜん違うっ！"
    },
    {
      "item_id": "cluster_61_military:0075CF20",
      "offset": 7720736,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんはいつでも優しくて、"
    },
    {
      "item_id": "cluster_61_military:0075CF40",
      "offset": 7720768,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰にでも親切で…"
    },
    {
      "item_id": "cluster_61_military:0075CF60",
      "offset": 7720800,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私がいじめられたときは、"
    },
    {
      "item_id": "cluster_61_military:0075CF7E",
      "offset": 7720830,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まっさきに駆けつけてくれて"
    },
    {
      "item_id": "cluster_61_military:0075CFA8",
      "offset": 7720872,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "傷ついた人を救う力だって、"
    },
    {
      "item_id": "cluster_61_military:0075CFC8",
      "offset": 7720904,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私に治癒錬成を"
    },
    {
      "item_id": "cluster_61_military:0075CFDA",
      "offset": 7720922,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "教えてくれて…"
    },
    {
      "item_id": "cluster_61_military:0075CFFC",
      "offset": 7720956,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術師よ、大衆のためにあれ"
    },
    {
      "item_id": "cluster_61_military:0075D01E",
      "offset": 7720990,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あれは…"
    },
    {
      "item_id": "cluster_61_military:0075D030",
      "offset": 7721008,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ウソだったんですか！？"
    },
    {
      "item_id": "cluster_61_military:0075D06E",
      "offset": 7721070,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前は誰だ？"
    },
    {
      "item_id": "cluster_61_military:0075D084",
      "offset": 7721092,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なぜ私を苦しめる！？"
    },
    {
      "item_id": "cluster_61_military:0075D09E",
      "offset": 7721118,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なぜ私の頭の中を混乱させる！"
    },
    {
      "item_id": "cluster_61_military:0075D0D4",
      "offset": 7721172,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰って…"
    },
    {
      "item_id": "cluster_61_military:0075D0E6",
      "offset": 7721190,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私のこと、忘れたの？"
    },
    {
      "item_id": "cluster_61_military:0075D104",
      "offset": 7721220,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ウソでしょ？"
    },
    {
      "item_id": "cluster_61_military:0075D14E",
      "offset": 7721294,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうか…すべてウソ。"
    },
    {
      "item_id": "cluster_61_military:0075D170",
      "offset": 7721328,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "みんなして、私のこと"
    },
    {
      "item_id": "cluster_61_military:0075D18A",
      "offset": 7721354,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だましてるのよね？"
    },
    {
      "item_id": "cluster_61_military:0075D1AC",
      "offset": 7721388,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "後でみんなで"
    },
    {
      "item_id": "cluster_61_military:0075D1BE",
      "offset": 7721406,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "笑い話にするんでしょ？"
    },
    {
      "item_id": "cluster_61_military:0075D1DE",
      "offset": 7721438,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ひどいな"
    },
    {
      "item_id": "cluster_61_military:0075D204",
      "offset": 7721476,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…コニィ、違う"
    },
    {
      "item_id": "cluster_61_military:0075D246",
      "offset": 7721542,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドも…アルも…"
    },
    {
      "item_id": "cluster_61_military:0075D260",
      "offset": 7721568,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんが見つかったのなら、"
    },
    {
      "item_id": "cluster_61_military:0075D280",
      "offset": 7721600,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "普通に教えてくれていいのに"
    },
    {
      "item_id": "cluster_61_military:0075D2AA",
      "offset": 7721642,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんの話をしたときから、"
    },
    {
      "item_id": "cluster_61_military:0075D2CA",
      "offset": 7721674,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "みんなで、こっそり"
    },
    {
      "item_id": "cluster_61_military:0075D2E2",
      "offset": 7721698,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "探してくれてたのよね？"
    },
    {
      "item_id": "cluster_61_military:0075D308",
      "offset": 7721736,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それで私を驚かせようと"
    },
    {
      "item_id": "cluster_61_military:0075D324",
      "offset": 7721764,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんなことしたんでしょ。"
    },
    {
      "item_id": "cluster_61_military:0075D346",
      "offset": 7721798,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…子供なんだから"
    },
    {
      "item_id": "cluster_61_military:0075D366",
      "offset": 7721830,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんまで巻き込んで、"
    },
    {
      "item_id": "cluster_61_military:0075D382",
      "offset": 7721858,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんな手の込んだ事を"
    },
    {
      "item_id": "cluster_61_military:0075D39C",
      "offset": 7721884,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しなくても…"
    },
    {
      "item_id": "cluster_61_military:0075D3BE",
      "offset": 7721918,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…これじゃ私ひとり、"
    },
    {
      "item_id": "cluster_61_military:0075D3DC",
      "offset": 7721948,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "バカみたいじゃない"
    },
    {
      "item_id": "cluster_61_military:0075D40A",
      "offset": 7721994,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…話を聞けっ！"
    },
    {
      "item_id": "cluster_61_military:0075D44A",
      "offset": 7722058,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィ、現実を見るんだ！"
    },
    {
      "item_id": "cluster_61_military:0075D46C",
      "offset": 7722092,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "目をそらすな！"
    },
    {
      "item_id": "cluster_61_military:0075D4C6",
      "offset": 7722182,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…イヤ。"
    },
    {
      "item_id": "cluster_61_military:0075D4DC",
      "offset": 7722204,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんな現実なんて、"
    },
    {
      "item_id": "cluster_61_military:0075D4F4",
      "offset": 7722228,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "見たくないわ！"
    },
    {
      "item_id": "cluster_61_military:0075D51C",
      "offset": 7722268,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんは、"
    },
    {
      "item_id": "cluster_61_military:0075D530",
      "offset": 7722288,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私の中の兄さんは…"
    },
    {
      "item_id": "cluster_61_military:0075D550",
      "offset": 7722320,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんなんじゃないっ！"
    },
    {
      "item_id": "cluster_61_military:0075D580",
      "offset": 7722368,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "軍の狗どもが…"
    },
    {
      "item_id": "cluster_61_military:0075D598",
      "offset": 7722392,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前たちが、"
    },
    {
      "item_id": "cluster_61_military:0075D5AA",
      "offset": 7722410,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私を苦しめるのだな…"
    },
    {
      "item_id": "cluster_61_military:0075D5D6",
      "offset": 7722454,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん…なんでそんな目を…"
    },
    {
      "item_id": "cluster_61_military:0075D5FA",
      "offset": 7722490,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "昔みたいに優しい目をしてよ"
    },
    {
      "item_id": "cluster_61_military:0075D642",
      "offset": 7722562,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ウソ、ウソ、ウソ。"
    },
    {
      "item_id": "cluster_61_military:0075D660",
      "offset": 7722592,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰か、全部ウソだって"
    },
    {
      "item_id": "cluster_61_military:0075D67A",
      "offset": 7722618,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言ってよっ！！"
    },
    {
      "item_id": "cluster_61_military:0075D6B0",
      "offset": 7722672,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この苦しみ…"
    },
    {
      "item_id": "cluster_61_military:0075D6C6",
      "offset": 7722694,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…我が力をもって"
    },
    {
      "item_id": "cluster_61_military:0075D6DC",
      "offset": 7722716,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "取り除いてくれる！"
    },
    {
      "item_id": "cluster_61_military:0075D768",
      "offset": 7722856,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きゃーっ！"
    },
    {
      "item_id": "cluster_61_military:0075D7FC",
      "offset": 7723004,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アル、コニィは！？"
    },
    {
      "item_id": "cluster_61_military:0075D820",
      "offset": 7723040,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大丈夫！"
    },
    {
      "item_id": "cluster_61_military:0075D82E",
      "offset": 7723054,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気を失ってるだけだよ。"
    },
    {
      "item_id": "cluster_61_military:0075D84A",
      "offset": 7723082,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクの中にいれば安全だから"
    },
    {
      "item_id": "cluster_61_military:0075D89E",
      "offset": 7723166,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気絶していなくとも、"
    },
    {
      "item_id": "cluster_61_military:0075D8C4",
      "offset": 7723204,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっきの状態では、とても"
    },
    {
      "item_id": "cluster_61_military:0075D8E2",
      "offset": 7723234,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "戦力にはならんだろうな"
    },
    {
      "item_id": "cluster_61_military:0075D910",
      "offset": 7723280,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あのような婦女子に、"
    },
    {
      "item_id": "cluster_61_military:0075D92A",
      "offset": 7723306,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "戦わせるのは、"
    },
    {
      "item_id": "cluster_61_military:0075D93E",
      "offset": 7723326,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我輩も忍びありませんな"
    },
    {
      "item_id": "cluster_61_military:0075D976",
      "offset": 7723382,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なら、オレたちだけで"
    },
    {
      "item_id": "cluster_61_military:0075D990",
      "offset": 7723408,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "カタをつけちまえば"
    },
    {
      "item_id": "cluster_61_military:0075D9A8",
      "offset": 7723432,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいんだろ、大佐！"
    },
    {
      "item_id": "cluster_61_military:0075DA26",
      "offset": 7723558,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ぐはっ…"
    },
    {
      "item_id": "cluster_61_military:0075DA40",
      "offset": 7723584,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "止まった…？"
    },
    {
      "item_id": "cluster_61_military:0075DA76",
      "offset": 7723638,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…まるで魔法だな"
    },
    {
      "item_id": "cluster_61_military:0075DA96",
      "offset": 7723670,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の、目の前で起きている"
    },
    {
      "item_id": "cluster_61_military:0075DAB4",
      "offset": 7723700,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "光景を信じられるか？"
    },
    {
      "item_id": "cluster_61_military:0075DAE4",
      "offset": 7723748,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "信じたかないけど、"
    },
    {
      "item_id": "cluster_61_military:0075DAFC",
      "offset": 7723772,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "目の前で見せられると、"
    },
    {
      "item_id": "cluster_61_military:0075DB18",
      "offset": 7723800,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "信じないわけにいかないよな"
    },
    {
      "item_id": "cluster_61_military:0075DB4E",
      "offset": 7723854,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、賢者の石もなしで、"
    },
    {
      "item_id": "cluster_61_military:0075DB6C",
      "offset": 7723884,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これだけの錬成をするなんて"
    },
    {
      "item_id": "cluster_61_military:0075DB8C",
      "offset": 7723916,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "不可能だよ、兄さん！"
    },
    {
      "item_id": "cluster_61_military:0075DBB6",
      "offset": 7723958,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それじゃ、どうやって…？"
    },
    {
      "item_id": "cluster_61_military:0075DBE6",
      "offset": 7724006,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボ、ボクに聞かれても…"
    },
    {
      "item_id": "cluster_61_military:0075DC02",
      "offset": 7724034,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんにもわからないのに、"
    },
    {
      "item_id": "cluster_61_military:0075DC22",
      "offset": 7724066,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わかるわけないよ"
    },
    {
      "item_id": "cluster_61_military:0075DC44",
      "offset": 7724100,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術は魔法や奇跡じゃない。"
    },
    {
      "item_id": "cluster_61_military:0075DC66",
      "offset": 7724134,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すべてが等価交換だ"
    },
    {
      "item_id": "cluster_61_military:0075DC88",
      "offset": 7724168,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうあがいたって、"
    },
    {
      "item_id": "cluster_61_military:0075DCA0",
      "offset": 7724192,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この法則はくつがえせない"
    }
  ]
}