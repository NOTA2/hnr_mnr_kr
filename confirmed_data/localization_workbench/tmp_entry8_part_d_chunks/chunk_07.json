{
  "items": [
    {
      "item_id": "cluster_59_military:00756634",
      "offset": 7693876,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ニッヒー！"
    },
    {
      "item_id": "cluster_59_military:00756644",
      "offset": 7693892,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なーんちゃって！"
    },
    {
      "item_id": "cluster_59_military:0075665A",
      "offset": 7693914,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ビックリした？"
    },
    {
      "item_id": "cluster_59_military:00756680",
      "offset": 7693952,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "えっ！？"
    },
    {
      "item_id": "cluster_59_military:00756696",
      "offset": 7693974,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだって！？"
    },
    {
      "item_id": "cluster_59_military:007566BA",
      "offset": 7694010,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しんみりしちゃったりするのは"
    },
    {
      "item_id": "cluster_59_military:007566DC",
      "offset": 7694044,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あたしらしくないっしょ？"
    },
    {
      "item_id": "cluster_59_military:00756706",
      "offset": 7694086,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも今の話は、"
    },
    {
      "item_id": "cluster_59_military:0075671A",
      "offset": 7694106,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ウソじゃないからね！"
    },
    {
      "item_id": "cluster_59_military:00756734",
      "offset": 7694132,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっつけちゃうぞー！"
    },
    {
      "item_id": "cluster_59_military:00756814",
      "offset": 7694356,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ところで兄さん、"
    },
    {
      "item_id": "cluster_59_military:0075682A",
      "offset": 7694378,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "本来の目的は覚えてるよね？"
    },
    {
      "item_id": "cluster_59_military:00756852",
      "offset": 7694418,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカー、だろ？"
    },
    {
      "item_id": "cluster_59_military:0075687A",
      "offset": 7694458,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "良かったー。"
    },
    {
      "item_id": "cluster_59_military:0075688C",
      "offset": 7694476,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もし本当にリンカーのこと"
    },
    {
      "item_id": "cluster_59_military:007568AA",
      "offset": 7694506,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "忘れてたらどうしようかと…"
    },
    {
      "item_id": "cluster_59_military:007568DE",
      "offset": 7694558,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それじゃ、さっさと進もうぜ"
    },
    {
      "item_id": "cluster_59_military:00756908",
      "offset": 7694600,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だいぶ奥まで進んできたんだ。"
    },
    {
      "item_id": "cluster_59_military:0075692A",
      "offset": 7694634,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そろそろゴールも"
    },
    {
      "item_id": "cluster_59_military:00756940",
      "offset": 7694656,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "近いんじゃないか？"
    },
    {
      "item_id": "cluster_59_military:0075696A",
      "offset": 7694698,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だといいんだけどね"
    },
    {
      "item_id": "cluster_59_military:00756982",
      "offset": 7694722,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だけど、リンカーのもとに"
    },
    {
      "item_id": "cluster_59_military:007569A0",
      "offset": 7694752,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たどりついても…"
    },
    {
      "item_id": "cluster_59_military:007569C6",
      "offset": 7694790,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだ、エド、その顔は。"
    },
    {
      "item_id": "cluster_59_military:007569E4",
      "offset": 7694820,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "急に弱気になったのかよ"
    },
    {
      "item_id": "cluster_59_military:00756A12",
      "offset": 7694866,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だ、誰が！"
    },
    {
      "item_id": "cluster_59_military:00756A2E",
      "offset": 7694894,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "けどさ、前に戦ったとき"
    },
    {
      "item_id": "cluster_59_military:00756A4A",
      "offset": 7694922,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まったく歯が立たなかったから"
    },
    {
      "item_id": "cluster_59_military:00756A7E",
      "offset": 7694974,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ま、なるようになるさ…"
    },
    {
      "item_id": "cluster_59_military:00756AD0",
      "offset": 7695056,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…兄さん。"
    },
    {
      "item_id": "cluster_59_military:00756AE0",
      "offset": 7695072,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もし「賢者の石」が"
    },
    {
      "item_id": "cluster_59_military:00756AF8",
      "offset": 7695096,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーの手にあったら…"
    },
    {
      "item_id": "cluster_59_military:00756B22",
      "offset": 7695138,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…だよな"
    },
    {
      "item_id": "cluster_59_military:00756B5E",
      "offset": 7695198,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄弟二人で秘密の話か？"
    },
    {
      "item_id": "cluster_59_military:00756B7A",
      "offset": 7695226,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "感心せんな"
    },
    {
      "item_id": "cluster_59_military:00756B9C",
      "offset": 7695260,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気にしないで。"
    },
    {
      "item_id": "cluster_59_military:00756BB0",
      "offset": 7695280,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "作戦会議ってヤツだから"
    },
    {
      "item_id": "cluster_59_military:00756BF6",
      "offset": 7695350,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドワード・エルリック！"
    },
    {
      "item_id": "cluster_59_military:00756C14",
      "offset": 7695380,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その作戦会議に、"
    },
    {
      "item_id": "cluster_59_military:00756C2A",
      "offset": 7695402,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我輩もぜひに…"
    },
    {
      "item_id": "cluster_59_military:00756C50",
      "offset": 7695440,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わーっ！"
    },
    {
      "item_id": "cluster_59_military:00756C5E",
      "offset": 7695454,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "少佐はいいって"
    },
    {
      "item_id": "cluster_59_military:00756C8A",
      "offset": 7695498,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんと！"
    },
    {
      "item_id": "cluster_59_military:00756C98",
      "offset": 7695512,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我輩を信頼してくれては"
    },
    {
      "item_id": "cluster_59_military:00756CB4",
      "offset": 7695540,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おらぬのだな…哀しいぞ！"
    },
    {
      "item_id": "cluster_59_military:00756CDE",
      "offset": 7695582,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いや…べつに少佐を"
    },
    {
      "item_id": "cluster_59_military:00756CF6",
      "offset": 7695606,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "信頼してないわけじゃ"
    },
    {
      "item_id": "cluster_59_military:00756D10",
      "offset": 7695632,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ありませんから"
    },
    {
      "item_id": "cluster_59_military:00756D32",
      "offset": 7695666,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんにせよ、リンカーとは"
    },
    {
      "item_id": "cluster_59_military:00756D50",
      "offset": 7695696,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "苦戦するだろう"
    },
    {
      "item_id": "cluster_59_military:00756D6E",
      "offset": 7695726,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "問題は…"
    },
    {
      "item_id": "cluster_59_military:00756D94",
      "offset": 7695764,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マーティンス中佐が、"
    },
    {
      "item_id": "cluster_59_military:00756DAE",
      "offset": 7695790,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どちらにつくのか、ですか？"
    },
    {
      "item_id": "cluster_59_military:00756DDE",
      "offset": 7695838,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ホークアイ中尉、"
    },
    {
      "item_id": "cluster_59_military:00756DF4",
      "offset": 7695860,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうハッキリ言うな"
    },
    {
      "item_id": "cluster_59_military:00756E1C",
      "offset": 7695900,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中佐を監視しろと"
    },
    {
      "item_id": "cluster_59_military:00756E32",
      "offset": 7695922,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おっしゃったのは、"
    },
    {
      "item_id": "cluster_59_military:00756E4A",
      "offset": 7695946,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐ですが？"
    },
    {
      "item_id": "cluster_59_military:00756E66",
      "offset": 7695974,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そういう意味で、"
    },
    {
      "item_id": "cluster_59_military:00756E7C",
      "offset": 7695996,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "監視をさせているのでは？"
    },
    {
      "item_id": "cluster_59_military:00756EB0",
      "offset": 7696048,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが、あいつの言葉を、"
    },
    {
      "item_id": "cluster_59_military:00756ECC",
      "offset": 7696076,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ロイス大佐は「死んだ」"
    },
    {
      "item_id": "cluster_59_military:00756EE8",
      "offset": 7696104,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "という言葉を信じたくもある"
    },
    {
      "item_id": "cluster_59_military:00756F12",
      "offset": 7696146,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "できれば、最後まで"
    },
    {
      "item_id": "cluster_59_military:00756F2A",
      "offset": 7696170,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "信じさせて欲しいものだがな"
    },
    {
      "item_id": "cluster_59_military:00756F5A",
      "offset": 7696218,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ですね"
    },
    {
      "item_id": "cluster_59_military:00756FAE",
      "offset": 7696302,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうしたんですか！？"
    },
    {
      "item_id": "cluster_59_military:00756FC8",
      "offset": 7696328,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドたちも、マスタング大佐も"
    },
    {
      "item_id": "cluster_59_military:00756FEA",
      "offset": 7696362,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コソコソと…"
    },
    {
      "item_id": "cluster_59_military:00757008",
      "offset": 7696392,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "仲間に秘密があっては"
    },
    {
      "item_id": "cluster_59_military:00757022",
      "offset": 7696418,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いけないと思います！"
    },
    {
      "item_id": "cluster_59_military:0075704E",
      "offset": 7696462,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ、ああ…そうだな。"
    },
    {
      "item_id": "cluster_59_military:00757068",
      "offset": 7696488,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気をつけよう"
    },
    {
      "item_id": "cluster_59_military:00757086",
      "offset": 7696518,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ、ああ…わかったよ"
    },
    {
      "item_id": "cluster_59_military:007570B2",
      "offset": 7696562,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それでいいんです。"
    },
    {
      "item_id": "cluster_59_military:007570CA",
      "offset": 7696586,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それじゃ、先に進みましょう！"
    },
    {
      "item_id": "cluster_59_military:007571A2",
      "offset": 7696802,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "扉を壊して進むなら"
    },
    {
      "item_id": "cluster_59_military:007571BA",
      "offset": 7696826,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "金属の７－４のカードが必要だ"
    },
    {
      "item_id": "cluster_59_military:007571E6",
      "offset": 7696870,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうするかな？"
    },
    {
      "item_id": "cluster_59_military:0075729E",
      "offset": 7697054,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いくぜ！"
    },
    {
      "item_id": "cluster_59_military:0075730E",
      "offset": 7697166,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっぱこれが手っ取り早いな！"
    },
    {
      "item_id": "cluster_59_military:00757356",
      "offset": 7697238,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "このカードじゃダメだな。"
    },
    {
      "item_id": "cluster_59_military:00757374",
      "offset": 7697268,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここの扉を壊すには"
    },
    {
      "item_id": "cluster_59_military:0075738C",
      "offset": 7697292,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "金属の７－４のカードが必要だ"
    },
    {
      "item_id": "cluster_59_military:007573DE",
      "offset": 7697374,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "別の方法でも考えるか"
    },
    {
      "item_id": "cluster_59_military:0075743A",
      "offset": 7697466,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、あっちになにか"
    },
    {
      "item_id": "cluster_59_military:00757456",
      "offset": 7697494,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あるみたいだよ…"
    },
    {
      "item_id": "cluster_59_military:0075749C",
      "offset": 7697564,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あのボタンを押せってか？"
    },
    {
      "item_id": "cluster_59_military:007574BA",
      "offset": 7697594,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やれやれ、ここまでくると"
    },
    {
      "item_id": "cluster_59_military:007574D8",
      "offset": 7697624,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいかげん怒るのも疲れるな…"
    },
    {
      "item_id": "cluster_59_military:00757504",
      "offset": 7697668,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬成で扉を壊した方が"
    },
    {
      "item_id": "cluster_59_military:0075751E",
      "offset": 7697694,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早いんじゃないか？"
    },
    {
      "item_id": "cluster_59_military:00757542",
      "offset": 7697730,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、ほら…"
    },
    {
      "item_id": "cluster_59_military:00757554",
      "offset": 7697748,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一応、ひとんちだし…"
    },
    {
      "item_id": "cluster_59_military:0075757A",
      "offset": 7697786,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ま、好きにするさ。"
    },
    {
      "item_id": "cluster_59_military:00757592",
      "offset": 7697810,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "扉をぶっ壊すなら、"
    },
    {
      "item_id": "cluster_59_military:007575AA",
      "offset": 7697834,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "金属の７－４ってとこだな…"
    },
    {
      "item_id": "cluster_59_military:00757662",
      "offset": 7698018,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにも起きないね…？"
    },
    {
      "item_id": "cluster_60_military:00758C38",
      "offset": 7703608,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…止まれ"
    },
    {
      "item_id": "cluster_60_military:00758C46",
      "offset": 7703622,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "何か変な音が聞こえねえか？"
    },
    {
      "item_id": "cluster_60_military:00758C7C",
      "offset": 7703676,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレには聞こえなかったけど？"
    },
    {
      "item_id": "cluster_60_military:00758CAA",
      "offset": 7703722,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この先に何かワナが"
    },
    {
      "item_id": "cluster_60_military:00758CC2",
      "offset": 7703746,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あるのかもしれませんぞ"
    },
    {
      "item_id": "cluster_60_military:00758CEE",
      "offset": 7703790,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ちょっくら見てくらぁ"
    },
    {
      "item_id": "cluster_60_military:00758DD6",
      "offset": 7704022,
      "source_group": "registry_a_entry8_prefixed_texts",
