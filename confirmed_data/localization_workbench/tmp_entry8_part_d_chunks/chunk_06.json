    {
      "item_id": "cluster_59_military:007565CE",
      "offset": 7693774,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "許さないんだから…"
    },
    {
      "item_id": "cluster_59_military:00756610",
      "offset": 7693840,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケイト…"
