    {
      "item_id": "cluster_59_military:00756488",
      "offset": 7693448,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そういうヤツは、"
    },
    {
      "item_id": "cluster_59_military:0075649E",
      "offset": 7693470,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あたし…許さないよ"
    },
    {
      "item_id": "cluster_59_military:007564C0",
      "offset": 7693504,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お兄ちゃんは、"
    },
    {
      "item_id": "cluster_59_military:007564D4",
      "offset": 7693524,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ひとりぼっちだったあたしに"
    },
    {
      "item_id": "cluster_59_military:007564F4",
      "offset": 7693556,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "優しくしてくれた…"
    },
    {
      "item_id": "cluster_59_military:00756516",
      "offset": 7693590,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あたしの作った人形を"
    },
    {
      "item_id": "cluster_59_military:00756530",
      "offset": 7693616,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いつもほめてくれた…"
    },
    {
      "item_id": "cluster_59_military:00756554",
      "offset": 7693652,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ランディはバカだけど、"
