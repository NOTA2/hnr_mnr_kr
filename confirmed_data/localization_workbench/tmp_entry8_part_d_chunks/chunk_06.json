{
  "items": [
    {
      "item_id": "cluster_58_military:00753EE8",
      "offset": 7683816,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…あやつもリンカーも"
    },
    {
      "item_id": "cluster_58_military:00753F02",
      "offset": 7683842,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "根っからの悪人とは"
    },
    {
      "item_id": "cluster_58_military:00753F1A",
      "offset": 7683866,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "思えませんな…"
    },
    {
      "item_id": "cluster_58_military:00753F3A",
      "offset": 7683898,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だが軍に対し弓引くものを"
    },
    {
      "item_id": "cluster_58_military:00753F58",
      "offset": 7683928,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "野放しにはできまい…"
    },
    {
      "item_id": "cluster_58_military:00753FA2",
      "offset": 7684002,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さってと！"
    },
    {
      "item_id": "cluster_58_military:00753FB2",
      "offset": 7684018,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うるさいヤツは倒したし、"
    },
    {
      "item_id": "cluster_58_military:00753FD0",
      "offset": 7684048,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "残るは…"
    },
    {
      "item_id": "cluster_58_military:00753FEA",
      "offset": 7684074,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケイトのヤツだな！"
    },
    {
      "item_id": "cluster_58_military:00754014",
      "offset": 7684116,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカー…じゃないの？"
    },
    {
      "item_id": "cluster_58_military:00754042",
      "offset": 7684162,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーは後回しだって"
    },
    {
      "item_id": "cluster_58_military:0075405E",
      "offset": 7684190,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言ってんだろ、アル"
    },
    {
      "item_id": "cluster_58_military:00754088",
      "offset": 7684232,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ああ、なんだか"
    },
    {
      "item_id": "cluster_58_military:0075409E",
      "offset": 7684254,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どんどん間違った方向に"
    },
    {
      "item_id": "cluster_58_military:007540BA",
      "offset": 7684282,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "進んでいくような気が…"
    },
    {
      "item_id": "cluster_58_military:007540E4",
      "offset": 7684324,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なに、心配するな。"
    },
    {
      "item_id": "cluster_58_military:007540FC",
      "offset": 7684348,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ああは言ってるが"
    },
    {
      "item_id": "cluster_58_military:00754112",
      "offset": 7684370,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やるべきことはわかっている"
    },
    {
      "item_id": "cluster_58_military:0075414A",
      "offset": 7684426,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マスタング大佐は、エドのこと"
    },
    {
      "item_id": "cluster_58_military:0075416C",
      "offset": 7684460,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "信頼しているんですね。"
    },
    {
      "item_id": "cluster_58_military:00754188",
      "offset": 7684488,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐のこと尊敬してしまいます"
    },
    {
      "item_id": "cluster_58_military:007541D4",
      "offset": 7684564,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おお、これぞ、戦友同士の"
    },
    {
      "item_id": "cluster_58_military:007541F2",
      "offset": 7684594,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "同志愛というもの！"
    },
    {
      "item_id": "cluster_58_military:0075420A",
      "offset": 7684618,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我輩も感動いたしましたぞ！"
    },
    {
      "item_id": "cluster_58_military:00754242",
      "offset": 7684674,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…オ、オホン。"
    },
    {
      "item_id": "cluster_58_military:00754256",
      "offset": 7684694,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "とにかく先に進もうじゃないか"
    },
    {
      "item_id": "cluster_58_military:0075428A",
      "offset": 7684746,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにをガラにもなく"
    },
    {
      "item_id": "cluster_58_military:007542A2",
      "offset": 7684770,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "照れてんだよ、"
    },
    {
      "item_id": "cluster_58_military:007542B6",
      "offset": 7684790,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大佐さんよぉ！"
    },
    {
      "item_id": "cluster_58_military:007542DA",
      "offset": 7684826,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うるさい。"
    },
    {
      "item_id": "cluster_58_military:007542EA",
      "offset": 7684842,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいから、先に進むぞ！"
    },
    {
      "item_id": "cluster_58_military:0075441C",
      "offset": 7685148,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それでカタつけてやる！"
    },
    {
      "item_id": "cluster_58_military:00754442",
      "offset": 7685186,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "準備はいいか？"
    },
    {
      "item_id": "cluster_58_military:00754538",
      "offset": 7685432,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケイト、待ってろよ～"
    },
    {
      "item_id": "cluster_58_military:00754580",
      "offset": 7685504,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "このカードじゃダメだ"
    },
    {
      "item_id": "cluster_58_military:007545AC",
      "offset": 7685548,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "石の７－６を作ればいいんだね"
    },
    {
      "item_id": "cluster_58_military:007545F6",
      "offset": 7685622,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "石の７－６を作ればいいんだね"
    },
    {
      "item_id": "cluster_58_military:0075465C",
      "offset": 7685724,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだこれは…？"
    },
    {
      "item_id": "cluster_58_military:0075467E",
      "offset": 7685758,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにって、"
    },
    {
      "item_id": "cluster_58_military:0075468E",
      "offset": 7685774,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "床が抜けてるんでしょ？"
    },
    {
      "item_id": "cluster_58_military:007546AA",
      "offset": 7685802,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "このままじゃ通れないね"
    },
    {
      "item_id": "cluster_58_military:007546DA",
      "offset": 7685850,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ムキー！ケイトのヤツ！"
    },
    {
      "item_id": "cluster_58_military:007546F6",
      "offset": 7685878,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どこまでオレをバカにすれば"
    },
    {
      "item_id": "cluster_58_military:00754716",
      "offset": 7685910,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気がすむんだ！"
    },
    {
      "item_id": "cluster_58_military:00754742",
      "offset": 7685954,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケイトがやったわけじゃ"
    },
    {
      "item_id": "cluster_58_military:0075475E",
      "offset": 7685982,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ないと思うけど…"
    },
    {
      "item_id": "cluster_58_military:00754780",
      "offset": 7686016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレたちはパズルを"
    },
    {
      "item_id": "cluster_58_military:00754798",
      "offset": 7686040,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やりにきたんじゃねーぞ！"
    },
    {
      "item_id": "cluster_58_military:007547B6",
      "offset": 7686070,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう付き合ってらんねぇ！"
    },
    {
      "item_id": "cluster_58_military:007547E4",
      "offset": 7686116,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アル、石の７－６のカードだ！"
    },
    {
      "item_id": "cluster_58_military:00754806",
      "offset": 7686150,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんな飛び石なんか、"
    },
    {
      "item_id": "cluster_58_military:00754820",
      "offset": 7686176,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一発でカタつけてやる！"
    },
    {
      "item_id": "cluster_59_military:00755CB4",
      "offset": 7691444,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いったいいつになったら"
    },
    {
      "item_id": "cluster_59_military:00755CD0",
      "offset": 7691472,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケイトのところに着くんだ？"
    },
    {
      "item_id": "cluster_59_military:00755CFC",
      "offset": 7691516,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、兄さん、"
    },
    {
      "item_id": "cluster_59_military:00755D12",
      "offset": 7691538,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "探す相手が違うって…"
    },
    {
      "item_id": "cluster_59_military:00755D3E",
      "offset": 7691582,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あたしのこと、誰か呼んだー？"
    },
    {
      "item_id": "cluster_59_military:00755D60",
      "offset": 7691616,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ちゃはっ！"
    },
    {
      "item_id": "cluster_59_military:00755D70",
      "offset": 7691632,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "モテる女は辛いなー"
    },
    {
      "item_id": "cluster_59_military:00755DC4",
      "offset": 7691716,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだあ。"
    },
    {
      "item_id": "cluster_59_military:00755DD4",
      "offset": 7691732,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鋼の錬金術師と、"
    },
    {
      "item_id": "cluster_59_military:00755DEA",
      "offset": 7691754,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヨロイくんたちか"
    },
    {
      "item_id": "cluster_59_military:00755E5E",
      "offset": 7691870,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "カッコイイ男の子だと"
    },
    {
      "item_id": "cluster_59_military:00755E78",
      "offset": 7691896,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "良かったのにな…"
    },
    {
      "item_id": "cluster_59_military:00755E8E",
      "offset": 7691918,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "チビッコは眼中にないから"
    },
    {
      "item_id": "cluster_59_military:00755EBE",
      "offset": 7691966,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "チ、チビッコ…"
    },
    {
      "item_id": "cluster_59_military:00755ED2",
      "offset": 7691986,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう怒ったぞ！"
    },
    {
      "item_id": "cluster_59_military:00755EF2",
      "offset": 7692018,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あ、コラ、どこに行く！"
    },
    {
      "item_id": "cluster_59_military:00755F26",
      "offset": 7692070,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "眼中にないって言わなかった？"
    },
    {
      "item_id": "cluster_59_military:00755F48",
      "offset": 7692104,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "つまんないから、帰るの"
    },
    {
      "item_id": "cluster_59_military:00755F76",
      "offset": 7692150,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの…ケイト、キミって、"
    },
    {
      "item_id": "cluster_59_military:00755F94",
      "offset": 7692180,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクらを倒せと"
    },
    {
      "item_id": "cluster_59_military:00755FA8",
      "offset": 7692200,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーに命令されてるんじゃ"
    },
    {
      "item_id": "cluster_59_military:00755FD6",
      "offset": 7692246,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あー、そういえばお兄ちゃん、"
    },
    {
      "item_id": "cluster_59_military:00755FF8",
      "offset": 7692280,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなこと言ってたっけ。"
    },
    {
      "item_id": "cluster_59_military:00756016",
      "offset": 7692310,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、つまんないしなー"
    },
    {
      "item_id": "cluster_59_military:0075604A",
      "offset": 7692362,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "つまんなかろうが、"
    },
    {
      "item_id": "cluster_59_military:00756062",
      "offset": 7692386,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "戦ってもらう！"
    },
    {
      "item_id": "cluster_59_military:00756076",
      "offset": 7692406,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレはお前を許さん！"
    },
    {
      "item_id": "cluster_59_military:007560A0",
      "offset": 7692448,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "許さないって…"
    },
    {
      "item_id": "cluster_59_military:007560B4",
      "offset": 7692468,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あたし、何かしたっけ？"
    },
    {
      "item_id": "cluster_59_military:007560E8",
      "offset": 7692520,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケイト、それはいけません。"
    },
    {
      "item_id": "cluster_59_military:00756108",
      "offset": 7692552,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドが傷ついてるのは、"
    },
    {
      "item_id": "cluster_59_military:00756124",
      "offset": 7692580,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "事実ですからね"
    },
    {
      "item_id": "cluster_59_military:00756150",
      "offset": 7692624,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィ…"
    },
    {
      "item_id": "cluster_59_military:0075615E",
      "offset": 7692638,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレの心の傷を"
    },
    {
      "item_id": "cluster_59_military:00756172",
      "offset": 7692658,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わかってくれるのか"
    },
    {
      "item_id": "cluster_59_military:0075619A",
      "offset": 7692698,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たとえエドが"
    },
    {
      "item_id": "cluster_59_military:007561AC",
      "offset": 7692716,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "本当にちっちゃくて、"
    },
    {
      "item_id": "cluster_59_military:007561C6",
      "offset": 7692742,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "豆粒って呼ばれてても…"
    },
    {
      "item_id": "cluster_59_military:007561EC",
      "offset": 7692780,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "本人が気にしてることを"
    },
    {
      "item_id": "cluster_59_military:00756208",
      "offset": 7692808,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言っちゃいけません！"
    },
    {
      "item_id": "cluster_59_military:0075623A",
      "offset": 7692858,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お前が言ってるじゃねーかっ！"
    },
    {
      "item_id": "cluster_59_military:0075626E",
      "offset": 7692910,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "い、いや…これはものの"
    },
    {
      "item_id": "cluster_59_military:0075628A",
      "offset": 7692938,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "例えってヤツで…てへっ"
    },
    {
      "item_id": "cluster_59_military:007562BE",
      "offset": 7692990,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "話はそれくらいでいいか？"
    },
    {
      "item_id": "cluster_59_military:007562E6",
      "offset": 7693030,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まあ、エドが小さかろうが、"
    },
    {
      "item_id": "cluster_59_military:00756306",
      "offset": 7693062,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ミジンコだろうが、事実だから"
    },
    {
      "item_id": "cluster_59_military:00756328",
      "offset": 7693096,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうでもいいんだけどな…"
    },
    {
      "item_id": "cluster_59_military:0075637E",
      "offset": 7693182,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "できればおとなしく、"
    },
    {
      "item_id": "cluster_59_military:00756398",
      "offset": 7693208,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーのもとまで"
    },
    {
      "item_id": "cluster_59_military:007563B0",
      "offset": 7693232,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "案内してくれねぇか？"
    },
    {
      "item_id": "cluster_59_military:007563E2",
      "offset": 7693282,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お兄ちゃんの…ところ？"
    },
    {
      "item_id": "cluster_59_military:00756404",
      "offset": 7693316,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それはできない相談ってヤツ？"
    },
    {
      "item_id": "cluster_59_military:00756426",
      "offset": 7693350,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だってさ…"
    },
    {
      "item_id": "cluster_59_military:00756446",
      "offset": 7693382,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その目、お兄ちゃんを"
    },
    {
      "item_id": "cluster_59_military:00756460",
      "offset": 7693408,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "傷つけようとしてる目だよ"
