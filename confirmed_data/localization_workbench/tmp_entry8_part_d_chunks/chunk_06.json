    {
      "item_id": "cluster_59_military:0075658E",
      "offset": 7693710,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "楽しかったんだよ…"
    },
    {
      "item_id": "cluster_59_military:007565B0",
      "offset": 7693744,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それを壊そうとするヤツは"
