{
  "items": [
    {
      "item_id": "cluster_61_military:0075DCC8",
      "offset": 7724232,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "つまり…"
    },
    {
      "item_id": "cluster_61_military:0075DCD6",
      "offset": 7724246,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それに見合うだけのものを"
    },
    {
      "item_id": "cluster_61_military:0075DCF4",
      "offset": 7724276,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "等価交換したんだ"
    },
    {
      "item_id": "cluster_61_military:0075DD1C",
      "offset": 7724316,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…バカな。"
    },
    {
      "item_id": "cluster_61_military:0075DD2C",
      "offset": 7724332,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これほどの錬成に"
    },
    {
      "item_id": "cluster_61_military:0075DD42",
      "offset": 7724354,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "見合うものなど…"
    },
    {
      "item_id": "cluster_61_military:0075DD68",
      "offset": 7724392,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっきのリンカーの反応、"
    },
    {
      "item_id": "cluster_61_military:0075DD86",
      "offset": 7724422,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "変だったろ？"
    },
    {
      "item_id": "cluster_61_military:0075DDA8",
      "offset": 7724456,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーの…"
    },
    {
      "item_id": "cluster_61_military:0075DDBA",
      "offset": 7724474,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コーニッシュに対する"
    },
    {
      "item_id": "cluster_61_military:0075DDD4",
      "offset": 7724500,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アレか？"
    },
    {
      "item_id": "cluster_61_military:0075DDF2",
      "offset": 7724530,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いくら生き別れたからって"
    },
    {
      "item_id": "cluster_61_military:0075DE10",
      "offset": 7724560,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "妹のことをああも完全に"
    },
    {
      "item_id": "cluster_61_military:0075DE2C",
      "offset": 7724588,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "忘れちまうもんか？"
    },
    {
      "item_id": "cluster_61_military:0075DE52",
      "offset": 7724626,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "最初は過去を認めたくない"
    },
    {
      "item_id": "cluster_61_military:0075DE70",
      "offset": 7724656,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "芝居かと思ったけど…"
    },
    {
      "item_id": "cluster_61_military:0075DE9C",
      "offset": 7724700,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "何が言いたい？"
    },
    {
      "item_id": "cluster_61_military:0075DEB4",
      "offset": 7724724,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…まさか"
    },
    {
      "item_id": "cluster_61_military:0075DED8",
      "offset": 7724760,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そのまさかさ。"
    },
    {
      "item_id": "cluster_61_military:0075DEEC",
      "offset": 7724780,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーは一番守りたかった "
    },
    {
      "item_id": "cluster_61_military:0075DF0E",
      "offset": 7724814,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大切なもの、その記憶…"
    },
    {
      "item_id": "cluster_61_military:0075DF34",
      "offset": 7724852,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いや、その存在を刻み込んだ、"
    },
    {
      "item_id": "cluster_61_military:0075DF56",
      "offset": 7724886,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分の魂を、"
    },
    {
      "item_id": "cluster_61_military:0075DF6A",
      "offset": 7724906,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一番大切な部分を"
    },
    {
      "item_id": "cluster_61_military:0075DF80",
      "offset": 7724928,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "持っていかれちまったんだ！"
    },
    {
      "item_id": "cluster_61_military:0075DFB6",
      "offset": 7724982,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "民衆を守る力を手に入れ、"
    },
    {
      "item_id": "cluster_61_military:0075DFD4",
      "offset": 7725012,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その引き換えに"
    },
    {
      "item_id": "cluster_61_military:0075DFE8",
      "offset": 7725032,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "最愛の妹の記憶を失うか"
    },
    {
      "item_id": "cluster_61_military:0075E014",
      "offset": 7725076,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そして今もあの力を使うたびに"
    },
    {
      "item_id": "cluster_61_military:0075E036",
      "offset": 7725110,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "自分の中の大切なものを"
    },
    {
      "item_id": "cluster_61_military:0075E052",
      "offset": 7725138,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "失い続けている…"
    },
    {
      "item_id": "cluster_61_military:0075E084",
      "offset": 7725188,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…皮肉なものね。"
    },
    {
      "item_id": "cluster_61_military:0075E09A",
      "offset": 7725210,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "守る力を得る代わりに"
    },
    {
      "item_id": "cluster_61_military:0075E0B4",
      "offset": 7725236,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大切なものを失うなんて"
    },
    {
      "item_id": "cluster_61_military:0075E0DC",
      "offset": 7725276,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…ボクたちと似てる。"
    },
    {
      "item_id": "cluster_61_military:0075E0F6",
      "offset": 7725302,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "母さんを取り戻すために"
    },
    {
      "item_id": "cluster_61_military:0075E112",
      "offset": 7725330,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大きな力、人体錬成を…"
    },
    {
      "item_id": "cluster_61_military:0075E140",
      "offset": 7725376,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アル、似てるなんて言うな！"
    },
    {
      "item_id": "cluster_61_military:0075E170",
      "offset": 7725424,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たしかにオレたちは"
    },
    {
      "item_id": "cluster_61_military:0075E188",
      "offset": 7725448,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "間違っていた。"
    },
    {
      "item_id": "cluster_61_military:0075E19C",
      "offset": 7725468,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お互いに大切なものを失った"
    },
    {
      "item_id": "cluster_61_military:0075E1CA",
      "offset": 7725514,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だけど…"
    },
    {
      "item_id": "cluster_61_military:0075E1DC",
      "offset": 7725532,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "リンカーとだけは、"
    },
    {
      "item_id": "cluster_61_military:0075E1F4",
      "offset": 7725556,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一緒にするな！"
    },
    {
      "item_id": "cluster_61_military:0075E236",
      "offset": 7725622,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ぐっ…くっ…"
    },
    {
      "item_id": "cluster_61_military:0075E24E",
      "offset": 7725646,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "く……ふふふ…"
    },
    {
      "item_id": "cluster_61_military:0075E264",
      "offset": 7725668,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "違わないな。"
    },
    {
      "item_id": "cluster_61_military:0075E27A",
      "offset": 7725690,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術師ならばわかるだろう。"
    },
    {
      "item_id": "cluster_61_military:0075E29C",
      "offset": 7725724,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "目の前の可能性には抗えない"
    },
    {
      "item_id": "cluster_61_military:0075E2C6",
      "offset": 7725766,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たとえ禁忌であろうとも、"
    },
    {
      "item_id": "cluster_61_military:0075E2E4",
      "offset": 7725796,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それが望みをかなえる"
    },
    {
      "item_id": "cluster_61_military:0075E2FE",
      "offset": 7725822,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "唯一の可能性だとしたら？"
    },
    {
      "item_id": "cluster_61_military:0075E32E",
      "offset": 7725870,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ためらわず手を染めるのだ。"
    },
    {
      "item_id": "cluster_61_military:0075E352",
      "offset": 7725906,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドワード・エルリック、"
    },
    {
      "item_id": "cluster_61_military:0075E370",
      "offset": 7725936,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "君も私と同じなのだ！"
    },
    {
      "item_id": "cluster_61_military:0075E3A6",
      "offset": 7725990,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…違うっ！"
    },
    {
      "item_id": "cluster_61_military:0075E3C8",
      "offset": 7726024,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "違わぬ！"
    },
    {
      "item_id": "cluster_61_military:0075E3EA",
      "offset": 7726058,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "違うって"
    },
    {
      "item_id": "cluster_61_military:0075E3FC",
      "offset": 7726076,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言ってんだろうがよっ！"
    },
    {
      "item_id": "cluster_61_military:0075E4EC",
      "offset": 7726316,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…おのれ。"
    },
    {
      "item_id": "cluster_61_military:0075E500",
      "offset": 7726336,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうやら私のすべての力を"
    },
    {
      "item_id": "cluster_61_military:0075E51E",
      "offset": 7726366,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "出さねばならんようだな"
    },
    {
      "item_id": "cluster_61_military:0075E54A",
      "offset": 7726410,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ハッタリは止めとけよ。"
    },
    {
      "item_id": "cluster_61_military:0075E566",
      "offset": 7726438,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これ以上の錬成は"
    },
    {
      "item_id": "cluster_61_military:0075E57C",
      "offset": 7726460,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "生身の人間には無理だ"
    },
    {
      "item_id": "cluster_61_military:0075E5A0",
      "offset": 7726496,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たとえ錬金術師だろうと、"
    },
    {
      "item_id": "cluster_61_military:0075E5BE",
      "offset": 7726526,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人間には変わりないんだからな"
    },
    {
      "item_id": "cluster_61_military:0075E5EC",
      "offset": 7726572,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もはや万策尽きたろう。"
    },
    {
      "item_id": "cluster_61_military:0075E608",
      "offset": 7726600,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これ以上の抵抗は無意味だ"
    },
    {
      "item_id": "cluster_61_military:0075E63A",
      "offset": 7726650,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…たしかに。"
    },
    {
      "item_id": "cluster_61_military:0075E650",
      "offset": 7726672,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たしかに生身の人間には、"
    },
    {
      "item_id": "cluster_61_military:0075E66E",
      "offset": 7726702,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これ以上は無理かもしれぬな"
    },
    {
      "item_id": "cluster_61_military:0075E69C",
      "offset": 7726748,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だがっ！"
    },
    {
      "item_id": "cluster_61_military:0075E736",
      "offset": 7726902,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにをする気だ！？"
    },
    {
      "item_id": "cluster_61_military:0075E75E",
      "offset": 7726942,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これ以上、なにを"
    },
    {
      "item_id": "cluster_61_military:0075E774",
      "offset": 7726964,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "等価交換できるって…"
    },
    {
      "item_id": "cluster_61_military:0075E7A0",
      "offset": 7727008,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "理想を実現するためであれば、"
    },
    {
      "item_id": "cluster_61_military:0075E7C2",
      "offset": 7727042,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わが身など惜しくはない。"
    },
    {
      "item_id": "cluster_61_military:0075E7E0",
      "offset": 7727072,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そこが貴様ら軍の狗との違い！"
    },
    {
      "item_id": "cluster_61_military:0075E826",
      "offset": 7727142,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん！"
    },
    {
      "item_id": "cluster_61_military:0075E838",
      "offset": 7727160,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これ以上、"
    },
    {
      "item_id": "cluster_61_military:0075E848",
      "offset": 7727176,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あの錬成を続けたら…"
    },
    {
      "item_id": "cluster_61_military:0075E884",
      "offset": 7727236,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "魂を完全に"
    },
    {
      "item_id": "cluster_61_military:0075E894",
      "offset": 7727252,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "持っていかれちまう。"
    },
    {
      "item_id": "cluster_61_military:0075E8BA",
      "offset": 7727290,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "後に残るのは…"
    },
    {
      "item_id": "cluster_61_military:0075E8D4",
      "offset": 7727316,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "抜け殻だ"
    },
    {
      "item_id": "cluster_61_military:0075EA04",
      "offset": 7727620,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…終わったな。"
    },
    {
      "item_id": "cluster_61_military:0075EA18",
      "offset": 7727640,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "最期が自滅とはな…"
    },
    {
      "item_id": "cluster_61_military:0075EA9E",
      "offset": 7727774,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エド…兄さんは…"
    },
    {
      "item_id": "cluster_61_military:0075EAD0",
      "offset": 7727824,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "悪かったな。"
    },
    {
      "item_id": "cluster_61_military:0075EAE2",
      "offset": 7727842,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たった今、"
    },
    {
      "item_id": "cluster_61_military:0075EAF2",
      "offset": 7727858,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すべてが終わったとこだ"
    },
    {
      "item_id": "cluster_61_military:0075EB64",
      "offset": 7727972,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "終わった、だと？"
    },
    {
      "item_id": "cluster_61_military:0075EB7A",
      "offset": 7727994,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "勝手に終わらせてもらっては"
    },
    {
      "item_id": "cluster_61_military:0075EB9A",
      "offset": 7728026,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "困るな！"
    },
    {
      "item_id": "cluster_61_military:0075EBBC",
      "offset": 7728060,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "バカな！"
    },
    {
      "item_id": "cluster_61_military:0075EBE2",
      "offset": 7728098,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "我が究極の錬成、"
    },
    {
      "item_id": "cluster_61_military:0075EBF8",
      "offset": 7728120,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その目に焼き付けるがいい！"
    },
    {
      "item_id": "cluster_61_military:0075ED2E",
      "offset": 7728430,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、"
    },
    {
      "item_id": "cluster_61_military:0075ED3E",
      "offset": 7728446,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この花でいいのかな？"
    },
    {
      "item_id": "cluster_61_military:0075ED64",
      "offset": 7728484,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うーん、"
    },
    {
      "item_id": "cluster_61_military:0075ED7A",
      "offset": 7728506,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "他に咲いてる花もないしな"
    },
    {
      "item_id": "cluster_61_military:0075EDA4",
      "offset": 7728548,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それじゃ、早く花を摘んで"
    },
    {
      "item_id": "cluster_61_military:0075EDC2",
      "offset": 7728578,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大総統のもとに戻ろう"
    },
    {
      "item_id": "cluster_61_military:0075EDEA",
      "offset": 7728618,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今度こそ、"
    },
    {
      "item_id": "cluster_61_military:0075EDFE",
      "offset": 7728638,
