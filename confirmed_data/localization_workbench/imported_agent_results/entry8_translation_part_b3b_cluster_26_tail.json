{
  "items": [
    {
      "item_id": "cluster_26_central:006FAB36",
      "offset": 7318326,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "多いっていうじゃない。",
      "translation": "많다잖아.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAB52",
      "offset": 7318354,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "物騒ねぇ",
      "translation": "살벌하네",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAB62",
      "offset": 7318370,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、ある国家錬金術師の人が",
      "translation": "그래도 어떤 국가 연금술사가",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAB84",
      "offset": 7318404,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ことごとく解決してるみたいよ",
      "translation": "모조리 해결하고 있대",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FABA6",
      "offset": 7318438,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "たよりになるわねぇ",
      "translation": "믿음직하네",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FABD6",
      "offset": 7318486,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イーストシティは",
      "translation": "이스트 시티는",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FABEC",
      "offset": 7318508,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大変だったらしいねえ",
      "translation": "큰일이었다더라",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAC1E",
      "offset": 7318558,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やっぱりセントラルは安全ね。",
      "translation": "역시 센트럴은 안전하네.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAC40",
      "offset": 7318592,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キメラのキの字も見ないわ",
      "translation": "키메라는 그림자도 안 보여",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FACC8",
      "offset": 7318728,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっき何かが飛んできたんだ！",
      "translation": "아까 뭔가 날아왔어!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FACEA",
      "offset": 7318762,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すげービックリしたよ！",
      "translation": "진짜 깜짝 놀랐어!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAD1E",
      "offset": 7318814,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術師になりたいんだ。",
      "translation": "연금술사가 되고 싶어.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAD3C",
      "offset": 7318844,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、今日も図書館で",
      "translation": "그래서 오늘도 도서관에서",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAD58",
      "offset": 7318872,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "勉強をするんだ",
      "translation": "공부할 거야",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAD84",
      "offset": 7318916,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師になるのって",
      "translation": "국가 연금술사가 되는 건",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FADA2",
      "offset": 7318946,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大変だけど、",
      "translation": "힘들지만,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FADB4",
      "offset": 7318964,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクはがんばってるぜ！",
      "translation": "난 열심히 하고 있어!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FADE8",
      "offset": 7319016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今回のキメラ事件は",
      "translation": "이번 키메라 사건은",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAE00",
      "offset": 7319040,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "国家錬金術師の人が",
      "translation": "국가 연금술사가",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAE18",
      "offset": 7319064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "解決したんだって！",
      "translation": "해결했대!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAE9C",
      "offset": 7319196,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鎧のパーツ？",
      "translation": "갑옷 부품?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAEAE",
      "offset": 7319214,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "知らんなぁ",
      "translation": "모르겠는데",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAED8",
      "offset": 7319256,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "住むなら、病院も図書館もある",
      "translation": "살 거라면 병원도 도서관도 있는",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAEFA",
      "offset": 7319290,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セントラルシティにかぎるね",
      "translation": "센트럴 시티가 최고지",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAF34",
      "offset": 7319348,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セントラルシティは",
      "translation": "센트럴 시티는",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAF4C",
      "offset": 7319372,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "治安もいいから",
      "translation": "치안도 좋아서",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAF60",
      "offset": 7319392,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "安心して住めるよ",
      "translation": "안심하고 살 수 있어",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAF90",
      "offset": 7319440,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キメラ事件も解決して、",
      "translation": "키메라 사건도 해결됐고,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FAFAC",
      "offset": 7319468,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "これでまた安心して暮らせるよ",
      "translation": "이제 다시 안심하고 살 수 있어",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB03C",
      "offset": 7319612,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "鎧のパーツ？",
      "translation": "갑옷 부품?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB056",
      "offset": 7319638,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それのことかしら？",
      "translation": "그걸 말하는 걸까?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB06E",
      "offset": 7319662,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さっき飛んできたのよ。",
      "translation": "아까 날아왔거든.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB08A",
      "offset": 7319690,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ホント危なかったんだから",
      "translation": "정말 위험했다니까",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB0C0",
      "offset": 7319744,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "すぐそこが図書館の分館よ。",
      "translation": "바로 저기가 도서관 분관이야.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB0E0",
      "offset": 7319776,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その奥に立ってるのが",
      "translation": "그 안쪽에 서 있는 게",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB0FA",
      "offset": 7319802,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "図書館の本館ね",
      "translation": "도서관 본관이야",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB126",
      "offset": 7319846,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "分館につとめてるコ、",
      "translation": "분관에서 일하는 애 말이야,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB140",
      "offset": 7319872,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いつも本ばかり読んでるの。",
      "translation": "늘 책만 읽고 있어.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB160",
      "offset": 7319904,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その内クビになっちゃうかもね",
      "translation": "그러다 언젠가 잘릴지도 몰라",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB216",
      "offset": 7320086,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "　セントラルシティ　南側区画",
      "translation": " 센트럴 시티 남쪽 구역",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB2E0",
      "offset": 7320288,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "忘れもん、",
      "translation": "잊은 건",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB2F2",
      "offset": 7320306,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ないか？",
      "translation": "없냐?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB30E",
      "offset": 7320334,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんですか、それ。",
      "translation": "뭐예요, 그게.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB32E",
      "offset": 7320366,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ひとを子供扱い",
      "translation": "사람을 어린애 취급",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB342",
      "offset": 7320386,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しないでください",
      "translation": "하지 말아 주세요",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB36A",
      "offset": 7320426,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まだ、子供だろうが…",
      "translation": "아직 어린애잖아...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB38C",
      "offset": 7320460,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…本当に帰るのか、",
      "translation": "...정말 돌아가는 거냐,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB3A6",
      "offset": 7320486,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "故郷に？",
      "translation": "고향으로?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB3D4",
      "offset": 7320532,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにそれ！",
      "translation": "뭐예요, 그거!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB3EC",
      "offset": 7320556,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "寂しいんですか？",
      "translation": "섭섭한 거예요?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB444",
      "offset": 7320644,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "誰もそんなこと、",
      "translation": "누가 그런 말을",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB45A",
      "offset": 7320666,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言ってないだろ！",
      "translation": "했다는 거야!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB47E",
      "offset": 7320702,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだか目が真っ赤ですよ？",
      "translation": "왠지 눈이 새빨간데요?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB4C6",
      "offset": 7320774,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレが泣くわけねーだろ",
      "translation": "내가 울 리 없잖아",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB500",
      "offset": 7320832,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さんはホント、",
      "translation": "형은 정말",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB51A",
      "offset": 7320858,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "素直じゃないんだからなぁ",
      "translation": "솔직하지 못하다니까",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB53A",
      "offset": 7320890,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクはもう少し、",
      "translation": "나는 조금 더",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB552",
      "offset": 7320914,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィと",
      "translation": "코니랑",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB560",
      "offset": 7320928,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "一緒にいたかったな",
      "translation": "같이 있고 싶었어",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB586",
      "offset": 7320966,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ありがとう、",
      "translation": "고마워요,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB5B8",
      "offset": 7321016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セラフィ兄さんを…",
      "translation": "세라피 오빠를...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB5D4",
      "offset": 7321044,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ママのもとに送り届けなきゃ",
      "translation": "엄마 곁으로 보내 줘야 해",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB612",
      "offset": 7321106,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうだね",
      "translation": "그렇지",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB62A",
      "offset": 7321130,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…二人とも、",
      "translation": "...두 분 다,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB63E",
      "offset": 7321150,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ありがとう",
      "translation": "고마워요",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB668",
      "offset": 7321192,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだよ、",
      "translation": "뭐야,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB67A",
      "offset": 7321210,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "急に改まって。",
      "translation": "갑자기 정색하고.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB696",
      "offset": 7321238,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気持ち悪いだろ",
      "translation": "어색하잖아",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB6B8",
      "offset": 7321272,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "二人に会わなければ、",
      "translation": "두 분을 만나지 못했다면,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB6D2",
      "offset": 7321298,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっと国家錬金術師への道、",
      "translation": "분명 국가 연금술사의 길을",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB6FA",
      "offset": 7321338,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どこかで諦めてたかも…",
      "translation": "어딘가에서 포기했을지도...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB724",
      "offset": 7321380,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、",
      "translation": "그래서,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB738",
      "offset": 7321400,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "遅くなったけど、",
      "translation": "늦었지만,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB74E",
      "offset": 7321422,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お礼だけはちゃんと、",
      "translation": "감사 인사만은 제대로",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB768",
      "offset": 7321448,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言いたかったんです",
      "translation": "하고 싶었어요",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB79A",
      "offset": 7321498,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレはべつに",
      "translation": "난 딱히",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB7AC",
      "offset": 7321516,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにをしたわけでもないけどな",
      "translation": "뭘 한 것도 없지만 말이야",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB7F0",
      "offset": 7321584,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうだよ。",
      "translation": "맞아.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB804",
      "offset": 7321604,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクたちの力じゃなくって、",
      "translation": "우리 힘이 아니라,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB824",
      "offset": 7321636,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィの実力だから",
      "translation": "코니 실력이니까",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB846",
      "offset": 7321670,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…うん。",
      "translation": "...응.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB858",
      "offset": 7321688,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今はまだスタートラインに",
      "translation": "지금은 아직 출발선에",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB876",
      "offset": 7321718,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "立ったばかりだけど…",
      "translation": "막 섰을 뿐이지만...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB8A6",
      "offset": 7321766,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いずれ私、",
      "translation": "언젠가 저는",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB8BA",
      "offset": 7321786,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "エドを追い抜いてみせます！",
      "translation": "에드를 반드시 앞지를 거예요!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB8F8",
      "offset": 7321848,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おいおい、",
      "translation": "어이 어이,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB90E",
      "offset": 7321870,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレに肩を",
      "translation": "나랑 어깨를",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB91E",
      "offset": 7321886,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "並べようなんて百年早いって",
      "translation": "나란히 하려면 백 년은 일러",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB958",
      "offset": 7321944,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、身長ならエドを",
      "translation": "그래도 키라면 에드를",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB972",
      "offset": 7321970,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "越えちゃってますよ？",
      "translation": "넘어섰는데요?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB996",
      "offset": 7322006,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "次に会うときには、",
      "translation": "다음에 만날 때는,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB9AE",
      "offset": 7322030,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬金術の腕前も",
      "translation": "연금술 실력도",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FB9C2",
      "offset": 7322050,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "とっくに追い越してるかも？",
      "translation": "벌써 앞질러 있을지도요?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBA28",
      "offset": 7322152,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "身長のことは言うんじゃねー！",
      "translation": "키 얘기는 하지 마!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBA6C",
      "offset": 7322220,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あわわわ…",
      "translation": "아와와와...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBA82",
      "offset": 7322242,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、ほら！",
      "translation": "형, 봐!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBA96",
      "offset": 7322262,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まわりのひとたちが",
      "translation": "주변 사람들이",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBAAE",
      "offset": 7322286,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "変な目で見てるからっ！",
      "translation": "이상하게 보고 있잖아!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBAD8",
      "offset": 7322328,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ウフフフフ",
      "translation": "우후후후",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBB56",
      "offset": 7322454,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…もう行かなくちゃ！",
      "translation": "...이제 가야 해!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBB92",
      "offset": 7322514,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "コニィ！",
      "translation": "코니!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBBA8",
      "offset": 7322536,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "またどこかで会おうねっ！",
      "translation": "언젠가 또 만나자!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBBCC",
      "offset": 7322572,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今度会うときは",
      "translation": "다음에 만날 땐",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBBE0",
      "offset": 7322592,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "立派な錬金術師になってろよ！",
      "translation": "훌륭한 연금술사가 돼 있어라!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBC10",
      "offset": 7322640,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それじゃ、サヨ",
      "translation": "그럼, 안",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBC8A",
      "offset": 7322762,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おい、どうした？",
      "translation": "야, 왜 그래?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBCA4",
      "offset": 7322788,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早くしないと乗り遅れるぞ",
      "translation": "빨리 안 가면 놓친다",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBCE4",
      "offset": 7322852,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ひとりぼっちじゃ",
      "translation": "혼자가 되는 건",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBCFA",
      "offset": 7322874,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ないんですよね？",
      "translation": "아니겠죠?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBD32",
      "offset": 7322930,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなこと…",
      "translation": "그런 건...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBD46",
      "offset": 7322950,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "当然だよ！",
      "translation": "당연하지!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBD70",
      "offset": 7322992,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "サヨナラって言葉が",
      "translation": "안녕이라는 말이",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBD88",
      "offset": 7323016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "苦手なんです",
      "translation": "싫어요",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBDA4",
      "offset": 7323044,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その言葉を口にすると、",
      "translation": "그 말을 입에 담으면,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBDC4",
      "offset": 7323076,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "もう二度と会えないような",
      "translation": "다시는 못 만날 것 같은",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBDE2",
      "offset": 7323106,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気がするから",
      "translation": "기분이 들거든요",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBE10",
      "offset": 7323152,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "セラフィ兄さんのときも…",
      "translation": "세라피 오빠 때도...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBE38",
      "offset": 7323192,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そんなことあるわけないよ！",
      "translation": "그럴 리 없잖아!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBE5C",
      "offset": 7323228,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクらはいつだってまた会える",
      "translation": "우린 언제든 다시 만날 수 있어",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBE9C",
      "offset": 7323292,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まったく、",
      "translation": "정말이지,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBEB4",
      "offset": 7323316,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにをつまんないこと",
      "translation": "뭘 그런 시시한 걸",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBECE",
      "offset": 7323342,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "気にしてんだよ",
      "translation": "신경 쓰고 있어",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBEF0",
      "offset": 7323376,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…会えますよね？",
      "translation": "...만날 수 있죠?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBF0E",
      "offset": 7323406,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "またきっと会えますよねっ！？",
      "translation": "꼭 다시 만날 수 있죠!?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBF38",
      "offset": 7323448,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お別れじゃないですよね！？",
      "translation": "이별이 아니죠!?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBF66",
      "offset": 7323494,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "師匠が言ってた。",
      "translation": "스승님이 그러셨어.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBF80",
      "offset": 7323520,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この世界は法則にしたがって",
      "translation": "이 세계는 법칙에 따라",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBFA0",
      "offset": 7323552,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "流れ、循環してるって",
      "translation": "흐르고 순환한다고",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBFC8",
      "offset": 7323592,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "流れを受け入れろ。",
      "translation": "흐름을 받아들여라.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FBFE8",
      "offset": 7323624,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それが師匠の教えだ。",
      "translation": "그게 스승님의 가르침이야.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC006",
      "offset": 7323654,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…人の出会いも似てるかもな",
      "translation": "...사람의 만남도 비슷할지 몰라",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC030",
      "offset": 7323696,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この世界に生きてさえいれば、",
      "translation": "이 세계에서 살아 있기만 하면,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC052",
      "offset": 7323730,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その流れがオレたちを",
      "translation": "그 흐름이 우리를",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC06C",
      "offset": 7323756,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "また引き合わせるときも来るさ",
      "translation": "다시 만나게 해 줄 때도 오겠지",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC0A4",
      "offset": 7323812,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…すべては流れ、",
      "translation": "...모든 것은 흐름,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC0C0",
      "offset": 7323840,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ですか？",
      "translation": "인가요?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC0DC",
      "offset": 7323868,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だけど、ずっと会いたいと",
      "translation": "하지만 계속 만나고 싶다고",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC0FA",
      "offset": 7323898,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "思い続ければ、",
      "translation": "생각하고 있으면,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC10E",
      "offset": 7323918,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "その流れも変えられるかもな？",
      "translation": "그 흐름도 바꿀 수 있을지 몰라?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC156",
      "offset": 7323990,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうですね。",
      "translation": "그렇네요.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC170",
      "offset": 7324016,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私、毎日エドとアルのこと",
      "translation": "저, 매일 에드랑 알을",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC18E",
      "offset": 7324046,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "考えるようにします！",
      "translation": "생각할게요!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC1D8",
      "offset": 7324120,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "べつに毎日じゃなくって",
      "translation": "딱히 매일은 아니어도",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC1F4",
      "offset": 7324148,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいんだけどな…",
      "translation": "되는데 말이야...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC228",
      "offset": 7324200,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、照れない、照れない",
      "translation": "형, 부끄러워하지 마",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC28A",
      "offset": 7324298,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それじゃ…",
      "translation": "그럼...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC29C",
      "offset": 7324316,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行きますね！",
      "translation": "갈게요!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC2C8",
      "offset": 7324360,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ううん。",
      "translation": "아니.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC2D6",
      "offset": 7324374,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "サヨナラは言わないわ",
      "translation": "안녕은 말하지 않을래",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC302",
      "offset": 7324418,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "じゃ、エドもアルも元気でね！",
      "translation": "그럼 에드도 알도 잘 지내!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC328",
      "offset": 7324456,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "また会いましょう！",
      "translation": "또 만나요!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC348",
      "offset": 7324488,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "バイバイ！",
      "translation": "바이바이!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC3C6",
      "offset": 7324614,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん…",
      "translation": "형...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC3DA",
      "offset": 7324634,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行っちゃったね",
      "translation": "가 버렸네",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC3F8",
      "offset": 7324664,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "最後までギャアギャア",
      "translation": "끝까지 꽥꽥",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC412",
      "offset": 7324690,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うるさいヤツだったけど",
      "translation": "시끄러운 녀석이었지만",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC45E",
      "offset": 7324766,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うるさいヤツだったけど？",
      "translation": "시끄러운 녀석이었지만?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC4B8",
      "offset": 7324856,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレはさびしくなんか",
      "translation": "난 외롭거나 하진",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC4D2",
      "offset": 7324882,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ないからなっ！",
      "translation": "않거든!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC508",
      "offset": 7324936,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あれ～、",
      "translation": "어라,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC528",
      "offset": 7324968,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにも言ってないけど？",
      "translation": "아무 말도 안 했는데?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC56E",
      "offset": 7325038,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うるさいっ！",
      "translation": "시끄러워!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC588",
      "offset": 7325064,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ほら、さっさと賢者の石の",
      "translation": "자, 얼른 현자의 돌",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC5A6",
      "offset": 7325094,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "手がかりを探しに行くぞ！",
      "translation": "단서를 찾으러 가자!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC5DA",
      "offset": 7325146,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "早いところ、アルの身体を",
      "translation": "빨리 알의 몸을",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC5F8",
      "offset": 7325176,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "元に戻さなきゃ",
      "translation": "원래대로 돌려야",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC60C",
      "offset": 7325196,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ならないんだからな",
      "translation": "하니까 말이야",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC62E",
      "offset": 7325230,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、",
      "translation": "형,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC63E",
      "offset": 7325246,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ごまかさないで、",
      "translation": "얼버무리지 말고,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC654",
      "offset": 7325268,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "さびしいって言えばー？",
      "translation": "외롭다고 말하지 그래?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC686",
      "offset": 7325318,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うるさい、",
      "translation": "시끄러워,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC698",
      "offset": 7325336,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "うるさーい！",
      "translation": "시끄럽다고!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC79A",
      "offset": 7325594,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、まだセントラルで",
      "translation": "형, 아직 센트럴에서",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC7B8",
      "offset": 7325624,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "やらなきゃいけないことが",
      "translation": "해야 할 일이",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC7D6",
      "offset": 7325654,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あるんじゃない？",
      "translation": "있지 않아?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC820",
      "offset": 7325728,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、イーストシティに",
      "translation": "형, 이스트 시티에",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC83E",
      "offset": 7325758,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "行くには、南側区画の駅から",
      "translation": "가려면 남쪽 구역 역에서",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC85E",
      "offset": 7325790,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "列車に乗らないと…",
      "translation": "열차를 타야 해...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC914",
      "offset": 7325972,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あったぞ、アル！",
      "translation": "찾았다, 알!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC92E",
      "offset": 7325998,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "右足、ゲットだぜ！",
      "translation": "오른쪽 다리, 찾았어!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC97E",
      "offset": 7326078,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ありがとう、",
      "translation": "고마워,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC992",
      "offset": 7326098,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん！",
      "translation": "형!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FC9BA",
      "offset": 7326138,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "残りのパーツを探すぞ！",
      "translation": "남은 부품도 찾자!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCA84",
      "offset": 7326340,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アルをもとに戻すまでは",
      "translation": "알을 원래대로 돌릴 때까진",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCAA0",
      "offset": 7326368,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "他の場所へなんか行けるか！",
      "translation": "다른 데 갈 수 있겠냐!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCAF6",
      "offset": 7326454,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヒューズ中佐の家に行かないと",
      "translation": "휴즈 중령 집에 가야 해",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCB22",
      "offset": 7326498,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "中佐を呼びに行かないと！",
      "translation": "중령을 부르러 가야 해!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCBA6",
      "offset": 7326630,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "　南側区画",
      "translation": " 남쪽 구역",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCC36",
      "offset": 7326774,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こんなところにいたら",
      "translation": "이런 데 있으면",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCC50",
      "offset": 7326800,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ひかれちゃうよ！",
      "translation": "치일 거야!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCC74",
      "offset": 7326836,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "はいはい…",
      "translation": "알았어...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCD5C",
      "offset": 7327068,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "トッティ、",
      "translation": "토티,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCD70",
      "offset": 7327088,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おいで、トッティ♪",
      "translation": "이리 와, 토티♪",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_26_central:006FCD9C",
      "offset": 7327132,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ヘンな名前つけるなー！",
      "translation": "이상한 이름 붙이지 마!",
      "agent_comment": ""
    }
  ]
}
