{
  "items": [
    {
      "item_id": "cluster_63_bank:00764A84",
      "offset": 7752324,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今朝方、列車強盗にあう夢を",
      "translation": "오늘 새벽, 열차 강도를 만나는 꿈을",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764AA4",
      "offset": 7752356,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "見たんです。",
      "translation": "꿨습니다.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764AB6",
      "offset": 7752374,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "現実になってしまいました",
      "translation": "그게 현실이 되고 말았습니다",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764AEE",
      "offset": 7752430,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "怖くない。怖くない。",
      "translation": "무섭지 않아. 무섭지 않아.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764B08",
      "offset": 7752456,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "お父さんがいるじゃないか",
      "translation": "아빠가 있잖아",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764B8C",
      "offset": 7752588,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "パパの夢はよく当たるの。",
      "translation": "아빠 꿈은 잘 맞아.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764BAA",
      "offset": 7752618,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、良い夢は当たらないのよ",
      "translation": "그런데 좋은 꿈은 안 맞아",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764BE6",
      "offset": 7752678,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "えーん、コワイよぉ",
      "translation": "으앙, 무서워",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764C64",
      "offset": 7752804,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "今は列車強盗が",
      "translation": "요즘은 열차 강도가",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764C78",
      "offset": 7752824,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "はやってるのかしら？",
      "translation": "유행인가 봐요?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764CAC",
      "offset": 7752876,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "列車強盗してないで",
      "translation": "열차 강도 같은 짓 말고",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764CC4",
      "offset": 7752900,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きちんと就職したらいいのよ。",
      "translation": "제대로 취직하면 좋을 텐데.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764CE6",
      "offset": 7752934,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "親の顔を見てやりたいわ",
      "translation": "부모 얼굴이 보고 싶네요",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764DEA",
      "offset": 7753194,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだぁ、お前は？",
      "translation": "뭐냐, 너는?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764E02",
      "offset": 7753218,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "刃向かうつもりなら",
      "translation": "덤빌 생각이라면",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764E1A",
      "offset": 7753242,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "叩きのめしてやる！",
      "translation": "박살 내 주마!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764F16",
      "offset": 7753494,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレの仕事の邪魔をするヤツは",
      "translation": "내 일을 방해하는 놈은",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764F38",
      "offset": 7753528,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "叩きのめす！",
      "translation": "짓뭉개 주마!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_63_bank:00764F4A",
      "offset": 7753546,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "覚悟はいいな！！",
      "translation": "각오는 됐겠지!!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765C74",
      "offset": 7756916,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わたしは暴力は反対です。",
      "translation": "저는 폭력에 반대합니다.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765C92",
      "offset": 7756946,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だから、大人しく",
      "translation": "그러니 얌전히",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765CA8",
      "offset": 7756968,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "強盗の言うことをききます",
      "translation": "강도 말에 따르겠습니다",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765CE0",
      "offset": 7757024,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "愛する家族は私が守る！",
      "translation": "사랑하는 가족은 내가 지킨다!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765D60",
      "offset": 7757152,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "主人は優しい人なんです。",
      "translation": "남편은 다정한 사람이에요.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765D7E",
      "offset": 7757182,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "でも、イザという時は",
      "translation": "하지만 막상 필요할 때는",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765D98",
      "offset": 7757208,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "家族を守ってくれ…ないわね",
      "translation": "가족을 지켜 주지... 못하네요",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765DD2",
      "offset": 7757266,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "頼もしいわ、あなた",
      "translation": "든든하네요, 여보",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765E50",
      "offset": 7757392,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "パパはいつもママに",
      "translation": "아빠는 언제나 엄마한테",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765E68",
      "offset": 7757416,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ケンカで負けるんだ",
      "translation": "말싸움에서 져",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765E9A",
      "offset": 7757466,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクもワルイやつから",
      "translation": "나도 나쁜 녀석들한테서",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765EB4",
      "offset": 7757492,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "みんなを守るぞ！",
      "translation": "모두를 지킬 거야!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765F30",
      "offset": 7757616,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "わたしは優しいパパが好き",
      "translation": "난 다정한 아빠가 좋아",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765F68",
      "offset": 7757672,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "はぁ…、せっかくの旅行が",
      "translation": "하아... 모처럼 온 여행이",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00765F86",
      "offset": 7757702,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だいなしだわ",
      "translation": "엉망이 됐네요",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00766036",
      "offset": 7757878,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだぁそのツラはぁ！",
      "translation": "뭐냐, 그 낯짝은!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00766052",
      "offset": 7757906,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ナマイキなチビだ。",
      "translation": "건방진 꼬맹이군.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:0076606A",
      "offset": 7757930,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "言うことをきかせてやる！",
      "translation": "말을 듣게 해 주마!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:0076616E",
      "offset": 7758190,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだ、キサマらは！",
      "translation": "뭐냐, 네놈들은!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_64_bank:00766188",
      "offset": 7758216,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "計画の邪魔はさせねぇ！",
      "translation": "계획을 방해하게 둘 순 없다!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:00767170",
      "offset": 7762288,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "きっとこの上じゃないかな？",
      "translation": "분명 이 위 아닐까?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:00767190",
      "offset": 7762320,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "どうする、兄さん？",
      "translation": "어떻게 할래, 형?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:007671BA",
      "offset": 7762362,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "錬成でハシゴを作れば",
      "translation": "연성으로 사다리를 만들면",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:007671D4",
      "offset": 7762388,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "上にのぼれそうだな",
      "translation": "위로 올라갈 수 있겠어",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:007671F6",
      "offset": 7762422,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "金属の４－４のカードがあれば",
      "translation": "금속 4-4 카드가 있으면",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:00767218",
      "offset": 7762456,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ハシゴを錬成できそうだぞ",
      "translation": "사다리를 연성할 수 있겠어",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:00767240",
      "offset": 7762496,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "準備はいいか？",
      "translation": "준비됐어?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:007672DC",
      "offset": 7762652,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いくぞ！",
      "translation": "간다!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:00767350",
      "offset": 7762768,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "楽勝だぜ！",
      "translation": "식은 죽 먹기지!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:00767386",
      "offset": 7762822,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "このカードじゃダメだな。",
      "translation": "이 카드로는 안 되겠어.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:007673A4",
      "offset": 7762852,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ここにハシゴを錬成するには",
      "translation": "여기에 사다리를 연성하려면",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:007673C4",
      "offset": 7762884,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "金属の４－４のカードが必要だ",
      "translation": "금속 4-4 카드가 필요해",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_65_tutorial:0076740A",
      "offset": 7762954,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "金属の４－４が必要だ",
      "translation": "금속 4-4가 필요해",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00768FD2",
      "offset": 7770066,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "キサマは！",
      "translation": "네놈은!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00768FE2",
      "offset": 7770082,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "何しに来た？",
      "translation": "뭘 하러 왔냐?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769000",
      "offset": 7770112,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "決まってんだろ。",
      "translation": "뻔하잖아.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769016",
      "offset": 7770134,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人質を助けに来たんだよ",
      "translation": "인질을 구하러 왔지",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:0076904E",
      "offset": 7770190,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "相変わらず生意気な小僧だ！",
      "translation": "여전히 건방진 꼬맹이군!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769084",
      "offset": 7770244,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ていうか、",
      "translation": "그보다,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769094",
      "offset": 7770260,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まだこんなことやってんの？",
      "translation": "아직도 이런 짓 하고 있어?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:007690B4",
      "offset": 7770292,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "こりてねぇな",
      "translation": "질리지도 않나 봐",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:007690D6",
      "offset": 7770326,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "私はあきらめの悪い男だ。",
      "translation": "나는 쉽게 포기하지 않는 남자다.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:007690F4",
      "offset": 7770356,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "何度でも目的達成の為には",
      "translation": "목적을 이루기 위해서라면",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769112",
      "offset": 7770386,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "挑戦をし続ける",
      "translation": "몇 번이고 도전한다",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:0076913C",
      "offset": 7770428,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それなら、こっちも何度でも",
      "translation": "그럼 이쪽도 몇 번이고",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:0076915C",
      "offset": 7770460,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "倒してやるよ。",
      "translation": "쓰러뜨려 주지.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769170",
      "offset": 7770480,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "かかってきな！",
      "translation": "덤벼!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769208",
      "offset": 7770632,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なんだ、コイツ…",
      "translation": "뭐야, 이 녀석...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:0076921E",
      "offset": 7770654,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "人間じゃないぞ？",
      "translation": "사람이 아니잖아?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769246",
      "offset": 7770694,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ホントだ…人形…？",
      "translation": "정말이네... 인형...?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:0076925E",
      "offset": 7770718,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "まさか錬金術で！",
      "translation": "설마 연금술로!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769282",
      "offset": 7770754,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "だろうな。",
      "translation": "그렇겠지.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769292",
      "offset": 7770770,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "しかも、かなり高等な錬金術だ",
      "translation": "게다가 꽤 수준 높은 연금술이야",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:007692C6",
      "offset": 7770822,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ま、いいさ。",
      "translation": "뭐, 됐어.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:007692D8",
      "offset": 7770840,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "マスタング大佐にでも連絡して",
      "translation": "머스탱 대령에게라도 연락해",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:007692FA",
      "offset": 7770874,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "おけば、何とかしてくれるだろ",
      "translation": "두면 어떻게든 해 주겠지",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769326",
      "offset": 7770918,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "とりあえず人質は",
      "translation": "일단 인질은",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:0076933C",
      "offset": 7770940,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "助かったんだからな",
      "translation": "구했으니까",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769366",
      "offset": 7770982,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そうだね…",
      "translation": "그렇네...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_66_military:00769392",
      "offset": 7771026,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大丈夫ですか？",
      "translation": "괜찮으세요?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_67_unclassified:0076A504",
      "offset": 7775492,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいかげん、",
      "translation": "이제 좀,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_67_unclassified:0076A516",
      "offset": 7775510,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "大人しくしてれば良いのになぁ",
      "translation": "얌전히 있으면 좋을 텐데",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_67_unclassified:0076A544",
      "offset": 7775556,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "そう何度もやられると",
      "translation": "그렇게 몇 번이고 당할 거라",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_67_unclassified:0076A55E",
      "offset": 7775582,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "思ってるのか！",
      "translation": "생각하나!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_67_unclassified:0076A582",
      "offset": 7775618,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "思ってるよ。",
      "translation": "생각하는데.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_67_unclassified:0076A594",
      "offset": 7775636,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "悪いけどさ、",
      "translation": "미안하지만,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_67_unclassified:0076A5A6",
      "offset": 7775654,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "また勝たせてもらうぜ",
      "translation": "이번에도 이겨 주겠어",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B1F8",
      "offset": 7778808,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "肉体の材料はそろえた。",
      "translation": "육체의 재료는 다 모았어.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B23E",
      "offset": 7778878,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "母さんを元に戻そう。",
      "translation": "엄마를 원래대로 되돌리자.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B260",
      "offset": 7778912,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "生き返らせるんだ！",
      "translation": "되살리는 거야!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B28A",
      "offset": 7778954,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "…人体錬成は禁じられてるよ。",
      "translation": "...인체연성은 금지되어 있어.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B2B0",
      "offset": 7778992,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "それに錬金術は等価交換…",
      "translation": "게다가 연금술은 등가교환...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B2DE",
      "offset": 7779038,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "肉体は交換できても、",
      "translation": "육체는 교환할 수 있어도,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B326",
      "offset": 7779110,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにと交換するの？",
      "translation": "무엇과 교환할 거야?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B370",
      "offset": 7779184,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "いいから、",
      "translation": "됐으니까,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B382",
      "offset": 7779202,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "指だせ。",
      "translation": "손가락 내밀어.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B394",
      "offset": 7779220,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレたちの血も必要なんだ。",
      "translation": "우리 피도 필요해.",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B3F8",
      "offset": 7779320,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "イタッ！！",
      "translation": "아야!!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B42A",
      "offset": 7779370,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "この血で魂の情報はよしっ",
      "translation": "이 피로 영혼의 정보는 됐어",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B4B6",
      "offset": 7779510,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "じゃあ、",
      "translation": "그럼,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B4C6",
      "offset": 7779526,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "始めるぞ！！",
      "translation": "시작한다!!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B5E8",
      "offset": 7779816,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、",
      "translation": "형,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B5F8",
      "offset": 7779832,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "なにか変だよ！",
      "translation": "뭔가 이상해!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B62A",
      "offset": 7779882,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "ボクのカラダが消えてくッ！！",
      "translation": "내 몸이 사라져 가!!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B66A",
      "offset": 7779946,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アル！！",
      "translation": "알!!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B692",
      "offset": 7779986,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "あっ！？",
      "translation": "아!?",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B6A2",
      "offset": 7780002,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "オレの足もッ！！",
      "translation": "내 다리도!!",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B6CA",
      "offset": 7780042,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん、",
      "translation": "형,",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B6DA",
      "offset": 7780058,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "兄さん…",
      "translation": "형...",
      "agent_comment": ""
    },
    {
      "item_id": "cluster_68_tutorial:0076B702",
      "offset": 7780098,
      "source_group": "registry_a_entry8_prefixed_texts",
      "text": "アルぅぅぅぅぅぅ！！",
      "translation": "알!!",
      "agent_comment": ""
    }
  ]
}
