    "notes": ""
  },
  {
    "run_id": "entry8_cluster_51_run_0019",
    "cluster_index": 51,
    "run_index": 19,
    "dialogue_state_token": null,
    "record_count": 10,
    "offsets": [
      7602056,
      7602100,
      7602156,
      7602188,
      7602214,
      7602254,
      7602282,
      7602318,
      7602350,
      7602378
    ],
    "source_text": "壊したんじゃないだろうね？\nワンワンッ！\nデンも喜んでるみたいだね。\nウィンリィのとこにも\nたまには顔を出しておやり\n定期的に機械鎧の整備も\n必要だからね\n今はもう暇になったのかい？\nなら、機械鎧の整備でも\nしていったらどうだい？",
    "translation_text": "망가뜨린 건 아니겠지?\n멍멍!\n덴도 기쁜가 보구나.\n윈리한테도\n가끔은 얼굴 비춰 줘라\n정기적으로 오토메일 정비도\n필요하니까\n이젠 좀 한가해진 거냐?\n그럼 오토메일 정비라도\n받고 가는 게 어때?",
    "records": [
      {
        "offset": 7602056,
        "header_offset": 7602052,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "壊したんじゃないだろうね？",
        "translation": "망가뜨린 건 아니겠지?"
      },
      {
        "offset": 7602100,
        "header_offset": 7602096,
        "char_count": 6,
        "byte_length": 12,
        "control_gap_length": 14,
        "text": "ワンワンッ！",
        "translation": "멍멍!"
      },
      {
        "offset": 7602156,
        "header_offset": 7602152,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 40,
        "text": "デンも喜んでるみたいだね。",
        "translation": "덴도 기쁜가 보구나."
      },
      {
        "offset": 7602188,
        "header_offset": 7602184,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "ウィンリィのとこにも",
        "translation": "윈리한테도"
      },
      {
        "offset": 7602214,
        "header_offset": 7602210,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "たまには顔を出しておやり",
        "translation": "가끔은 얼굴 비춰 줘라"
      },
      {
        "offset": 7602254,
        "header_offset": 7602250,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 12,
        "text": "定期的に機械鎧の整備も",
        "translation": "정기적으로 오토메일 정비도"
      },
      {
        "offset": 7602282,
        "header_offset": 7602278,
        "char_count": 6,
        "byte_length": 12,
        "control_gap_length": 2,
        "text": "必要だからね",
        "translation": "필요하니까"
      },
      {
        "offset": 7602318,
        "header_offset": 7602314,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 20,
        "text": "今はもう暇になったのかい？",
        "translation": "이젠 좀 한가해진 거냐?"
      },
      {
        "offset": 7602350,
        "header_offset": 7602346,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 2,
        "text": "なら、機械鎧の整備でも",
        "translation": "그럼 오토메일 정비라도"
      },
      {
        "offset": 7602378,
        "header_offset": 7602374,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 2,
        "text": "していったらどうだい？",
        "translation": "받고 가는 게 어때?"
      }
    ],
    "notes": ""
  },
