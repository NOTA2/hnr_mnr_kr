        "header_offset": 7471492,
        "char_count": 6,
        "byte_length": 12,
        "control_gap_length": 26,
        "text": "た、大佐っ！",
        "translation": "대, 대령님!"
      },
      {
        "offset": 7471514,
        "header_offset": 7471510,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 2,
        "text": "キメラの親玉は",
        "translation": "키메라의 우두머리는"
