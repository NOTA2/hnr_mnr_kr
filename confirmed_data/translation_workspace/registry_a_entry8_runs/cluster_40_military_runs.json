      {
        "offset": 7471578,
        "header_offset": 7471574,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 26,
        "text": "鋼の錬金術師殿も",
        "translation": "강철의 연금술사님도"
      },
      {
        "offset": 7471600,
        "header_offset": 7471596,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 2,
        "text": "訓練でありますか？",
        "translation": "훈련 중이십니까?"
      },
      {
        "offset": 7471648,
        "header_offset": 7471644,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 26,
        "text": "ハボック少尉ですか…",
        "translation": "하복 소위 말입니까…"
      },
      {
        "offset": 7471674,
        "header_offset": 7471670,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 2,
        "text": "見かけませんでした",
        "translation": "보지 못했습니다"
      },
      {
        "offset": 7471722,
        "header_offset": 7471718,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 26,
        "text": "せいっ！　せいっ！",
        "translation": "하앗! 하앗!"
      },
      {
        "offset": 7471746,
        "header_offset": 7471742,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "やっぱり身体を動かすと、",
        "translation": "역시 몸을 움직이면"
      },
      {
        "offset": 7471776,
        "header_offset": 7471772,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 2,
        "text": "気分がいいですね",
        "translation": "기분이 좋군요"
      },
      {
        "offset": 7471822,
        "header_offset": 7471818,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 26,
        "text": "ここは我々にお任せを！",
        "translation": "여기는 저희에게 맡겨 주십시오!"
      },
      {
        "offset": 7472064,
        "header_offset": 7472060,
        "char_count": 14,
        "byte_length": 28,
        "control_gap_length": 216,
        "text": "自分がめざすは射撃の名手です",
        "translation": "제가 목표로 하는 건 사격의 명수입니다"
      },
      {
        "offset": 7472122,
        "header_offset": 7472118,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 26,
        "text": "射撃の訓練前に",
