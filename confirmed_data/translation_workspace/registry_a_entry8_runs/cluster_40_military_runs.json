        "header_offset": 7471424,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "逃げてしまいました。",
        "translation": "도망쳐 버렸습니다."
      },
      {
        "offset": 7471454,
        "header_offset": 7471450,
        "char_count": 6,
        "byte_length": 12,
        "control_gap_length": 2,
        "text": "反省します…",
        "translation": "반성하겠습니다…"
      },
