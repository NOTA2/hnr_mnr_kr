      },
      {
        "offset": 7472402,
        "header_offset": 7472398,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 26,
        "text": "こうしてマジメに",
        "translation": "이렇게 성실히"
      },
      {
        "offset": 7472424,
        "header_offset": 7472420,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 2,
        "text": "訓練してれば、",
        "translation": "훈련하다 보면"
      },
      {
        "offset": 7472444,
        "header_offset": 7472440,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "俺もいつかは昇進できるかな",
        "translation": "나도 언젠가는 승진할 수 있을까"
      },
      {
        "offset": 7472500,
        "header_offset": 7472496,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 26,
        "text": "俺は訓練を終えた後に",
        "translation": "난 훈련을 마친 뒤에"
      },
      {
