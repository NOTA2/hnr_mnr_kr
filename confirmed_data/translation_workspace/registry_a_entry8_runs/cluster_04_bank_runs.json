      {
        "offset": 7088340,
        "header_offset": 7088336,
        "char_count": 5,
        "byte_length": 10,
        "control_gap_length": 2,
        "text": "気にすんな",
        "translation": "신경　마"
      },
      {
        "offset": 7088392,
        "header_offset": 7088388,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 38,
        "text": "犯人は錬金術師って",
        "translation": "범인은　연금술사란"
      },
      {
        "offset": 7088416,
        "header_offset": 7088412,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 2,
        "text": "もっぱらのウワサですよ",
        "translation": "소문이　자자해요"
      },
      {
        "offset": 7088506,
        "header_offset": 7088502,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 64,
        "text": "今度は銀行強盗だって？",
        "translation": "이번엔은행강도라니？"
      },
      {
        "offset": 7088534,
        "header_offset": 7088530,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 2,
        "text": "嫌な世の中になりました",
        "translation": "참싫은세상이됐네요"
      },
      {
        "offset": 7088588,
        "header_offset": 7088584,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 28,
        "text": "強盗、空き巣。",
        "translation": "강도、도둑。"
