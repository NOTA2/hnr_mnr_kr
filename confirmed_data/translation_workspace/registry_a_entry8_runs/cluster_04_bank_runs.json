      {
        "offset": 7088608,
        "header_offset": 7088604,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 2,
        "text": "物騒な街になって",
        "translation": "흉흉한　거리가"
      },
      {
        "offset": 7088630,
        "header_offset": 7088626,
        "char_count": 6,
        "byte_length": 12,
        "control_gap_length": 2,
        "text": "しまいました",
        "translation": "됐어요"
      },
      {
        "offset": 7088744,
        "header_offset": 7088740,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 98,
        "text": "錬金術師って、",
        "translation": "연금술사는、"
      },
      {
        "offset": 7088764,
        "header_offset": 7088760,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "何をするお仕事なの？",
        "translation": "뭘　하는　직업이야？"
      },
      {
        "offset": 7088790,
        "header_offset": 7088786,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "警備員みたいなもの？",
        "translation": "경비원　같은　거야？"
      },
      {
        "offset": 7088852,
        "header_offset": 7088848,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 38,
        "text": "その歳で、錬金術師なの？",
        "translation": "그　나이에　연금술사야？"
      },
      {
        "offset": 7088882,
        "header_offset": 7088878,
        "char_count": 6,
        "byte_length": 12,
        "control_gap_length": 2,
        "text": "すっごいわね",
        "translation": "굉장하네"
      },
      {
        "offset": 7088936,
        "header_offset": 7088932,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 38,
        "text": "一度怖い思いをすると",
        "translation": "한번무서운일을겪으면"
      },
      {
        "offset": 7088962,
        "header_offset": 7088958,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "用心深くなるものよ。",
        "translation": "조심하게　돼。"
