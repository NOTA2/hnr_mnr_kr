      7414798,
      7414828,
      7414850
    ],
    "source_text": "キメラなんかにここを\n通させはしませんよ\nここの上官って\n変わってる人が多いんだ\nここの上官って仕事ができる\n人たちばかりなんです\nここの復旧作業で\n忙しい、忙しい\nキメラ事件が解決したのは\nいいけど、\n後始末が大変なんだよな\nひとつ事件が解決すると、\nまた次だからな。\nたまらんよ",
    "translation_text": "키메라 따위에게 여기를\n지나가게 하진 않겠습니다\n여기 상관들은\n별난 사람이 많아\n여기 상관들은 일 잘하는\n사람들뿐입니다\n여기 복구 작업 때문에\n바빠, 바빠\n키메라 사건이 해결된 건\n좋지만,\n뒤처리가 큰일이야\n사건 하나가 해결되면\n또 다음이니까.\n못 살겠다니까",
    "records": [
      {
        "offset": 7414304,
        "header_offset": 7414300,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "キメラなんかにここを",
        "translation": "키메라 따위에게 여기를"
      },
      {
        "offset": 7414330,
        "header_offset": 7414326,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 2,
        "text": "通させはしませんよ",
        "translation": "지나가게 하진 않겠습니다"
      },
      {
        "offset": 7414480,
        "header_offset": 7414476,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 128,
        "text": "ここの上官って",
        "translation": "여기 상관들은"
      },
      {
        "offset": 7414500,
        "header_offset": 7414496,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 2,
        "text": "変わってる人が多いんだ",
        "translation": "별난 사람이 많아"
      },
      {
        "offset": 7414552,
        "header_offset": 7414548,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 26,
        "text": "ここの上官って仕事ができる",
        "translation": "여기 상관들은 일 잘하는"
      },
      {
        "offset": 7414584,
        "header_offset": 7414580,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "人たちばかりなんです",
        "translation": "사람들뿐입니다"
      },
      {
        "offset": 7414634,
        "header_offset": 7414630,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 26,
        "text": "ここの復旧作業で",
        "translation": "여기 복구 작업 때문에"
      },
      {
        "offset": 7414656,
        "header_offset": 7414652,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 2,
        "text": "忙しい、忙しい",
        "translation": "바빠, 바빠"
      },
      {
        "offset": 7414700,
        "header_offset": 7414696,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 26,
        "text": "キメラ事件が解決したのは",
        "translation": "키메라 사건이 해결된 건"
      },
      {
        "offset": 7414730,
        "header_offset": 7414726,
        "char_count": 5,
        "byte_length": 10,
        "control_gap_length": 2,
        "text": "いいけど、",
        "translation": "좋지만,"
      },
      {
        "offset": 7414746,
        "header_offset": 7414742,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 2,
        "text": "後始末が大変なんだよな",
        "translation": "뒤처리가 큰일이야"
      },
      {
        "offset": 7414798,
        "header_offset": 7414794,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 26,
        "text": "ひとつ事件が解決すると、",
        "translation": "사건 하나가 해결되면"
      },
      {
        "offset": 7414828,
        "header_offset": 7414824,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 2,
        "text": "また次だからな。",
        "translation": "또 다음이니까."
      },
      {
        "offset": 7414850,
        "header_offset": 7414846,
        "char_count": 5,
        "byte_length": 10,
        "control_gap_length": 2,
        "text": "たまらんよ",
        "translation": "못 살겠다니까"
      }
    ],
    "notes": ""
  },
