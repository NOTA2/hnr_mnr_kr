    "source_text": "ああ、また悪さをしに",
    "translation_text": "아아, 또 못된 짓을 하러",
    "records": [
      {
        "offset": 7120542,
        "header_offset": 7120538,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 1902,
        "text": "ああ、また悪さをしに",
        "translation": "아아, 또 못된 짓을 하러"
      }
    ],
    "notes": ""
  },
  {
    "run_id": "entry8_cluster_08_run_0001",
    "cluster_index": 8,
    "run_index": 1,
    "dialogue_state_token": null,
    "record_count": 8,
