    "record_count": 4,
    "offsets": [
      7121438,
      7121472,
      7121526,
      7121550
    ],
    "source_text": "私たちは、この村で起きている\n事件を解決しに来たんです\nわかりましたじゃ。\n信用しますじゃ",
    "translation_text": "저희는 이 마을에서 일어나는\n사건을 해결하러 왔습니다\n알겠네.\n믿겠네",
    "records": [
      {
        "offset": 7121438,
        "header_offset": 7121434,
        "char_count": 14,
        "byte_length": 28,
        "control_gap_length": 2,
        "text": "私たちは、この村で起きている",
        "translation": "저희는 이 마을에서 일어나는"
      },
      {
        "offset": 7121472,
        "header_offset": 7121468,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "事件を解決しに来たんです",
        "translation": "사건을 해결하러 왔습니다"
      },
      {
        "offset": 7121526,
        "header_offset": 7121522,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 26,
        "text": "わかりましたじゃ。",
        "translation": "알겠네."
      },
      {
        "offset": 7121550,
        "header_offset": 7121546,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 2,
        "text": "信用しますじゃ",
        "translation": "믿겠네"
      }
    ],
    "notes": ""
  },
  {
    "run_id": "entry8_cluster_08_run_0014",
