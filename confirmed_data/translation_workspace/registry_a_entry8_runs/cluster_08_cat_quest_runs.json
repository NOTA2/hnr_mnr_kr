    "record_count": 3,
    "offsets": [
      7121264,
      7121290,
      7121356
    ],
    "source_text": "エルリック兄弟です。\n偽モノを退治しに来ました\n本当に奴らとは違うんじゃな？",
    "translation_text": "엘릭 형제입니다.\n가짜를 물리치러 왔습니다\n정말 그놈들과 다른 게냐?",
    "records": [
      {
        "offset": 7121264,
        "header_offset": 7121260,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "エルリック兄弟です。",
        "translation": "엘릭 형제입니다."
      },
      {
        "offset": 7121290,
        "header_offset": 7121286,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "偽モノを退治しに来ました",
        "translation": "가짜를 물리치러 왔습니다"
      },
      {
        "offset": 7121356,
        "header_offset": 7121352,
        "char_count": 14,
        "byte_length": 28,
        "control_gap_length": 38,
        "text": "本当に奴らとは違うんじゃな？",
        "translation": "정말 그놈들과 다른 게냐?"
      }
    ],
    "notes": ""
  },
