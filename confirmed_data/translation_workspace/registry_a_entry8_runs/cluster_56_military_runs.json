      {
        "offset": 7667422,
        "header_offset": 7667418,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 12,
        "text": "だが、仮にも国家の所有物に",
        "translation": "하지만 아무리 그래도 국가 소유물에"
      },
      {
        "offset": 7667454,
        "header_offset": 7667450,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 2,
        "text": "勝手に住み着くのは",
