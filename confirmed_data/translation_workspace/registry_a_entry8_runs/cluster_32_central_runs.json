      {
        "offset": 7378896,
        "header_offset": 7378892,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "開催されてるらしいな",
        "translation": "열리고 있다더군"
      },
      {
        "offset": 7378946,
        "header_offset": 7378942,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 26,
        "text": "タバコをくわえた軍人かい？",
