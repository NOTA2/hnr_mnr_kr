        "offset": 7384962,
        "header_offset": 7384958,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 2,
        "text": "入れておいたからな",
        "translation": "넣어 뒀으니까"
      },
      {
        "offset": 7384988,
        "header_offset": 7384984,
        "char_count": 13,
        "byte_length": 26,
