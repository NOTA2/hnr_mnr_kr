        "offset": 7381684,
        "header_offset": 7381680,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 2,
        "text": "お金持ちになれる？",
        "translation": "부자가 될 수 있어?"
      }
    ],
    "notes": ""
