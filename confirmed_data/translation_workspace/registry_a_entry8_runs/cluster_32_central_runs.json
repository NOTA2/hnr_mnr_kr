        "offset": 7382914,
        "header_offset": 7382910,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 2,
        "text": "宿屋で休もうか",
        "translation": "여관에서 쉬자"
      },
      {
        "offset": 7382950,
        "header_offset": 7382946,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 18,
        "text": "情報が入るまで",
        "translation": "정보가 들어올 때까지"
      },
      {
        "offset": 7382970,
        "header_offset": 7382966,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "することもないだろうし、",
        "translation": "할 일도 없을 테니,"
      },
      {
        "offset": 7383000,
        "header_offset": 7382996,
        "char_count": 5,
        "byte_length": 10,
        "control_gap_length": 2,
        "text": "そうするか",
        "translation": "그러자"
