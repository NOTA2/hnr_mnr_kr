        "offset": 7382782,
        "header_offset": 7382778,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "兄さん疲れたんじゃない？",
        "translation": "형도 지쳤지?"
      },
      {
        "offset": 7382824,
        "header_offset": 7382820,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 14,
        "text": "うーん、まあな。",
        "translation": "음, 뭐 그렇지."
      },
