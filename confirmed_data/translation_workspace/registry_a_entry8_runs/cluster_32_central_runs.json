        "offset": 7381590,
        "header_offset": 7381586,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "イースト西側に行ってみよう",
        "translation": "이스트 서쪽으로 가 보자"
