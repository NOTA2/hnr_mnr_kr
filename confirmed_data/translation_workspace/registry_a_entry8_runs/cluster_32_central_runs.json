        "header_offset": 7379498,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 26,
        "text": "キメラ事件の真相知ってる？",
        "translation": "키메라 사건의 진상 알아?"
      },
      {
        "offset": 7379534,
        "header_offset": 7379530,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "一部の錬金術師が、国家に",
        "translation": "일부 연금술사들이 국가에"
      },
      {
        "offset": 7379564,
        "header_offset": 7379560,
        "char_count": 14,
        "byte_length": 28,
        "control_gap_length": 2,
        "text": "反旗をひるがえしたんだそうよ",
        "translation": "반기를 들었다고 하더라"
      },
      {
        "offset": 7379622,
        "header_offset": 7379618,
        "char_count": 6,
        "byte_length": 12,
        "control_gap_length": 26,
        "text": "軍司令部まで",
        "translation": "군 사령부까지"
      },
      {
        "offset": 7379640,
        "header_offset": 7379636,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 2,
        "text": "襲われるなんて",
        "translation": "습격당하다니"
      },
      {
        "offset": 7379660,
        "header_offset": 7379656,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "ますます物騒になっていくわ",
        "translation": "점점 더 흉흉해지네"
      },
      {
        "offset": 7379716,
        "header_offset": 7379712,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 26,
        "text": "ウチの人ってば、",
        "translation": "우리 남편은 말이야,"
      },
      {
        "offset": 7379738,
        "header_offset": 7379734,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "自分も大会に出るって",
        "translation": "자기도 대회에 나가겠다고"
      },
      {
        "offset": 7379764,
        "header_offset": 7379760,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "きかないのよ…ムチャよね",
        "translation": "고집을 부려… 무모하지"
      },
      {
        "offset": 7379818,
        "header_offset": 7379814,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 26,
        "text": "イーストの西側で",
        "translation": "이스트 서쪽에서"
      },
      {
        "offset": 7379840,
        "header_offset": 7379836,
        "char_count": 4,
        "byte_length": 8,
        "control_gap_length": 2,
        "text": "変な人が",
        "translation": "이상한 사람이"
      },
      {
        "offset": 7379854,
        "header_offset": 7379850,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 2,
        "text": "うろついてるらしいのよ",
        "translation": "돌아다닌다더라"
      },
      {
        "offset": 7379884,
        "header_offset": 7379880,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 4,
        "text": "そういう話を聞くと、",
        "translation": "그런 이야기를 들으면,"
      },
      {
        "offset": 7379910,
        "header_offset": 7379906,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 2,
        "text": "女ひとりじゃ、",
        "translation": "여자 혼자서는"
      },
      {
        "offset": 7379930,
        "header_offset": 7379926,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 2,
        "text": "出歩くのも怖いわ",
        "translation": "돌아다니기도 무서워"
      },
      {
        "offset": 7379976,
        "header_offset": 7379972,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 26,
        "text": "武道大会は結局、",
        "translation": "무도대회는 결국"
      },
      {
        "offset": 7379998,
        "header_offset": 7379994,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "誰が優勝したのかしら",
        "translation": "누가 우승했을까"
      },
      {
        "offset": 7380236,
        "header_offset": 7380232,
        "char_count": 14,
        "byte_length": 28,
        "control_gap_length": 214,
        "text": "最近、街の外にキメラとかいう",
        "translation": "요즘 도시 밖에 키메라라는"
      },
      {
        "offset": 7380270,
        "header_offset": 7380266,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "化け物がでるってウワサだよ",
        "translation": "괴물이 나온다는 소문이야"
      },
      {
        "offset": 7380326,
        "header_offset": 7380322,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 26,
        "text": "キメラっていう化け物を",
        "translation": "키메라라는 괴물을"
      },
      {
        "offset": 7380354,
        "header_offset": 7380350,
        "char_count": 4,
        "byte_length": 8,
        "control_gap_length": 2,
        "text": "見たよ。",
        "translation": "봤어."
      },
      {
        "offset": 7380368,
        "header_offset": 7380364,
        "char_count": 14,
        "byte_length": 28,
        "control_gap_length": 2,
        "text": "なんだか、動物みたいだったよ",
        "translation": "왠지 동물 같았어"
      },
      {
        "offset": 7380426,
        "header_offset": 7380422,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 26,
        "text": "ここだけの話だけどね、",
        "translation": "여기서만 하는 얘긴데,"
      },
      {
        "offset": 7380454,
        "header_offset": 7380450,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "あのキメラは軍の実験失敗で",
        "translation": "그 키메라는 군의 실험 실패로"
      },
      {
        "offset": 7380486,
        "header_offset": 7380482,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "産まれたんだそうだよ",
        "translation": "태어난 거라더라"
      },
      {
        "offset": 7380536,
        "header_offset": 7380532,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 26,
        "text": "まったく、軍も早いところ",
        "translation": "정말이지, 군도 빨리"
      },
      {
        "offset": 7380566,
        "header_offset": 7380562,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "事件を解決してくれないと、",
        "translation": "사건을 해결해 주지 않으면,"
      },
      {
        "offset": 7380598,
        "header_offset": 7380594,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 2,
        "text": "安心して暮らせないわよ",
        "translation": "안심하고 살 수가 없어"
      },
      {
        "offset": 7380650,
        "header_offset": 7380646,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 26,
        "text": "主婦は毎日忙しいのよ。",
        "translation": "주부는 매일 바빠."
      },
      {
        "offset": 7380678,
        "header_offset": 7380674,
        "char_count": 6,
        "byte_length": 12,
        "control_gap_length": 2,
        "text": "今晩の夕飯、",
        "translation": "오늘 저녁은"
      },
      {
        "offset": 7380696,
        "header_offset": 7380692,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 2,
        "text": "なんにしようかしら",
        "translation": "뭘로 할까"
      },
      {
        "offset": 7380744,
        "header_offset": 7380740,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 26,
        "text": "最近物価があがっちゃって",
        "translation": "요즘 물가가 올라서"
      },
      {
        "offset": 7380774,
        "header_offset": 7380770,
        "char_count": 7,
        "byte_length": 14,
        "control_gap_length": 2,
        "text": "たまらないわね",
        "translation": "못 견디겠네"
      },
      {
        "offset": 7381034,
        "header_offset": 7381030,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 242,
        "text": "セントラルシティに",
        "translation": "센트럴 시티에"
      },
      {
        "offset": 7381058,
        "header_offset": 7381054,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 2,
        "text": "行ってみたいなぁ",
        "translation": "가 보고 싶다"
      },
      {
        "offset": 7381104,
        "header_offset": 7381100,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 26,
        "text": "今日は広場に行こうかな",
        "translation": "오늘은 광장에 가 볼까"
      },
      {
        "offset": 7381156,
        "header_offset": 7381152,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 26,
        "text": "ママが言ってたよ。",
        "translation": "엄마가 말했어."
      },
      {
        "offset": 7381180,
        "header_offset": 7381176,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "キメラがいっぱい生まれて、",
        "translation": "키메라가 잔뜩 태어나서,"
      },
      {
        "offset": 7381212,
        "header_offset": 7381208,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "世界は滅んじゃうんだって",
        "translation": "세상이 멸망한대"
      },
      {
        "offset": 7381266,
        "header_offset": 7381262,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 26,
        "text": "ママがね、危ないから",
        "translation": "엄마가 위험하니까"
      },
      {
        "offset": 7381292,
        "header_offset": 7381288,
        "char_count": 9,
        "byte_length": 18,
        "control_gap_length": 2,
        "text": "日が暮れないうちに",
        "translation": "해가 지기 전에"
      },
      {
        "offset": 7381316,
        "header_offset": 7381312,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "帰ってきなさいって言うんだ",
        "translation": "돌아오라고 했어"
      },
      {
        "offset": 7381372,
        "header_offset": 7381368,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 26,
        "text": "ボク、おっきくなったら",
        "translation": "나, 크면"
      },
      {
        "offset": 7381400,
        "header_offset": 7381396,
        "char_count": 12,
        "byte_length": 24,
        "control_gap_length": 2,
        "text": "国家錬金術師になるんだ！",
        "translation": "국가 연금술사가 될 거야!"
      }
    ],
    "notes": ""
  },
