        "offset": 7382846,
        "header_offset": 7382842,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 2,
        "text": "しばらく英気を養うか",
        "translation": "잠시 기운을 비축할까"
      },
      {
        "offset": 7382888,
        "header_offset": 7382884,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 18,
        "text": "じゃ、南側区画にある",
        "translation": "그럼 남쪽 구역에 있는"
