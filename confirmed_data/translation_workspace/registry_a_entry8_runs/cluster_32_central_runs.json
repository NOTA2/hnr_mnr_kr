        "offset": 7384896,
        "header_offset": 7384892,
        "char_count": 11,
        "byte_length": 22,
        "control_gap_length": 88,
        "text": "なんだ、いらねーのか？",
        "translation": "뭐야, 안 사는 거냐?"
      },
