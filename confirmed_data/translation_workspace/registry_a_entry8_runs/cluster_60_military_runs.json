      },
      {
        "offset": 7705682,
        "header_offset": 7705678,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 2,
        "text": "どっちが子供だよ",
        "translation": "누가 애라는 거야."
      },
      {
        "offset": 7705714,
        "header_offset": 7705710,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 12,
        "text": "どう転んだって、",
        "translation": "어떻게 봐도"
      },
      {
        "offset": 7705736,
        "header_offset": 7705732,
        "char_count": 14,
        "byte_length": 28,
        "control_gap_length": 2,
        "text": "リンカーを一人で倒せるなんて",
        "translation": "링커를 혼자 쓰러뜨릴 수 있다고"
      },
      {
        "offset": 7705770,
        "header_offset": 7705766,
        "char_count": 13,
