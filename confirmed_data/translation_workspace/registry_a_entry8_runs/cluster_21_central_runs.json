        "offset": 7287642,
        "header_offset": 7287638,
        "char_count": 8,
        "byte_length": 16,
        "control_gap_length": 2,
        "text": "入れておいたぜ！",
        "translation": "넣어　뒀어！"
      },
      {
        "offset": 7287666,
        "header_offset": 7287662,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 4,
        "text": "まちがって捨てちまうなよ！",
        "translation": "실수로　버리지　말라고！"
      },
      {
        "offset": 7287698,
        "header_offset": 7287694,
        "char_count": 13,
        "byte_length": 26,
        "control_gap_length": 2,
        "text": "じゃ、また買ってくれよな！",
        "translation": "그럼　또　사　줘！"
      },
      {
        "offset": 7287774,
        "header_offset": 7287770,
        "char_count": 10,
        "byte_length": 20,
        "control_gap_length": 46,
        "text": "おいおい、兄ちゃん！",
